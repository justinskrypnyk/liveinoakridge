# PropTx Amplify Syndication (AMPRE) credentials — copy to .env and fill in your values.
# OData/RESO Web API with Bearer token auth. Portal: PropTx Data Agreements & Syndication > Web API.
DDF_ACCESS_TOKEN=your_ampre_access_token
DDF_API_BASE_URL=https://query.ampre.ca/odata/

# CREA National Pool DDF credentials — "National Shared Pool" destination
# (ddf.realtor.ca > Distribution > Destinations). OAuth client_credentials
# flow against identity.crea.ca. Used only as a free source of real
# Latitude/Longitude (AMPRE never populates these); its listing coverage is
# far smaller than AMPRE's so it isn't used as a listing source.
DDF_NATIONAL_USERNAME=your_national_pool_destination_username
DDF_NATIONAL_PASSWORD=your_national_pool_destination_password
