---
import '../styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SEO from '@/components/SEO.astro';
import AskWidget from '@/components/AskWidget.astro';
import StickyMobileCTA from '@/components/StickyMobileCTA.astro';
import { SITE } from '@/data/site';
import { inferChatContext, type ChatIntent, type ChatPersona } from '@/lib/chat-context';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  canonical?: string;
  noindex?: boolean;
  heroOverlap?: boolean;
  // Override AskWidget's page-inferred buyer/seller intent + neighbourhood
  // (see src/lib/chat-context.ts) when a page already knows better than a
  // URL guess can — e.g. a listing page passes the neighbourhood it
  // resolved server-side from the listing's real lat/lng.
  chatIntent?: ChatIntent;
  chatNeighbourhood?: string;
  chatPersona?: ChatPersona;
}

const {
  title,
  description,
  image,
  type,
  canonical,
  noindex,
  heroOverlap = false,
  chatIntent,
  chatNeighbourhood,
  chatPersona,
} = Astro.props;

const hideStickyCTA = Astro.url.pathname.startsWith('/contact');
const inferredChat = inferChatContext(Astro.url.pathname);
const chatContext = {
  intent: chatIntent ?? inferredChat.intent,
  neighbourhood: chatNeighbourhood ?? inferredChat.neighbourhood,
  persona: chatPersona ?? inferredChat.persona,
};

// Keep local/dev builds from sending real events into the live GA4 property
// and Meta Pixel -- import.meta.env.PROD is false for `astro dev` and true
// for the actual Netlify production build.
const isProd = import.meta.env.PROD;
---

<!doctype html>
<html lang="en-CA" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0d1b2a" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Leaflet (unpkg.com) — used by /search/, /properties/, and area/price map
         pages; a cheap hint everywhere else, saves a cold DNS+TLS handshake
         once the map script actually loads on pages that need it. -->
    <link rel="preconnect" href="https://unpkg.com" crossorigin />
    <!-- Loaded non-blocking (preload -> swap to stylesheet on load) rather
         than a plain <link rel="stylesheet">, which PageSpeed flagged as a
         render-blocking request (~1s of the mobile score). noscript fallback
         covers the no-JS case.

         display=optional, not swap: swap re-flowed the page once the custom
         font arrived (Playfair/Inter have different metrics than the
         fallback), and that swap-triggered reflow is real CLS -- confirmed
         by re-testing after this file's render-blocking fix shipped: CLS
         went from 0 back up to 0.104, the exact value from before ANY of
         this round of fixes, once the font started arriving fast enough to
         swap inside Lighthouse's CLS measurement window. `optional` tells
         the browser to either use the custom font if it's already available
         almost immediately, or stick with the fallback for that pageview and
         never swap later -- trades "custom font on a slow first visit" for
         "never causes layout shift," which is the right side of that trade
         for a real estate site where a stable layout matters more than
         perfect typography on one slow load. -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@400;600;700&display=optional"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@400;600;700&display=optional"
      />
    </noscript>

    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      canonical={canonical}
      noindex={noindex}
    />

    <slot name="head" />

    {isProd && (
      <>
        <!-- Google Analytics (GA4) — reverted OFF Partytown 2026-08-30. It was
             moved to type="text/partytown" on 2026-08-16 (d72c4e9) to shave
             ~238ms of Total Blocking Time, the same day production GA4
             sessions dropped to near-zero while Search Console kept logging
             normal impressions/clicks for two straight weeks. Live check
             confirmed window.gtag existed but no /g/collect beacon ever left
             the browser — the hit dies inside Partytown's worker sandbox
             silently (no console error, no failed request). Same class of
             bug as the Meta Pixel CORS failure below, just quieter.

             PageSpeed (2026-09-17) flagged the gtag/js file itself as a
             570ms render-blocking request (188 KiB) plus 76 KiB of unused
             JS -- fixed here WITHOUT touching Partytown again: the tiny
             queueing stub (dataLayer + gtag()) stays synchronous exactly as
             before, completely main-thread, zero sandbox involved -- so
             anything that calls gtag() early (the phone-click handler
             below, any inline event) still queues correctly. Only the
             actual network fetch of the 188 KiB gtag/js file is delayed
             until first user interaction or a 3s fallback timeout,
             whichever comes first -- the fallback guarantees the pageview
             still fires (queued instantly via gtag('config', ...) below,
             flushed the moment the real script arrives) even for a session
             that closes the tab without ever scrolling/clicking. This is a
             fundamentally different mechanism than Partytown (no worker,
             no sandboxed fetch/XHR proxy) -- same main-thread execution
             GA4 already had, just started a few seconds later. STILL:
             verify a real /g/collect beacon fires after deploying, same
             check that caught the Partytown regression. -->
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-Z2M94KRVTT');
        </script>

        <!-- Meta Pixel — deliberately NOT type="text/partytown" like GA4 above.
             Its tracking beacon is normally a plain image-style request, which
             browsers exempt from CORS; Partytown's worker sandbox turns that
             into a real network request that DOES get CORS-checked, and
             Meta's endpoint doesn't return the headers that requires. Verified
             2026-08-16: running this through Partytown produced a CORS error
             on the actual tracking beacon in production, so it stays on the
             main thread.

             Same deferred-fetch treatment as GA4 above, same reasoning:
             fbevents.js was flagged at 107.7 KiB unused JS + a 20-minute
             cache TTL Meta controls, not us. The fbq() queueing stub
             (identical to Meta's own official snippet) stays synchronous;
             only the createElement/insertBefore that actually requests
             fbevents.js is deferred to interaction-or-3s-timeout. init/
             track('PageView') still fire synchronously into the queue
             immediately, so PageView tracking timing is unchanged from
             today -- still a plain main-thread <script src>, never a
             worker, so none of the CORS failure mode above applies. -->
        <script is:inline>
          !function(f){if(f.fbq)return;var n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
          n.push=n;n.loaded=!0;n.version='2.0';n.queue=[]}(window);
          fbq('init','3837845766512267');
          fbq('track','PageView');
        </script>
        <noscript>
          <img height="1" width="1" style="display:none"
            src="https://www.facebook.com/tr?id=3837845766512267&ev=PageView&noscript=1" alt="" />
        </noscript>

        <!-- Deferred fetch for both tags' real script files -- see the two
             comments above for the full reasoning. Fires on first genuine
             interaction (scroll/pointer/touch/key) or after 3s, whichever
             is first; `once: true` + the loaded-guard mean this only ever
             runs once regardless of how many listeners fire. -->
        <script is:inline>
          (function () {
            var loaded = false;
            function loadDeferredTags() {
              if (loaded) return;
              loaded = true;
              var gtagScript = document.createElement('script');
              gtagScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-Z2M94KRVTT';
              document.head.appendChild(gtagScript);

              var fbScript = document.createElement('script');
              fbScript.async = true;
              fbScript.src = 'https://connect.facebook.net/en_US/fbevents.js';
              document.head.appendChild(fbScript);

              events.forEach(function (evt) {
                window.removeEventListener(evt, loadDeferredTags);
              });
            }
            var events = ['scroll', 'pointerdown', 'touchstart', 'keydown'];
            events.forEach(function (evt) {
              window.addEventListener(evt, loadDeferredTags, { passive: true, once: true });
            });
            setTimeout(loadDeferredTags, 3000);
          })();
        </script>

        <!-- Core Web Vitals (LCP/CLS/INP/FCP/TTFB) as real-user data, sent to
             GA4 -- added 2026-09-17 because PageSpeed's own "Discover what
             your real users are experiencing" panel reads "No Data" for this
             site: not enough real-Chrome-visitor volume yet for Google's own
             CrUX dataset (what Search Console's Core Web Vitals report and
             the public CrUX API/dashboard both read from) to report
             anything. This sidesteps that entirely -- Google's own
             `web-vitals` library measures the same 5 metrics directly in
             each visitor's real browser and reports them into GA4 the
             moment they're measured, no minimum-traffic threshold to clear.
             Bundled as an npm dependency (not a CDN script) so Vite ships an
             exact pinned version with the rest of the page's JS.

             gtag() is safe to call here even though the real gtag/js fetch
             above is deferred -- the dataLayer/gtag() stub defined earlier
             in this same block is already synchronous, so every call below
             just queues into dataLayer and flushes once the deferred script
             arrives (same mechanism the phone-click handler already relies
             on), including for a visitor who closes the tab before the 3s
             fallback ever fires -- LCP/FCP/TTFB typically report within a
             second or two of page load, so most sessions get their events
             queued well before that.

             CLS's delta is multiplied by 1000 before sending, matching
             web-vitals' own documented GA4 recipe -- CLS is a small unitless
             score (e.g. 0.05), and GA4's "value" param reads far more
             usefully as a whole number than a fraction with 3+ decimal
             places. The other four metrics are already real millisecond
             values, so they're sent as-is (just rounded).

             `metric_rating` (good / needs-improvement / poor, using
             Google's own published thresholds) is included specifically so
             this can be filtered/segmented in GA4 without needing to
             remember or hardcode those thresholds a second time. Note:
             these show up as raw GA4 events immediately, but `metric_id`/
             `metric_value`/`metric_delta`/`metric_rating` only become
             usable as report dimensions once registered as GA4 custom
             definitions (Admin -> Custom definitions) -- a manual step in
             the GA4 UI, not something reachable from this codebase. -->
        <script>
          import { onCLS, onFCP, onINP, onLCP, onTTFB } from 'web-vitals';

          function sendToGA4({ name, delta, value, id, rating }) {
            gtag('event', name, {
              value: Math.round(name === 'CLS' ? delta * 1000 : delta),
              metric_id: id,
              metric_value: value,
              metric_delta: delta,
              metric_rating: rating,
            });
          }

          onCLS(sendToGA4);
          onFCP(sendToGA4);
          onINP(sendToGA4);
          onLCP(sendToGA4);
          onTTFB(sendToGA4);
        </script>
      </>
    )}
  </head>
  <body class:list={['bg-white text-navy', !hideStickyCTA && 'pb-[calc(4.5rem+env(safe-area-inset-bottom))] sm:pb-0']}>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-gold text-navy px-4 py-2 rounded-md font-semibold z-[100]">
      Skip to main content
    </a>

    <Header />

    <main id="main-content" class={heroOverlap ? '' : 'pt-20'}>
      <slot />
    </main>

    <Footer />
    <AskWidget
      bottomOffsetClass={hideStickyCTA ? '' : 'bottom-20 sm:bottom-5'}
      intent={chatContext.intent}
      neighbourhood={chatContext.neighbourhood}
      persona={chatContext.persona}
    />
    {!hideStickyCTA && <StickyMobileCTA />}

    <!-- Netlify's build-time bot only detects forms present in statically
         generated HTML. The real "save listing" form (SaveListingModal.astro)
         only ever renders on /search/ and /properties/, both `prerender =
         false`, so it's invisible to that bot. This static, hidden twin
         exists purely so Netlify registers the "save-listing" form name —
         most pages using this layout ARE static, so it ships in their build
         output. Netlify matches real submissions by the `form-name` field in
         the POST body, not by which page sent it, so the AJAX submit from
         the dynamic pages still works once this name is registered. -->
    <form name="save-listing" data-netlify="true" netlify-honeypot="bot-field" hidden>
      <input type="hidden" name="form-name" value="save-listing" />
      <input name="bot-field" />
      <input name="first-name" />
      <input name="last-name" />
      <input name="email" />
      <input name="phone" />
      <input name="message" />
      <input name="property-address" />
      <input name="mls-number" />
      <input name="utm_source" />
      <input name="utm_medium" />
      <input name="utm_campaign" />
      <input name="utm_term" />
      <input name="utm_content" />
      <input name="gclid" />
    </form>

    <!-- Same static-twin trick as save-listing above -- /market-map/ is also
         `prerender = false` (needs a server-side Supabase read), so its real
         form is invisible to Netlify's build-time form bot without this. -->
    <form name="market-map-notify" data-netlify="true" netlify-honeypot="bot-field" hidden>
      <input type="hidden" name="form-name" value="market-map-notify" />
      <input name="bot-field" />
      <input name="email" />
      <input name="utm_source" />
      <input name="utm_medium" />
      <input name="utm_campaign" />
      <input name="utm_term" />
      <input name="utm_content" />
      <input name="gclid" />
    </form>

    <!-- "home-value-lead" IS rendered statically (home-value-estimate.astro
         defaults to prerender=true), so Netlify's bot does see it directly
         and doesn't need a twin to be *found* at all -- but it only
         registers the exact field names present in that static markup, and
         that template never declares attribution-client.ts's utm_*/gclid
         fields (only added at runtime via a separate body.append() call in
         its submit script). This twin exists purely to teach Netlify those
         6 extra field names; it's hidden and never submitted, matching the
         save-listing/market-map-notify trick above. Confirmed working via a
         live post-deploy check (netlify api listSiteForms) 2026-09-09.

         NOTE: the equivalent trick did NOT work for "contact" -- it's reused
         on 15+ static pages, and a same-named twin here never got its extra
         fields merged into Netlify's registered schema for that form name
         (confirmed live, same date: chat-intent/chat-neighbourhood/etc.
         stayed absent from the stored submission even with this twin live).
         chat-*/utm_*/gclid registration for "contact" is instead handled by
         declaring those fields as real static hidden inputs directly inside
         ContactForm.astro's own template -- see that file. -->
    <form name="home-value-lead" data-netlify="true" netlify-honeypot="bot-field" hidden>
      <input type="hidden" name="form-name" value="home-value-lead" />
      <input name="bot-field" />
      <input name="name" />
      <input name="email" />
      <input name="phone" />
      <input name="address" />
      <input name="rough-estimate-range" />
      <input name="neighbourhood" />
      <input name="property-type" />
      <input name="sqft" />
      <input name="bedrooms" />
      <input name="finished-basement" />
      <input name="utm_source" />
      <input name="utm_medium" />
      <input name="utm_campaign" />
      <input name="utm_term" />
      <input name="utm_content" />
      <input name="gclid" />
    </form>

    <script>
      import { captureAttribution } from '@/lib/attribution-client';

      // Real estate ad clicks convert to phone calls at least as often as
      // form fills, but until now nothing tracked them -- every generate_lead
      // event so far only fired from form success handlers (see
      // ContactForm.astro etc.). One delegated listener here catches every
      // tel: link sitewide (15+ places) without editing each page. Reuses
      // the same generate_lead event name (not a separate one) so it's
      // covered automatically once Justin marks generate_lead as a GA4 Key
      // Event / imports it into Google Ads -- form_type distinguishes it
      // from form-based leads in reporting.
      declare global {
        interface Window { gtag?: (...args: unknown[]) => void; }
      }

      captureAttribution();

      document.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement).closest('a[href^="tel:"]');
        if (!link) return;
        window.gtag?.('event', 'generate_lead', { form_type: 'phone-click' });
      });
    </script>
  </body>
</html>
