---
import '../styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SEO from '@/components/SEO.astro';
import AskWidget from '@/components/AskWidget.astro';
import StickyMobileCTA from '@/components/StickyMobileCTA.astro';
import { SITE } from '@/data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  canonical?: string;
  noindex?: boolean;
  heroOverlap?: boolean;
}

const {
  title,
  description,
  image,
  type,
  canonical,
  noindex,
  heroOverlap = false,
} = Astro.props;

const hideStickyCTA = Astro.url.pathname.startsWith('/contact');

// Keep local/dev builds from sending real events into the live GA4 property
// and Meta Pixel -- import.meta.env.PROD is false for `astro dev` and true
// for the actual Netlify production build.
const isProd = import.meta.env.PROD;
---

<!doctype html>
<html lang="en-CA" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0d1b2a" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Leaflet (unpkg.com) — used by /search/, /properties/, and area/price map
         pages; a cheap hint everywhere else, saves a cold DNS+TLS handshake
         once the map script actually loads on pages that need it. -->
    <link rel="preconnect" href="https://unpkg.com" crossorigin />
    <!-- Loaded non-blocking (preload -> swap to stylesheet on load) rather
         than a plain <link rel="stylesheet">, which PageSpeed flagged as a
         render-blocking request (~1s of the mobile score). noscript fallback
         covers the no-JS case.

         display=optional, not swap: swap re-flowed the page once the custom
         font arrived (Playfair/Inter have different metrics than the
         fallback), and that swap-triggered reflow is real CLS -- confirmed
         by re-testing after this file's render-blocking fix shipped: CLS
         went from 0 back up to 0.104, the exact value from before ANY of
         this round of fixes, once the font started arriving fast enough to
         swap inside Lighthouse's CLS measurement window. `optional` tells
         the browser to either use the custom font if it's already available
         almost immediately, or stick with the fallback for that pageview and
         never swap later -- trades "custom font on a slow first visit" for
         "never causes layout shift," which is the right side of that trade
         for a real estate site where a stable layout matters more than
         perfect typography on one slow load. -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@400;600;700&display=optional"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@400;600;700&display=optional"
      />
    </noscript>

    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      canonical={canonical}
      noindex={noindex}
    />

    <slot name="head" />

    {isProd && (
      <>
        <!-- Google Analytics (GA4) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-Z2M94KRVTT"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-Z2M94KRVTT');
        </script>

        <!-- Meta Pixel -->
        <script is:inline>
          !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
          n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}
          (window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
          fbq('init','3837845766512267');
          fbq('track','PageView');
        </script>
        <noscript>
          <img height="1" width="1" style="display:none"
            src="https://www.facebook.com/tr?id=3837845766512267&ev=PageView&noscript=1" alt="" />
        </noscript>
      </>
    )}
  </head>
  <body class:list={['bg-white text-navy', !hideStickyCTA && 'pb-[calc(4.5rem+env(safe-area-inset-bottom))] sm:pb-0']}>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-gold text-navy px-4 py-2 rounded-md font-semibold z-[100]">
      Skip to main content
    </a>

    <Header />

    <main id="main-content" class={heroOverlap ? '' : 'pt-20'}>
      <slot />
    </main>

    <Footer />
    <AskWidget bottomOffsetClass={hideStickyCTA ? '' : 'bottom-20 sm:bottom-5'} />
    {!hideStickyCTA && <StickyMobileCTA />}

    <!-- Netlify's build-time bot only detects forms present in statically
         generated HTML. The real "save listing" form (SaveListingModal.astro)
         only ever renders on /search/ and /properties/, both `prerender =
         false`, so it's invisible to that bot. This static, hidden twin
         exists purely so Netlify registers the "save-listing" form name —
         most pages using this layout ARE static, so it ships in their build
         output. Netlify matches real submissions by the `form-name` field in
         the POST body, not by which page sent it, so the AJAX submit from
         the dynamic pages still works once this name is registered. -->
    <form name="save-listing" data-netlify="true" netlify-honeypot="bot-field" hidden>
      <input type="hidden" name="form-name" value="save-listing" />
      <input name="bot-field" />
      <input name="first-name" />
      <input name="last-name" />
      <input name="email" />
      <input name="phone" />
      <input name="message" />
      <input name="property-address" />
      <input name="mls-number" />
    </form>

    <!-- Same static-twin trick as save-listing above -- /market-map/ is also
         `prerender = false` (needs a server-side Supabase read), so its real
         form is invisible to Netlify's build-time form bot without this. -->
    <form name="market-map-notify" data-netlify="true" netlify-honeypot="bot-field" hidden>
      <input type="hidden" name="form-name" value="market-map-notify" />
      <input name="bot-field" />
      <input name="email" />
    </form>

    <script>
      import { captureAttribution } from '@/lib/attribution-client';

      // Real estate ad clicks convert to phone calls at least as often as
      // form fills, but until now nothing tracked them -- every generate_lead
      // event so far only fired from form success handlers (see
      // ContactForm.astro etc.). One delegated listener here catches every
      // tel: link sitewide (15+ places) without editing each page. Reuses
      // the same generate_lead event name (not a separate one) so it's
      // covered automatically once Justin marks generate_lead as a GA4 Key
      // Event / imports it into Google Ads -- form_type distinguishes it
      // from form-based leads in reporting.
      declare global {
        interface Window { gtag?: (...args: unknown[]) => void; }
      }

      captureAttribution();

      document.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement).closest('a[href^="tel:"]');
        if (!link) return;
        window.gtag?.('event', 'generate_lead', { form_type: 'phone-click' });
      });
    </script>
  </body>
</html>
