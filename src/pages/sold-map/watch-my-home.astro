---
// "Nosy Neighbour" style alert signup -- watch your own address and get
// emailed (via a GHL workflow) when something sells nearby. Gated behind
// the same VOW session as /sold-map/ itself, since the alert draws on real
// closed sale prices (vow_sold_listings) -- see api/vow/watch-address.json.ts
// for why this can't be a public email-only form like the other lead forms.
export const prerender = false;
import Base from '@/layouts/Base.astro';
import { getVowSession } from '@/lib/vow-session';

const session = getVowSession(Astro.cookies);
---

<Base
  title="Watch My Home | Live In Oakridge"
  description="Get notified when a home sells near your own address in London, Ontario."
>
  <section class="bg-navy py-20 text-white">
    <div class="container-site">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-white/40 mb-8">
        <a href="/" class="hover:text-gold transition-colors">Home</a>
        <span>/</span>
        <a href="/sold-map/" class="hover:text-gold transition-colors">Sold Map</a>
        <span>/</span>
        <span class="text-white/70">Watch My Home</span>
      </nav>
      <h1 class="font-serif text-5xl font-bold mb-4">Watch My Home</h1>
      <div class="gold-divider mb-6"></div>
      <p class="text-xl text-white/70 max-w-2xl">
        Tell us your address and we'll email you when a home sells nearby -- a simple way to keep an eye on what's happening to values on your own street.
      </p>
    </div>
  </section>

  <section class="py-20 bg-cream">
    <div class="container-site max-w-md">
      {!session ? (
        <div class="bg-white rounded-2xl shadow-card p-8 text-center">
          <p class="text-navy mb-5">Sign in first to set up an address watch -- this uses the same real sold-price data as the sold map, which requires being signed in.</p>
          <a href="/vow/login/" class="btn-primary inline-flex justify-center">Sign In</a>
        </div>
      ) : (
        <div class="bg-white rounded-2xl shadow-card p-8">
          <form id="watch-home-form" class="space-y-4">
            <div>
              <label for="address" class="block text-sm font-semibold text-navy mb-1.5">Home Address</label>
              <input
                type="text" id="address" name="address" required placeholder="123 Oak St, London, ON"
                class="w-full px-4 py-2.5 rounded-lg text-sm bg-cream border border-gray-200 text-navy placeholder-navy/40 focus:border-gold focus:outline-none transition-colors"
              />
            </div>
            <div>
              <label for="frequency" class="block text-sm font-semibold text-navy mb-1.5">How often?</label>
              <select
                id="frequency" name="frequency"
                class="w-full px-4 py-2.5 rounded-lg text-sm bg-cream border border-gray-200 text-navy focus:border-gold focus:outline-none transition-colors"
              >
                <option value="daily">As it happens (daily check)</option>
                <option value="weekly" selected>Weekly summary</option>
                <option value="monthly">Monthly summary</option>
              </select>
            </div>
            <p id="watch-home-error" class="hidden text-xs text-red-600"></p>
            <button type="submit" id="watch-home-submit" class="btn-primary w-full justify-center">Start Watching</button>
          </form>
          <div id="watch-home-success" class="hidden text-center py-6">
            <div class="text-4xl mb-3">🏡</div>
            <p class="font-serif text-lg text-navy font-bold mb-1">You're all set!</p>
            <p class="text-sm text-slate">We'll email you when something sells near that address.</p>
          </div>
        </div>
      )}
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('watch-home-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('watch-home-submit') as HTMLButtonElement | null;
  const errorEl = document.getElementById('watch-home-error');
  const successEl = document.getElementById('watch-home-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn) return;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Saving...';
    errorEl?.classList.add('hidden');

    try {
      const data = new FormData(form);
      const res = await fetch('/api/vow/watch-address.json', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ address: data.get('address'), frequency: data.get('frequency') }),
      });
      const json = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(json.error || `${res.status}`);

      form.classList.add('hidden');
      successEl?.classList.remove('hidden');
    } catch (err) {
      if (errorEl) {
        errorEl.textContent = err instanceof Error ? err.message : 'Something went wrong -- please try again.';
        errorEl.classList.remove('hidden');
      }
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Start Watching';
    }
  });
</script>
