---
import Base from '@/layouts/Base.astro';
---

<Base
  title="Page Not Found | Live In Oakridge"
  description="The page you're looking for doesn't exist. Return to the homepage or contact Justin Skrypnyk."
  noindex
>
  <section class="min-h-[70vh] bg-cream flex items-center justify-center">
    <div class="container-site text-center max-w-2xl py-20">
      <div class="font-serif text-8xl text-gold font-bold mb-6">404</div>
      <h1 class="font-serif text-4xl text-navy mb-4">Page Not Found</h1>
      <p class="text-slate text-lg mb-10">
        The page you're looking for has moved or doesn't exist. Let's get you back on track.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="btn-primary">Return Home</a>
        <a href="/contact/" class="btn-secondary">Contact Justin</a>
      </div>

      <div class="mt-12 grid grid-cols-2 md:grid-cols-3 gap-4 text-left">
        {[
          { label: 'Buy a Home', href: '/services/buying/' },
          { label: 'Sell Your Home', href: '/services/selling/' },
          { label: 'Complimentary Evaluation', href: '/services/home-evaluation/' },
          { label: 'Areas We Serve', href: '/areas/' },
          { label: 'Which Neighbourhood Fits You?', href: '/neighbourhood-quiz/' },
          { label: 'Explore the Territory Map', href: '/explore-map/' },
        ].map((item) => (
          <a href={item.href} class="bg-white border border-gray-100 hover:border-gold text-navy/80 hover:text-gold text-sm font-medium p-4 rounded-xl transition-all text-center">
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
