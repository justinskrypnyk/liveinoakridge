---
export const prerender = false; // live "Featured Listings" section — see src/lib/ddf.ts
import Base from '@/layouts/Base.astro';
import Schema from '@/components/Schema.astro';
import ContactForm from '@/components/ContactForm.astro';
import { SITE } from '@/data/site';
import { AREAS, getArea } from '@/data/areas';
import { TESTIMONIALS } from '@/data/testimonials';
import { getActiveListings } from '@/lib/ddf';
import { fmtPrice, field, buildAddress, listingSlug } from '@/lib/listings';

const oakridge = getArea('oakridge')!;
const rootsTimeline = [
  ...oakridge.historyData!.photos
    .map((p) => ({
      year: p.year,
      src: p.src,
      alt: p.alt,
      caption: p.caption,
    }))
    .sort((a, b) => parseInt(a.year.match(/\d{4}/)![0]) - parseInt(b.year.match(/\d{4}/)![0])),
  {
    year: '2026',
    src: '/images/oakridge-aerial-drone-2026-thumb.webp',
    alt: "Aerial drone view of Oakridge's mature tree canopy today, London Ontario",
    caption: "Today. The farmland is gone, the model homes have grown up — decades of maple and oak canopy now cover the streets Justin's family has called home since 1959.",
  },
];
import { SERVICES } from '@/data/services';
import { MARKET_SNAPSHOT } from '@/data/market-snapshot';
import { BLOG_POSTS } from '@/data/blog';

// Featured Listings — live from the DDF feed (every active Chapman listing),
// not a hand-maintained list, so a sold home can never linger on the
// homepage by mistake. Homepage shows a handful, each linking to its own
// /properties/[listingKey]/ page; "View All Listings" below sends people to
// /search/ instead, the Ontario-wide browse tool.
const liveListings = await getActiveListings();
const activeListings = liveListings.slice(0, 6).map((l) => {
  const L = l as Record<string, unknown>;
  return {
    address: buildAddress(L),
    city: field(L, 'City'),
    price: fmtPrice(L.ListPrice),
    beds: field(L, 'BedroomsTotal'),
    baths: field(L, 'BathroomsTotalInteger', 'BathroomsTotal'),
    photoUrl: (L._photoUrl as string | null) ?? null,
    url: `/properties/${listingSlug(L)}/`,
  };
});
const latestPosts = [...BLOG_POSTS]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 3);
---

<Base
  title="Oakridge Homes for Sale | London Ontario Realtor | Justin Skrypnyk"
  description="Justin Skrypnyk is a Real Estate Broker with Sutton Group Chapman Realty Inc., Brokerage, specializing in Oakridge, West London, and Whitehills. Buying, selling, and complimentary home evaluations. Call 519.639.5176."
  heroOverlap
>
  <Fragment slot="head">
    <Schema type="home" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Who is Justin Skrypnyk?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Justin Skrypnyk is a licensed Real Estate Broker with Sutton Group Chapman Realty Inc., Brokerage, specializing in Oakridge and West London Ontario. He helps buyers and sellers navigate the London Ontario real estate market with hyper-local expertise. Contact him at 519.639.5176 or visit liveinoakridge.ca.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the best neighbourhood to buy a home in West London Ontario?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The best neighbourhood depends on your budget and lifestyle. Oakridge and Byron are top choices for established family communities with strong schools. Hyde Park and Sunningdale offer newer construction. Westmount and Medway offer excellent value near Western University. Lambeth is ideal for those wanting a semi-rural feel with upscale homes. Justin Skrypnyk can help match you to the right neighbourhood based on your priorities.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the average home price in London Ontario in 2026?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The average home price in London Ontario is approximately $625,000–$660,000 as of mid-2026. West-end communities like Oakridge average $650K–$850K, Byron averages $700K–$950K, and more affordable options in West London and White Oaks range from $480K–$720K.',
          },
        },
        {
          '@type': 'Question',
          name: 'How do I get a home evaluation in London Ontario?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Justin Skrypnyk offers complimentary home evaluations for homeowners in London Ontario. He visits your home and provides a detailed, data-backed market value analysis at no cost and with no obligation. Call 519.639.5176 or book online at liveinoakridge.ca/services/home-evaluation/ to schedule yours.',
          },
        },
        {
          '@type': 'Question',
          name: 'What areas does Justin Skrypnyk serve?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Justin Skrypnyk specializes in Oakridge, West London, and Whitehills — and also serves Byron, Westmount and Riverbend. Based in Oakridge since 1959, his family\'s deep roots in the neighbourhood give him local knowledge no algorithm can match.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the difference between a real estate broker and an agent in Ontario?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'In Ontario, a Real Estate Broker holds an advanced licence that requires additional education, experience, and examinations beyond a salesperson (agent). Brokers can own or manage a brokerage. Justin Skrypnyk is a licensed Broker, meaning he has achieved the highest professional designation available to a real estate registrant in Ontario.',
          },
        },
      ],
    })} />
  </Fragment>

  <section class="relative min-h-screen flex items-center bg-navy overflow-hidden">
    <img
      src="/images/oakridge-aerial-drone-2026.webp"
      alt="Aerial drone view of Oakridge's mature tree canopy at golden hour, London Ontario"
      class="absolute inset-0 w-full h-full object-cover"
      width="2400"
      height="1350"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-navy-dark/85 via-navy-dark/40 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-navy-dark/50 via-transparent to-transparent"></div>

    <div class="relative container-site text-left text-white py-20 pt-32 md:py-32 md:pt-40">
      <div class="inline-flex items-center gap-2 bg-gold/20 text-gold text-sm font-medium px-4 py-2 rounded-full mb-8 border border-gold/30">
        <span class="w-2 h-2 bg-gold rounded-full animate-pulse"></span>
        Oakridge Roots Since 1959
      </div>
      <h1 class="font-serif text-5xl md:text-6xl lg:text-7xl font-bold mb-6 leading-tight">
        Oakridge Homes for Sale.<br />
        <span class="text-gold">London Ontario Realtor.</span>
      </h1>
      <p class="text-xl md:text-2xl text-white/80 mb-10 max-w-2xl leading-relaxed">
        Justin Skrypnyk has deep roots in Oakridge — his family has called this neighbourhood home since 1959. That kind of local knowledge changes everything when you are buying or selling here.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-start">
        <a href="/services/home-evaluation/" class="btn-primary text-lg py-4 px-8">
          Get a Complimentary Home Evaluation
        </a>
        <a href="/search/?area=oakridge" class="btn-white text-lg py-4 px-8">
          Browse Oakridge Homes for Sale
        </a>
      </div>

      <div class="mt-16 flex flex-wrap justify-start gap-8 text-sm text-white/50">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-gold" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
          Sutton Group Chapman Realty
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-gold" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Licensed Real Estate Broker
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-gold" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
          </svg>
          West London Local
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-white/30 animate-bounce">
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M19 9l-7 7-7-7"/>
      </svg>
    </div>
  </section>

  <a href={`/blog/${MARKET_SNAPSHOT.blogSlug}/`} class="block bg-navy-dark border-b border-white/10 py-4 hover:bg-navy transition-colors">
    <div class="container-site">
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-2 text-center">
        <span class="text-gold text-xs font-semibold uppercase tracking-wider">{MARKET_SNAPSHOT.monthLabel} · {MARKET_SNAPSHOT.areaName} Market Pulse</span>
        <span class="text-white/80 text-sm"><strong class="text-white">{MARKET_SNAPSHOT.avgPrice}</strong> avg. price</span>
        <span class="text-white/80 text-sm"><strong class="text-white">{MARKET_SNAPSHOT.medianDaysOnMarket}</strong> median time on market</span>
        <span class="text-white/80 text-sm"><strong class="text-white">{MARKET_SNAPSHOT.soldAboveList}</strong> sold above asking</span>
        <span class="text-gold text-xs font-semibold underline underline-offset-2">Full report →</span>
      </div>
    </div>
  </a>

  {activeListings.length > 0 && (
    <section class="py-14 md:py-20 bg-cream">
      <div class="container-site">
        <div class="text-center mb-10">
          <div class="inline-block text-gold text-sm font-semibold tracking-wider uppercase mb-4">Currently Listed</div>
          <h2 class="font-serif text-3xl md:text-4xl text-navy mb-4">Featured Listings</h2>
          <div class="gold-divider mx-auto"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
          {activeListings.map((l) => (
            <a href={l.url} class="card overflow-hidden hover:border-gold/30 border border-transparent group block">
              <div class="aspect-[4/3] bg-cream relative overflow-hidden">
                {l.photoUrl ? (
                  <img src={l.photoUrl} alt={`${l.address}, ${l.city}`} class="w-full h-full object-cover" loading="lazy" />
                ) : (
                  <div class="flex items-center justify-center h-full"><span class="text-5xl">🏡</span></div>
                )}
              </div>
              <div class="p-5">
                <div class="flex items-start justify-between gap-3 mb-1">
                  <h3 class="font-serif text-lg text-navy font-bold group-hover:text-gold transition-colors">{l.address}</h3>
                </div>
                <p class="text-slate text-sm mb-2">{l.city}</p>
                <div class="flex items-center gap-3 text-xs text-navy/70 mb-2">
                  {l.beds && <span>{l.beds} bed</span>}
                  {l.baths && <span>{l.baths} bath</span>}
                </div>
                <span class="text-gold text-sm font-semibold">{l.price}</span>
              </div>
            </a>
          ))}
        </div>
        <div class="text-center mt-10">
          <a href="/search/" class="btn-secondary">View All Listings</a>
        </div>
      </div>
    </section>
  )}

  <section class="py-12 md:py-20 bg-navy-dark text-white">
    <div class="container-site">
      <div class="text-center mb-12">
        <div class="inline-block text-gold text-sm font-semibold tracking-wider uppercase mb-4">1959 — 2026</div>
        <h2 class="font-serif text-3xl md:text-4xl mb-4">Oakridge, Then and Now</h2>
        <div class="gold-divider mx-auto mb-4"></div>
        <p class="text-white/60 max-w-2xl mx-auto text-lg">
          Justin's family has called Oakridge home since 1959 — through farmland, first construction, and the tree canopy it's known for today.
        </p>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
        {rootsTimeline.map((frame) => (
          <div class="group relative rounded-xl overflow-hidden shadow-lg aspect-[3/4] bg-navy-light">
            <img
              src={frame.src}
              alt={frame.alt}
              class="w-full h-full object-cover transition-all duration-700 ease-out md:grayscale md:brightness-90 md:group-hover:scale-105 md:group-hover:grayscale-0 md:group-hover:brightness-100"
              loading="lazy"
            />
            <div class="absolute top-3 left-3 bg-navy-dark/75 backdrop-blur-sm text-gold text-xs font-bold tracking-wide px-3 py-1 rounded-full">
              {frame.year}
            </div>
            <div class="absolute inset-x-0 bottom-0 p-3 pt-8 md:p-4 md:pt-10 bg-gradient-to-t from-navy-dark/95 to-transparent text-xs text-white/85 leading-relaxed opacity-100 translate-y-0 md:opacity-0 md:translate-y-2 transition-all duration-300 ease-out md:group-hover:opacity-100 md:group-hover:translate-y-0">
              {frame.caption}
            </div>
          </div>
        ))}
      </div>
      <p class="text-center text-white/40 text-sm mt-6">Hover a photo to read its story. Full history on the <a href="/areas/oakridge/" class="text-gold hover:underline">Oakridge area page</a></p>
    </div>
  </section>

  <section class="py-12 md:py-20 bg-cream">
    <div class="container-site">
      <div class="text-center mb-12">
        <h2 class="section-heading">How Justin Helps You</h2>
        <div class="gold-divider mx-auto mb-4"></div>
        <p class="section-subheading mx-auto">
          Whether you are buying your first home, selling your family home, or building a portfolio, there is a tailored approach for every situation.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {SERVICES.slice(0, 4).map((service) => (
          <a
            href={`/services/${service.slug}/`}
            class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow duration-300 overflow-hidden p-6 group border border-transparent hover:border-gold/30 block"
          >
            <div class="text-3xl mb-4">{service.icon}</div>
            <h3 class="font-serif text-lg text-navy mb-2 group-hover:text-gold transition-colors">{service.name}</h3>
            <p class="text-sm text-slate leading-relaxed">{service.description}</p>
            <div class="mt-4 flex items-center gap-1 text-gold text-sm font-medium">
              Learn more
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center mt-10">
        <a href="/services/" class="btn-secondary">View All Services</a>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-20 bg-white">
    <div class="container-site">
      <div class="text-center mb-12">
        <h2 class="section-heading">Areas We Serve</h2>
        <div class="gold-divider mx-auto mb-4"></div>
        <p class="section-subheading mx-auto">
          Deep knowledge of West London communities means better advice, better prices, and better outcomes for every client.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {AREAS.filter((area) => ['oakridge', 'west-london', 'whitehills', 'byron', 'westmount'].includes(area.slug)).map((area) => (
          <a
            href={`/areas/${area.slug}/`}
            class="group relative bg-navy rounded-xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 block"
          >
            <div class="absolute inset-0 bg-gradient-to-t from-navy-dark via-navy/60 to-transparent z-10"></div>
            <img
              src={area.image}
              alt={`${area.name} neighbourhood, London Ontario`}
              class="h-48 w-full object-cover transition-transform duration-300 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 flex flex-col justify-end p-5 z-20">
              <h3 class="font-serif text-xl text-white group-hover:text-gold transition-colors">{area.name}</h3>
              <p class="text-sm text-white/60 mt-1 line-clamp-2">{area.description}</p>
              <div class="mt-3 flex items-center gap-1 text-gold text-sm font-medium opacity-0 group-hover:opacity-100 translate-y-2 group-hover:translate-y-0 transition-all">
                Explore {area.shortName}
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
      <p class="text-center text-sm text-slate mt-6">Also serving Riverbend and Lambeth.</p>
    </div>
  </section>

  <section class="py-12 md:py-20 bg-navy-dark text-white">
    <div class="container-site">
      <div class="text-center mb-12">
        <div class="inline-block text-gold text-sm font-semibold tracking-wider uppercase mb-4">This Is Oakridge</div>
        <h2 class="font-serif text-3xl md:text-4xl mb-4">Sifton Bog</h2>
        <div class="gold-divider mx-auto mb-4"></div>
        <p class="text-white/60 max-w-2xl mx-auto text-lg">
          One of the rarest natural features in any Canadian city — a genuine kettle bog with carnivorous plants and migratory birds, minutes from most Oakridge homes. Photographed by Justin.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="rounded-2xl overflow-hidden shadow-2xl md:col-span-2 md:row-span-2">
          <img
            src="/images/areas/sifton-bog-sunrise-skyline-oakridge.webp"
            alt="Sunrise over Sifton Bog with the London Ontario downtown skyline in the distance"
            class="w-full h-full object-cover aspect-[4/3] md:aspect-auto"
            loading="lazy"
          />
        </div>
        <div class="rounded-2xl overflow-hidden shadow-xl">
          <img
            src="/images/areas/sifton-bog-sunset-oakridge.webp"
            alt="Golden hour sunset over Sifton Bog, Oakridge, London Ontario"
            class="w-full h-full object-cover aspect-[4/3]"
            loading="lazy"
          />
        </div>
        <div class="rounded-2xl overflow-hidden shadow-xl">
          <img
            src="/images/areas/sifton-bog-aerial-square-oakridge.webp"
            alt="Top-down aerial view of Sifton Bog's kettle bog waters and surrounding forest"
            class="w-full h-full object-cover aspect-[4/3]"
            loading="lazy"
          />
        </div>
      </div>
      <p class="text-center text-white/40 text-sm mt-6">
        More on the <a href="/areas/oakridge/#parks" class="text-gold hover:underline">Oakridge area page</a>
      </p>
    </div>
  </section>

  <!-- TESTIMONIALS — sourced from src/data/testimonials.ts -->
  <section class="py-12 md:py-20 bg-cream">
    <div class="container-site">
      <div class="text-center mb-12">
        <a
          href={SITE.social.googleReviews}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 bg-white rounded-full px-5 py-2.5 shadow-sm mb-6 hover:shadow-md transition-shadow"
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          <div class="flex gap-0.5">
            {[...Array(5)].map(() => (
              <svg class="w-3.5 h-3.5 text-gold" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            ))}
          </div>
          <span class="text-sm font-semibold text-navy">5.0 on Google</span>
        </a>

        <h2 class="section-heading">What Clients Say</h2>
        <div class="gold-divider mx-auto mb-4"></div>
        <p class="section-subheading mx-auto">
          Real feedback from West London buyers and sellers.
        </p>
      </div>

      <div class={`grid grid-cols-1 gap-6 mx-auto ${TESTIMONIALS.length >= 3 ? 'md:grid-cols-3' : 'md:grid-cols-2 max-w-3xl'}`}>
        {TESTIMONIALS.map((review) => (
          <div class="bg-white rounded-xl p-6 shadow-sm border border-transparent hover:border-gold/20 transition-colors flex flex-col">
            <div class="flex gap-0.5 mb-4">
              {[...Array(5)].map(() => (
                <svg class="w-4 h-4 text-gold" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              ))}
            </div>
            <blockquote class="text-slate text-sm leading-relaxed mb-5 flex-1">
              &ldquo;{review.text}&rdquo;
            </blockquote>
            <div class="flex items-center gap-3 pt-4 border-t border-cream">
              <div class="w-8 h-8 rounded-full bg-navy flex items-center justify-center text-xs text-gold font-bold shrink-0">
                {review.author[0]}
              </div>
              <div>
                <div class="text-sm font-semibold text-navy">{review.author}</div>
                <div class="text-xs text-slate">{review.date} · Google Review</div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-10">
        <a
          href={SITE.social.googleReviews}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 btn-secondary"
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
