---
export const prerender = false; // live "Homes for Sale, all REALTORS®" section — see src/lib/ddf.ts
import Base from '@/layouts/Base.astro';
import Schema from '@/components/Schema.astro';
import GoogleMap from '@/components/GoogleMap.astro';
import AreaMap from '@/components/AreaMap.astro';
import ContactForm from '@/components/ContactForm.astro';
import AreaMarketStatsBlock from '@/components/AreaMarketStatsBlock.astro';
import { AREAS, getArea } from '@/data/areas';
import { SITE } from '@/data/site';
import { getAreaMarketListings } from '@/lib/ddf';
import { fmtPrice, field, buildAddress, buildStreetAddress, listingPhotoAlt } from '@/lib/listings';
import { getMarketStatsSnapshot, getAreaStats } from '@/lib/market-stats';

const DEPRECATED_SLUGS = new Set([
  'masonville', 'old-north', 'sunningdale', 'fox-hollow',
  'downtown', 'south-london', 'river-bend', 'medway',
  'komoka', 'hyde-park',
]);

const { area: areaSlugParam } = Astro.params;
const area = areaSlugParam && areaSlugParam !== 'oakridge' ? getArea(areaSlugParam) : undefined;

if (!area) {
  return Astro.redirect('/areas/', 302);
}

const isDeprecated = DEPRECATED_SLUGS.has(area.slug);

const marketStatsSnapshot = await getMarketStatsSnapshot();
const areaStats = getAreaStats(marketStatsSnapshot, area.slug);

const areaListings = (await getAreaMarketListings(area.slug)).map((l) => {
  const L = l as Record<string, unknown>;
  const listingAddress = buildAddress(L);
  const listingCity = field(L, 'City');
  const listingBeds = field(L, 'BedroomsTotal');
  const listingType = field(L, 'PropertySubType', 'PropertyType');
  return {
    address: listingAddress,
    city: listingCity,
    price: fmtPrice(L.ListPrice),
    beds: listingBeds,
    baths: field(L, 'BathroomsTotalInteger', 'BathroomsTotal'),
    type: listingType,
    brokerage: field(L, 'ListOfficeName'),
    photoUrl: (L._photoUrl as string | null) ?? null,
    // Already scoped to this one neighbourhood via getAreaMarketListings, so
    // no geo lookup needed — area.name is the neighbourhood directly.
    photoAlt: listingPhotoAlt({ address: buildStreetAddress(L), city: listingCity, neighbourhood: area.name, beds: listingBeds, propertyType: listingType }, 0),
    detailHref: `/search/${field(L, 'ListingKey', 'ListingId').toLowerCase()}/`,
  };
});

const areaServices = [
  { label: 'Buy in ' + area.shortName, href: `/areas/${area.slug}/buy/`, icon: '🏡' },
  { label: 'Sell in ' + area.shortName, href: `/areas/${area.slug}/sell/`, icon: '📈' },
  { label: 'Home Evaluation', href: `/areas/${area.slug}/home-evaluation/`, icon: '📋' },
];
---

<Base title={area.metaTitle} description={area.metaDescription} noindex={isDeprecated}>
  <Fragment slot="head">
    <Schema
      type="area"
      areaName={area.name}
      areaGeo={area.geo}
      description={area.description}
      pageUrl={`${SITE.url}/areas/${area.slug}/`}
      faqs={area.faqs}
      marketStats={areaStats ? {
        medianListPrice: areaStats.medianListPrice,
        activeCount: areaStats.activeCount,
        avgDaysOnMarket: areaStats.avgDaysOnMarket,
        asOf: marketStatsSnapshot!.updatedAt,
      } : undefined}
    />
  </Fragment>

  <!-- Hero -->
  <section class="bg-navy py-20 text-white">
    <div class="container-site">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-white/50 mb-8">
        <a href="/" class="hover:text-gold transition-colors">Home</a>
        <span>/</span>
        <a href="/areas/" class="hover:text-gold transition-colors">Areas We Serve</a>
        <span>/</span>
        <span class="text-white/70">{area.name}</span>
      </nav>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h1 class="font-serif text-5xl font-bold mb-4">
            Homes for Sale in {area.name}, London Ontario
          </h1>
          <div class="gold-divider mb-6"></div>
          <p class="text-xl text-white/70 leading-relaxed mb-8">{area.headline}</p>

          <!-- Quick service links -->
          <div class="flex flex-wrap gap-3">
            {areaServices.map((svc) => (
              <a href={svc.href} class="flex items-center gap-2 bg-white/10 hover:bg-gold hover:text-navy text-white text-sm font-medium px-5 py-3 rounded-lg transition-all border border-white/10 hover:border-gold">
                <span>{svc.icon}</span>
                {svc.label}
              </a>
            ))}
          </div>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-white/10 rounded-xl p-6 border border-white/10">
            <div class="text-gold text-sm font-semibold uppercase tracking-wider mb-2">Avg. Price Range</div>
            <div class="font-serif text-2xl text-white">{area.avgPrice}</div>
          </div>
          <div class="bg-white/10 rounded-xl p-6 border border-white/10">
            <div class="text-gold text-sm font-semibold uppercase tracking-wider mb-2">Home Types</div>
            <div class="text-white/80 text-sm">{area.homingTypes.join(', ')}</div>
          </div>
          <div class="bg-white/10 rounded-xl p-6 border border-white/10 col-span-2">
            <div class="text-gold text-sm font-semibold uppercase tracking-wider mb-2">Nearby Amenities</div>
            <div class="text-white/80 text-sm">{area.nearbyAmenities.join(' · ')}</div>
          </div>
        </div>
        <p class="text-white/50 text-xs mt-4">
          Own a home in {area.name}? <a href="/home-value-estimate/" class="text-gold underline">Get an instant ballpark estimate</a> of what it might be worth.
        </p>
      </div>
    </div>
  </section>

  <!-- Static, crawlable market-stats sentence — server-rendered from the
       weekly snapshot (see src/lib/market-stats.ts), not client JS. -->
  {areaStats && (
    <section class="py-8 bg-white">
      <div class="container-site">
        <AreaMarketStatsBlock areaName={area.name} stats={areaStats} />
      </div>
    </section>
  )}

  <!-- Homes for Sale — live, every REALTOR® in the area, not just Justin's -->
  {areaListings.length > 0 && (
    <section class="py-16 bg-white">
      <div class="container-site">
        <div class="text-center mb-10">
          <div class="inline-block text-gold-deep text-sm font-semibold tracking-wider uppercase mb-4">
            {areaListings.length} Active Listing{areaListings.length !== 1 ? 's' : ''} · All REALTORS®
          </div>
          <h2 class="section-heading">Homes for Sale in {area.name}</h2>
          <div class="gold-divider mx-auto mb-4"></div>
          <p class="text-slate max-w-2xl mx-auto">
            Every active MLS® listing in {area.name}, from every brokerage — not just Justin's own. Powered by REALTOR.ca data.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {areaListings.slice(0, 9).map((l) => (
            <a href={l.detailHref} class="card overflow-hidden hover:border-gold/30 border border-transparent group block">
              <div class="aspect-[4/3] bg-cream relative overflow-hidden">
                {l.photoUrl ? (
                  <img src={l.photoUrl} alt={l.photoAlt} class="w-full h-full object-cover" loading="lazy" />
                ) : (
                  <div class="flex items-center justify-center h-full"><span class="text-5xl">🏡</span></div>
                )}
                {l.type && (
                  <div class="absolute top-2 right-2">
                    <span class="bg-navy/80 text-white text-xs font-medium px-2 py-0.5 rounded-full">{l.type}</span>
                  </div>
                )}
              </div>
              <div class="p-3.5">
                <div class="font-serif text-lg text-navy font-bold mb-0.5 group-hover:text-gold transition-colors">{l.price}</div>
                <p class="text-slate text-xs leading-snug mb-2 line-clamp-1">{l.address}</p>
                <div class="flex items-center gap-3 text-xs text-navy/70 border-t border-gray-100 pt-2">
                  {l.beds && <span>{l.beds} bed</span>}
                  {l.baths && <span>{l.baths} bath</span>}
                </div>
                <p class="text-[10px] text-slate mt-1.5">Courtesy of {l.brokerage}</p>
              </div>
            </a>
          ))}
        </div>
        {areaListings.length > 9 && (
          <div class="text-center mt-10">
            <a href={`/search/?area=${area.slug}`} class="btn-secondary">View All {areaListings.length} Listings</a>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- About + Map -->
  <section class="py-20 bg-cream">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <div>
          <h2 class="section-heading">About {area.name}</h2>
          <div class="gold-divider mb-6"></div>
          <p class="text-slate leading-relaxed text-lg mb-8">{area.longDescription}</p>

          <h3 class="font-serif text-xl text-navy mb-4">Neighbourhood Highlights</h3>
          <ul class="space-y-3">
            {area.highlights.map((h) => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-gold shrink-0 mt-0.5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span class="text-navy/80">{h}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="space-y-6">
          <GoogleMap query={area.mapEmbedId} title={`${area.name}, London Ontario`} height="380px" />

          <div class="bg-white rounded-xl p-6 shadow-card">
            <h3 class="font-serif text-xl text-navy mb-4">Schools in {area.name}</h3>
            <ul class="space-y-2">
              {area.schools.map((school) => (
                <li class="flex items-center gap-2 text-navy/70 text-sm">
                  <svg class="w-4 h-4 text-gold shrink-0" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 3L1 9l11 6 9-4.91V17h2V9L12 3zm0 12.08L5.08 11.1 12 8.54l6.92 2.56L12 15.08z"/>
                  </svg>
                  {school}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Schools Section -->
  {area.schoolsData && (
    <section id="schools" class="py-20 bg-cream">
      <div class="container-site">
        <div class="text-center mb-12">
          <h2 class="section-heading">Schools in {area.name}</h2>
          <div class="gold-divider mx-auto mb-4"></div>
          <p class="section-subheading mx-auto">
            In-boundary elementary and secondary schools for families buying in {area.name}, London Ontario.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 mb-10">
          <!-- Elementary Schools -->
          <div>
            <h3 class="font-serif text-2xl text-navy mb-5 flex items-center gap-3">
              <span class="w-8 h-8 bg-gold rounded-lg flex items-center justify-center text-navy text-xs font-bold shrink-0">E</span>
              Elementary Schools
            </h3>
            <div class="space-y-3">
              {area.schoolsData.elementary.map((school) => (
                <div class="bg-white rounded-xl p-5 shadow-card">
                  <div class="flex items-start justify-between gap-3 mb-2">
                    <h4 class="font-serif text-base text-navy leading-snug">{school.name}</h4>
                    <span class={`shrink-0 text-xs font-semibold px-2 py-0.5 rounded-full ${school.board === 'TVDSB' ? 'bg-navy/10 text-navy' : 'bg-amber-50 text-amber-800'}`}>
                      {school.board}
                    </span>
                  </div>
                  <div class="flex items-center gap-1.5 text-slate text-sm mb-2">
                    <svg class="w-3.5 h-3.5 text-gold shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                    </svg>
                    {school.address}
                  </div>
                  <span class="inline-block text-xs bg-cream text-navy px-2 py-0.5 rounded-full">Grades {school.grades}</span>
                  {school.notes && <p class="text-xs text-slate mt-2 italic">{school.notes}</p>}
                </div>
              ))}
            </div>
          </div>

          <!-- Secondary Schools -->
          <div>
            <h3 class="font-serif text-2xl text-navy mb-5 flex items-center gap-3">
              <span class="w-8 h-8 bg-navy rounded-lg flex items-center justify-center text-white text-xs font-bold shrink-0">S</span>
              Secondary Schools
            </h3>
            <div class="space-y-3">
              {area.schoolsData.secondary.map((school) => (
                <div class="bg-white rounded-xl p-5 shadow-card">
                  <div class="flex items-start justify-between gap-3 mb-2">
                    <h4 class="font-serif text-base text-navy leading-snug">{school.name}</h4>
                    <span class={`shrink-0 text-xs font-semibold px-2 py-0.5 rounded-full ${school.board === 'TVDSB' ? 'bg-navy/10 text-navy' : 'bg-amber-50 text-amber-800'}`}>
                      {school.board}
                    </span>
                  </div>
                  <div class="flex items-center gap-1.5 text-slate text-sm mb-2">
                    <svg class="w-3.5 h-3.5 text-gold shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                    </svg>
                    {school.address}
                  </div>
                  <span class="inline-block text-xs bg-cream text-navy px-2 py-0.5 rounded-full">Grades {school.grades}</span>
                  {school.notes && <p class="text-xs text-slate mt-2 italic">{school.notes}</p>}
                </div>
              ))}
            </div>
          </div>
        </div>

        {area.schoolsData.sectionNote && (
          <div class="bg-gold/10 border border-gold/30 rounded-xl p-5 mb-8">
            <p class="text-sm text-navy/80 leading-relaxed">{area.schoolsData.sectionNote}</p>
          </div>
        )}

        <p class="text-center text-sm text-slate leading-relaxed">
          Catchment boundaries change. Always verify your address using the{' '}
          <a href="https://www.tvdsb.ca/en/schools/find-my-local-school.aspx" class="text-gold-deep underline" target="_blank" rel="noopener noreferrer">TVDSB school locator</a>
          {' '}or the{' '}
          <a href="https://www.ldcsb.ca/apps/pages/index.jsp?uREC_ID=1076461&type=d&pREC_ID=1360078" class="text-gold-deep underline" target="_blank" rel="noopener noreferrer">LDCSB school finder</a>.
        </p>
      </div>
    </section>
  )}

  <!-- Parks Section -->
  {area.parksData && (
    <section id="parks" class="py-20 bg-white">
      <div class="container-site">
        <div class="text-center mb-12">
          <h2 class="section-heading">Parks in {area.name}</h2>
          <div class="gold-divider mx-auto mb-4"></div>
          <p class="section-subheading mx-auto">
            Parks, trails, and outdoor amenities for families and active residents in {area.name}, London Ontario.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {area.parksData.parks.map((park) => (
            <div class="bg-cream rounded-2xl p-6 border border-gray-100">
              <div class="flex items-start gap-3 mb-3">
                <div class="w-9 h-9 bg-gold/20 rounded-lg flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-4 h-4 text-gold" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-1V1h-2zm3 18H5V8h14v11z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-serif text-lg text-navy leading-snug">{park.name}</h3>
                  <div class="flex items-center gap-1.5 text-slate text-xs mt-0.5">
                    <svg class="w-3 h-3 text-gold shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                    </svg>
                    {park.address}
                  </div>
                </div>
              </div>

              <div class="flex flex-wrap gap-1.5 mb-4">
                {park.amenities.map((amenity) => (
                  <span class="text-xs bg-white text-navy/70 border border-gray-200 px-2.5 py-1 rounded-full">{amenity}</span>
                ))}
              </div>

              {park.highlight && (
                <div class="flex items-start gap-2 pt-3 border-t border-gray-200">
                  <svg class="w-3.5 h-3.5 text-gold shrink-0 mt-0.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                  <span class="text-xs text-slate leading-snug italic">{park.highlight}</span>
                </div>
              )}
            </div>
          ))}
        </div>

        <div class="mt-12">
          <h3 class="font-serif text-xl text-navy mb-4 text-center">Parks &amp; Schools in {area.name}</h3>
          <AreaMap parks={area.parksData.parks} schools={[...(area.schoolsData?.elementary ?? []), ...(area.schoolsData?.secondary ?? [])]} />
        </div>
      </div>
    </section>
  )}

  <!-- Local History -->
  {area.historyData && (
    <section id="history" class="py-20 bg-cream">
      <div class="container-site">
        <div class="text-center mb-12">
          <h2 class="section-heading">Local History of {area.name}</h2>
          <div class="gold-divider mx-auto mb-4"></div>
          {area.historyData.intro && (
            <p class="section-subheading mx-auto">{area.historyData.intro}</p>
          )}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          {area.historyData.entries.map((entry) => (
            <div class="bg-white rounded-2xl p-7 shadow-card border border-gray-100">
              <div class="flex items-start gap-4 mb-4">
                <div class="w-10 h-10 bg-gold/15 rounded-xl flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-5 h-5 text-gold" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M13 3a9 9 0 1 0 0 18A9 9 0 0 0 13 3zm0 16a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm.5-11H12v6l5.25 3.15.75-1.23-4.5-2.67V8z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-serif text-lg text-navy leading-snug">{entry.title}</h3>
                  {entry.year && (
                    <span class="text-xs font-semibold text-gold-deep tracking-wider uppercase mt-0.5 block">{entry.year}</span>
                  )}
                </div>
              </div>
              <p class="text-slate text-sm leading-relaxed">{entry.body}</p>
            </div>
          ))}
        </div>

        {area.historyData.photos && area.historyData.photos.length > 0 && (
          <div class="mt-14 max-w-5xl mx-auto">
            <h3 class="font-serif text-xl text-navy mb-6 text-center">Archival Photos</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              {area.historyData.photos.map((photo) => (
                <figure class="bg-white rounded-2xl overflow-hidden shadow-card border border-gray-100">
                  <div class="relative">
                    <img
                      src={photo.src}
                      alt={photo.alt}
                      class="w-full aspect-[4/3] object-cover object-center grayscale"
                      loading="lazy"
                    />
                    {photo.year && (
                      <span class="absolute top-3 left-3 bg-navy/80 text-white text-xs font-semibold px-2.5 py-1 rounded-full backdrop-blur-sm">
                        {photo.year}
                      </span>
                    )}
                  </div>
                  <figcaption class="p-4 text-xs text-slate leading-relaxed italic">
                    {photo.caption}
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Demographics & Building Trends -->
  {area.demographicsData && (
    <section id="demographics" class="py-20 bg-navy text-white">
      <div class="container-site">
        <div class="text-center mb-12">
          <h2 class="font-serif text-4xl text-white mb-4">By the Numbers — {area.name}</h2>
          <div class="gold-divider mx-auto mb-4"></div>
          <p class="text-white/60 text-lg max-w-2xl mx-auto">
            Neighbourhood demographics and building activity for {area.name}, London Ontario.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          <!-- Stat Cards -->
          {area.demographicsData.stats && area.demographicsData.stats.length > 0 && (
            <div>
              <h3 class="font-serif text-xl text-white mb-5 flex items-center gap-3">
                <span class="w-7 h-7 bg-gold rounded-md flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4 text-navy" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.93 0 3.5 1.57 3.5 3.5S13.93 13 12 13s-3.5-1.57-3.5-3.5S10.07 6 12 6zm7 13H5v-.23c0-.62.28-1.2.76-1.58C7.47 15.82 9.64 15 12 15s4.53.82 6.24 2.19c.48.38.76.97.76 1.58V19z"/>
                  </svg>
                </span>
                Neighbourhood Profile
              </h3>
              <div class="grid grid-cols-2 gap-4">
                {area.demographicsData.stats.map((stat) => (
                  <div class="bg-white/5 border border-white/10 rounded-xl p-5">
                    <div class="text-gold text-xs font-semibold uppercase tracking-wider mb-1">{stat.label}</div>
                    <div class="font-serif text-2xl text-white mb-1">{stat.value}</div>
                    {stat.note && <div class="text-white/50 text-xs leading-snug">{stat.note}</div>}
                  </div>
                ))}
              </div>
              {area.demographicsData.statsSource && (
                <p class="text-white/50 text-xs mt-4">Source: {area.demographicsData.statsSource}</p>
              )}
            </div>
          )}

          <!-- Building Trends -->
          <div>
            <h3 class="font-serif text-xl text-white mb-5 flex items-center gap-3">
              <span class="w-7 h-7 bg-gold rounded-md flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-navy" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                </svg>
              </span>
              Building Activity
            </h3>
            <div class="space-y-4">
              {area.demographicsData.buildingTrends.map((trend) => (
                <div class="flex items-start gap-3">
                  <div class="w-5 h-5 rounded-full bg-gold/20 border border-gold/40 flex items-center justify-center shrink-0 mt-0.5">
                    <div class="w-1.5 h-1.5 rounded-full bg-gold"></div>
                  </div>
                  <p class="text-white/75 text-sm leading-relaxed">{trend}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Local Amenities -->
  {area.localBusinesses && area.localBusinesses.length > 0 && (
    <section class="py-20 bg-navy text-white">
      <div class="container-site">
        <div class="text-center mb-12">
          <h2 class="font-serif text-4xl text-white mb-4">Life in {area.shortName}</h2>
          <div class="gold-divider mx-auto mb-4"></div>
          <p class="text-white/60 text-lg max-w-2xl mx-auto">
            The amenities, parks, and local businesses that make {area.name} worth living in — not just worth buying in.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {area.localBusinesses.map((biz) => (
            <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-gold/40 hover:bg-white/8 transition-all flex flex-col">
              <div class="flex items-start gap-4 mb-4">
                <div class="w-12 h-12 bg-gold/15 rounded-xl flex items-center justify-center text-2xl shrink-0">
                  {biz.icon}
                </div>
                <div>
                  <div class="text-xs font-semibold text-gold tracking-wider uppercase mb-1">{biz.category}</div>
                  <h3 class="font-serif text-lg text-white leading-snug">{biz.name}</h3>
                </div>
              </div>
              <p class="text-white/60 text-sm leading-relaxed flex-1">{biz.description}</p>
              <div class="mt-5 pt-4 border-t border-white/10">
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-gold shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                  <span class="text-xs text-gold/90 leading-snug">{biz.highlight}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Services in this area -->
  <section class="py-20 bg-white">
    <div class="container-site">
      <div class="text-center mb-12">
        <h2 class="section-heading">Services in {area.name}</h2>
        <div class="gold-divider mx-auto mb-4"></div>
        <p class="section-subheading mx-auto">
          Justin provides full-service real estate guidance for houses and homes for sale in the {area.name} market.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <a href={`/search/?area=${area.slug}`} class="card p-8 group text-center hover:border-gold/30 border border-transparent">
          <div class="w-16 h-16 bg-cream rounded-2xl flex items-center justify-center text-3xl mx-auto mb-5">🏡</div>
          <h3 class="font-serif text-xl text-navy mb-3 group-hover:text-gold transition-colors">Buy in {area.shortName}</h3>
          <p class="text-slate text-sm leading-relaxed mb-5">
            Find your perfect home in {area.name} with a local guide who knows every street.
          </p>
          <span class="btn-primary text-sm py-2.5 px-6">Search Homes</span>
        </a>

        <a href={`/areas/${area.slug}/sell/`} class="card p-8 group text-center hover:border-gold/30 border border-transparent">
          <div class="w-16 h-16 bg-cream rounded-2xl flex items-center justify-center text-3xl mx-auto mb-5">📈</div>
          <h3 class="font-serif text-xl text-navy mb-3 group-hover:text-gold transition-colors">Sell in {area.shortName}</h3>
          <p class="text-slate text-sm leading-relaxed mb-5">
            Get top dollar for your {area.name} home with Justin's proven marketing system.
          </p>
          <span class="btn-primary text-sm py-2.5 px-6">Get a Quote</span>
        </a>

        <a href={`/areas/${area.slug}/home-evaluation/`} class="card p-8 group text-center hover:border-gold/30 border border-transparent">
          <div class="w-16 h-16 bg-cream rounded-2xl flex items-center justify-center text-3xl mx-auto mb-5">📋</div>
          <h3 class="font-serif text-xl text-navy mb-3 group-hover:text-gold transition-colors">Complimentary Home Evaluation</h3>
          <p class="text-slate text-sm leading-relaxed mb-5">
            Find out what your {area.name} home is worth in today's market — complimentary, no obligation.
          </p>
          <span class="btn-primary text-sm py-2.5 px-6">Book Evaluation</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA with Form -->
  <section class="py-20 bg-navy text-white">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div>
          <h2 class="font-serif text-4xl mb-4">
            Ready to Make a Move in {area.name}?
          </h2>
          <div class="gold-divider mb-6"></div>
          <p class="text-white/70 leading-relaxed text-lg mb-8">
            Whether you're buying, selling, or just curious about your home's value — Justin is the local expert you want in your corner.
          </p>
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-gold shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
              </svg>
              <a href={`tel:${SITE.phone}`} class="text-white hover:text-gold transition-colors">{SITE.phoneDisplay}</a>
            </div>
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-gold shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
              </svg>
              <a href={`mailto:${SITE.email}`} class="text-white hover:text-gold transition-colors">{SITE.email}</a>
            </div>
          </div>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-8">
          <h3 class="font-serif text-2xl text-white mb-6">Send Justin a Message</h3>
          <ContactForm
            subject={`${area.name} Real Estate Inquiry`}
            ctaLabel="Send Message"
            dark
          />
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  {area.faqs && area.faqs.length > 0 && (
    <section class="py-20 bg-cream">
      <div class="container-site max-w-3xl">
        <div class="text-center mb-12">
          <h2 class="section-heading">Frequently Asked Questions</h2>
          <div class="gold-divider mx-auto mb-4"></div>
          <p class="section-subheading mx-auto">Common questions about buying and selling in {area.name}, London Ontario.</p>
        </div>
        <div class="space-y-4">
          {area.faqs.map((faq, i) => (
            <details class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden group" name={`faq-${area.slug}`}>
              <summary class="flex items-center justify-between gap-4 p-6 cursor-pointer list-none font-semibold text-navy hover:text-gold transition-colors">
                <span>{faq.q}</span>
                <svg class="w-5 h-5 shrink-0 text-gold transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <div class="px-6 pb-6 text-slate leading-relaxed text-sm border-t border-cream pt-4">
                {faq.a}
              </div>
            </details>
          ))}
        </div>
        <div class="text-center mt-10">
          <p class="text-slate text-sm mb-4">Have a question not answered here?</p>
          <a href="/contact/" class="btn-primary">Ask Justin Directly</a>
        </div>
      </div>
    </section>
  )}

  <!-- Internal linking to other areas -->
  <section class="py-16 bg-cream">
    <div class="container-site">
      <h2 class="font-serif text-2xl text-navy mb-6">Explore Other West London Neighbourhoods</h2>
      <div class="flex flex-wrap gap-3">
        {AREAS.filter((a) => a.slug !== area.slug).map((a) => (
          <a href={`/areas/${a.slug}/`} class="bg-white border border-gray-200 hover:border-gold hover:text-gold text-navy/70 text-sm font-medium px-4 py-2 rounded-lg transition-all">
            {a.name}
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
