const categoryBadge: Record<string, string> = {
  public: 'bg-blue-100 text-blue-800',
  catholic: 'bg-purple-100 text-purple-800',
  french: 'bg-rose-100 text-rose-800',
  secondary: 'bg-navy/10 text-navy',
  private: 'bg-indigo-100 text-indigo-800',
};

function fraserStars(rating: number | null): string {
  if (rating === null) return '';
  const full = Math.round(rating);
  return '★'.repeat(full) + '☆'.repeat(10 - full);
}
---

<Base
  title="Oakridge Community Guide — Schools, Golf & Local Resources | Justin Skrypnyk Real Estate Broker"
  description="Your complete guide to schools and golf courses near Oakridge, London Ontario. Public, Catholic, and French schools with Fraser Institute ratings, plus top golf courses within 15 minutes."
>

  <!-- Hero -->
  <section class="bg-navy py-20 text-white">
    <div class="container-site">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-white/40 mb-8">
        <a href="/" class="hover:text-gold transition-colors">Home</a>
        <span>/</span>
        <span class="text-white/70">Community Guide</span>
      </nav>
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 bg-gold/20 text-gold text-sm font-semibold px-4 py-2 rounded-full mb-6 border border-gold/30">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
          </svg>
          Oakridge, West London
        </div>
        <h1 class="font-serif text-5xl font-bold mb-4 leading-tight">
          Oakridge Community Guide
        </h1>
        <div class="gold-divider mb-6"></div>
        <p class="text-xl text-white/70 leading-relaxed mb-4">
          As your neighbourhood expert, I want to give you the information that matters — the schools your kids will attend, the golf courses you'll spend your weekends on, and the community resources that make Oakridge one of West London's best places to live.
        </p>
        <p class="text-white/50 text-sm">
          Schools data sourced from individual school boards and the Fraser Institute's <a href="https://www.compareschoolrankings.org/" target="_blank" rel="noopener noreferrer" class="text-gold hover:text-gold-light underline">Compare School Rankings</a> (2025–2026 report).
        </p>
      </div>
    </div>
  </section>

  <!-- Tab Nav -->
  <div class="bg-white border-b border-gray-200 sticky top-20 z-40">
    <div class="container-site">
      <div class="flex gap-0">
        <button
          id="tab-schools"
          class="community-tab active-tab px-8 py-5 text-sm font-semibold border-b-2 transition-colors"
          data-tab="schools"
        >
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82zM12 3L1 9l11 6 9-4.91V17h2V9L12 3z"/>
            </svg>
            Schools
          </span>
        </button>
        <button
          id="tab-golf"
          class="community-tab px-8 py-5 text-sm font-semibold border-b-2 transition-colors"
          data-tab="golf"
        >
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17 3.34a10 10 0 1 1-14.995 8.984L2 12l.005-.324A10 10 0 0 1 17 3.34zM12 6a1 1 0 0 0-1 1v5.585l-2.293 2.292a1 1 0 0 0 1.414 1.414l2.586-2.585A1 1 0 0 0 13 13V7a1 1 0 0 0-1-1z"/>
            </svg>
            Golf Courses
          </span>
        </button>
      </div>
    </div>
  </div>

  <!-- SCHOOLS TAB -->
  <div id="content-schools" class="tab-content py-16 bg-cream">
    <div class="container-site">
      <div class="mb-10">
        <h2 class="section-heading">Schools Near Oakridge</h2>
        <div class="gold-divider mb-4"></div>
        <p class="section-subheading">
          Oakridge and the surrounding west London area are served by four school boards — offering public, Catholic, and French programs at the elementary and secondary levels.
        </p>
      </div>

      <!-- Filter Buttons -->
      <div class="flex flex-wrap gap-3 mb-10">
        <button class="school-filter active-filter px-5 py-2.5 rounded-full text-sm font-semibold transition-all border" data-filter="all">All Schools</button>
        <button class="school-filter px-5 py-2.5 rounded-full text-sm font-semibold transition-all border" data-filter="public">Public Elementary</button>
        <button class="school-filter px-5 py-2.5 rounded-full text-sm font-semibold transition-all border" data-filter="catholic">Catholic</button>
        <button class="school-filter px-5 py-2.5 rounded-full text-sm font-semibold transition-all border" data-filter="french">French Programs</button>
        <button class="school-filter px-5 py-2.5 rounded-full text-sm font-semibold transition-all border" data-filter="secondary">Secondary</button>
        <button class="school-filter px-5 py-2.5 rounded-full text-sm font-semibold transition-all border" data-filter="private">Private</button>
      </div>

      <!-- Board Legend -->
      <div class="flex flex-wrap gap-4 mb-8 p-4 bg-white rounded-xl border border-gray-200">
        <span class="text-xs font-semibold text-navy/50 uppercase tracking-wider self-center">School Boards:</span>
        <span class="flex items-center gap-1.5 text-xs text-navy/70"><span class="w-3 h-3 rounded-full bg-blue-400 inline-block"></span> Thames Valley DSB (Public)</span>
        <span class="flex items-center gap-1.5 text-xs text-navy/70"><span class="w-3 h-3 rounded-full bg-purple-400 inline-block"></span> London District Catholic SB</span>
        <span class="flex items-center gap-1.5 text-xs text-navy/70"><span class="w-3 h-3 rounded-full bg-rose-400 inline-block"></span> French Immersion / First Language</span>
        <span class="flex items-center gap-1.5 text-xs text-navy/70"><span class="w-3 h-3 rounded-full bg-indigo-400 inline-block"></span> Independent / Private</span>
        <span class="ml-auto text-xs text-slate">Fraser Institute ratings out of 10 · <a href="https://www.compareschoolrankings.org/" target="_blank" rel="noopener noreferrer" class="text-gold hover:underline">compareschoolrankings.org</a></span>
      </div>

      <!-- School Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6" id="school-grid">
        {schools.map((school) => (
          <div
            class={`school-card flex flex-col relative ${school.highlight ? 'pt-3' : ''}`}
            data-category={school.category}
          >
            {school.highlight && (
              <div class="absolute top-0 left-4 bg-gold text-navy text-xs font-bold px-3 py-1 rounded-full shadow-sm z-10">
                #1 in London
              </div>
            )}

            <div class={`card p-0 flex flex-col flex-1 ${school.highlight ? 'ring-2 ring-gold' : ''}`}>
              <!-- Card Header -->
              <div class="p-6 pb-4 border-b border-gray-100">
                <div class="flex items-start justify-between gap-3 mb-3">
                  <span class={`text-xs font-semibold px-3 py-1 rounded-full ${categoryBadge[school.category]}`}>
                    {school.categoryLabel}
                  </span>
                  {school.fraserRating !== null && (
                    <div class="text-right shrink-0">
                      <div class="text-gold text-lg font-bold leading-none">{school.fraserRating.toFixed(1)}<span class="text-navy/30 text-xs font-normal">/10</span></div>
                      <div class="text-gold/60 text-xs tracking-tighter">{fraserStars(school.fraserRating)}</div>
                    </div>
                  )}
                </div>
                <h3 class="font-serif text-lg text-navy leading-tight mb-1">{school.name}</h3>
                <p class="text-xs text-slate">{school.board}</p>
              </div>

              <!-- Card Body -->
              <div class="p-6 flex flex-col flex-1 gap-3">
                <div class="flex items-start gap-2.5 text-sm text-navy/70">
                  <svg class="w-4 h-4 text-gold shrink-0 mt-0.5" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                  </svg>
                  <span>{school.address}</span>
                </div>

                <div class="flex items-center gap-2.5 text-sm text-navy/70">
                  <svg class="w-4 h-4 text-gold shrink-0" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82zM12 3L1 9l11 6 9-4.91V17h2V9L12 3z"/>
                  </svg>
                  <span>Grades {school.grades}</span>
                </div>

                <p class="text-xs text-slate italic flex-1">{school.fraserNote}</p>

                <div class="flex items-center gap-3 pt-2 mt-auto border-t border-gray-100">
                  <a
                    href={school.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex-1 text-center text-sm font-semibold text-gold hover:text-gold-light transition-colors py-2.5 border border-gold/30 hover:border-gold rounded-lg"
                  >
                    Visit Website →
                  </a>
                  <a
                    href={school.fraserLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm text-navy/40 hover:text-navy/70 transition-colors py-2.5 px-3 border border-gray-200 rounded-lg whitespace-nowrap"
                    title="Fraser Institute Rating"
                  >
                    Fraser ↗
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Fraser Institute Note -->
      <div class="mt-10 p-6 bg-white rounded-xl border border-gray-200">
        <div class="flex gap-4 items-start">
          <div class="w-10 h-10 bg-gold/10 rounded-lg flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-gold" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
            </svg>
          </div>
          <div>
            <h4 class="font-semibold text-navy mb-1">About Fraser Institute Ratings</h4>
            <p class="text-sm text-slate leading-relaxed">
              The Fraser Institute rates Ontario's 3,000+ schools out of 10 using nine academic indicators from provincial EQAO test results. Ratings reflect academic performance only — not extracurriculars, arts, or community culture. Some French immersion programs are excluded from ratings. Always visit the school and speak with the community before deciding.
              <a href="https://www.compareschoolrankings.org/" target="_blank" rel="noopener noreferrer" class="text-gold hover:underline ml-1">View all ratings at compareschoolrankings.org →</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- GOLF TAB -->
  <div id="content-golf" class="tab-content hidden py-16 bg-cream">
    <div class="container-site">
      <div class="mb-10">
        <h2 class="section-heading">Golf Courses Near Oakridge</h2>
        <div class="gold-divider mb-4"></div>
        <p class="section-subheading">
          Whether you're a weekend warrior or a serious golfer, Oakridge puts you within 15 minutes of some of the best courses in Southwestern Ontario.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8 mb-12">
        {golf.map((course) => (
          <div class="card flex flex-col p-0 overflow-visible">
            <!-- Course Header -->
            <div class="bg-navy rounded-t-card p-6 relative overflow-hidden">
              <div class="absolute inset-0 opacity-10" style="background: radial-gradient(circle at 70% 50%, #10b981, transparent 70%)"></div>
              <div class="relative">
                <div class="flex items-center justify-between mb-3">
                  <span class={`text-xs font-semibold px-3 py-1 rounded-full ${course.typeColor}`}>{course.type}</span>
                  <span class="text-2xl">{course.icon}</span>
                </div>
                <h3 class="font-serif text-xl text-white leading-tight mb-2">{course.name}</h3>
                <div class="flex items-center gap-2 text-gold text-sm font-semibold">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
                  </svg>
                  <span>{course.driveTime} from Oakridge</span>
                </div>
              </div>
            </div>

            <!-- Course Body -->
            <div class="p-6 flex flex-col flex-1 gap-4">
              <p class="text-sm text-slate leading-relaxed">{course.description}</p>

              <div class="space-y-2">
                {course.details.map((detail) => (
                  <div class="flex items-center gap-2 text-sm text-navy/70">
                    <svg class="w-3.5 h-3.5 text-gold shrink-0" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    {detail}
                  </div>
                ))}
              </div>

              <div class="border-t border-gray-100 pt-4 mt-auto space-y-2">
                <div class="flex items-start gap-2 text-xs text-navy/60">
                  <svg class="w-3.5 h-3.5 text-gold shrink-0 mt-0.5" viewBox="0 0 24 24" fill="currentColor">
