<style>
  .community-tab {
    color: var(--color-slate);
    border-color: transparent;
  }
  .community-tab.active-tab {
    color: var(--color-gold);
    border-color: var(--color-gold);
  }
  .school-filter {
    background: white;
    color: rgba(12, 35, 64, 0.6);
    border-color: #e5e7eb;
  }
  .school-filter.active-filter {
    background: var(--color-navy);
    color: white;
    border-color: var(--color-navy);
  }
</style>

<script>
  const tabs     = document.querySelectorAll<HTMLButtonElement>('.community-tab');
  const contents = document.querySelectorAll<HTMLElement>('.tab-content');

  function activateTab(tabId: string) {
    tabs.forEach((t) => t.classList.toggle('active-tab', t.dataset.tab === tabId));
    contents.forEach((c) => c.classList.toggle('hidden', c.id !== `content-${tabId}`));
  }

  function tabFromHash() {
    return window.location.hash.replace('#', '') === 'golf' ? 'golf' : 'schools';
  }

  // Activate on load and on hash change (covers nav dropdown clicks)
  activateTab(tabFromHash());
  window.addEventListener('hashchange', () => activateTab(tabFromHash()));

  // Tab button clicks
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.tab!;
      activateTab(target);
      history.replaceState(null, '', `#${target}`);
    });
  });

  // School card filter
  const filters     = document.querySelectorAll<HTMLButtonElement>('.school-filter');
  const schoolCards = document.querySelectorAll<HTMLElement>('.school-card');

  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      filters.forEach((f) => f.classList.remove('active-filter'));
      btn.classList.add('active-filter');
      schoolCards.forEach((card) => {
        card.style.display = (filter === 'all' || card.dataset.category === filter) ? '' : 'none';
      });
    });
  });
</script>
