---
// Server-rendered so it can read the latest Supabase snapshot at request
// time (see src/lib/supabase.ts) -- but unlike the page this replaces, that
// read is one cheap indexed query against a twice-monthly cache, not a live
// DDF/PropTx pull, so `prerender = false` here doesn't carry the cost it
// would elsewhere on the site.
export const prerender = false;
import Base from '@/layouts/Base.astro';
import Schema from '@/components/Schema.astro';
import { SITE } from '@/data/site';
import { fmtPrice } from '@/lib/listings';
import { getLatestMarketMapSnapshots, getLatestNotableChanges } from '@/lib/supabase';
import { summarizeArea } from '@/lib/market-map-summary';
import HeatMap from '@/components/HeatMap.astro';
import MarketMapNotifyForm from '@/components/MarketMapNotifyForm.astro';

const snapshots = await getLatestMarketMapSnapshots();
const notableChanges = await getLatestNotableChanges(3);
const asOf = snapshots[0]?.capture_date;

// The 7 areas the site's own content pages serve -- of the 39 shaded on the
// map, only these get a "View area ->" link; the rest are stats-only.
const SERVED_AREA_SLUGS = new Set(['oakridge', 'byron', 'westmount', 'riverbend', 'lambeth', 'whitehills', 'west-london']);

const sortedByPrice = [...snapshots]
  .filter((s) => s.median_list_price != null)
  .sort((a, b) => (b.median_list_price ?? 0) - (a.median_list_price ?? 0));

const FAQS = [
  {
    q: 'How often is this neighbourhood data updated?',
    a: 'Twice a month -- once mid-month (the 15th) and once at the start of the following month, capturing the previous month\'s close. Every neighbourhood shown is refreshed on the same schedule.',
  },
  {
    q: 'Where do the sold price and sale-to-list ratio numbers come from?',
    a: 'A separate, board-authorized VOW (Virtual Office Website) data feed, distinct from the active-listings feed the rest of this map runs on. They\'re rolling 90-day medians per neighbourhood. Individual sold listings (sign-in required) are on the dedicated sold prices map.',
  },
  {
    q: 'What does "Left Market This Period" mean?',
    a: 'It\'s the number of listings that were active in the previous snapshot but are no longer active now -- a rough signal of how quickly homes are moving in that neighbourhood, without needing sold-price data.',
  },
  {
    q: 'Is this every neighbourhood in London, Ontario?',
    a: 'Yes -- all 39 neighbourhoods in the city are shown, mapped to their real boundaries rather than approximate pins. Only 7 (Oakridge, West London, Whitehills, Byron, Westmount, Riverbend, and Lambeth) have a dedicated area page on this site, but every neighbourhood\'s live stats are shown here.',
  },
];
---

<Base
  title="London Ontario Neighbourhood Heat Map | Live In Oakridge"
  description="Median list price, days on market, new listings, and more, mapped across all of London Ontario's neighbourhoods -- from Oakridge and Byron to Masonville and Old South. Updated twice a month from live MLS data."
  image="/images/market-map-og.webp"
>
  <Fragment slot="head">
    <Schema
      type="dataset"
      pageUrl={`${SITE.url}/market-map/`}
      description="Aggregate, per-neighbourhood real estate market statistics for London, Ontario, captured twice monthly from active MLS listings."
      dataset={{
        name: 'London Ontario Neighbourhood Real Estate Market Snapshot',
        variableMeasured: ['Median list price', 'Average days on market', 'New listings', 'Price per square foot', 'Median bedrooms', 'Median bathrooms', 'Percent detached homes', 'Listings delisted per period'],
        datePublished: asOf ?? new Date().toISOString().slice(0, 10),
      }}
      faqs={FAQS}
    />
    <Schema
      type="listing-collection"
      pageUrl={`${SITE.url}/market-map/`}
      description="Every London, Ontario neighbourhood shown on the heat map, ranked by median active listing price."
      itemListName="London Ontario Neighbourhoods by Median List Price"
      itemListTotal={sortedByPrice.length}
      itemList={sortedByPrice.map((s) => ({
        name: s.area_name,
        url: SERVED_AREA_SLUGS.has(s.area_slug)
          ? `${SITE.url}/areas/${s.area_slug}/`
          : `${SITE.url}/market-map/#area-${s.area_slug}`,
      }))}
    />
  </Fragment>

  <section class="bg-navy py-20 text-white">
    <div class="container-site">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-white/50 mb-8">
        <a href="/" class="hover:text-gold transition-colors">Home</a>
        <span>/</span>
        <span class="text-white/70">Neighbourhood Heat Map</span>
      </nav>
      <h1 class="font-serif text-5xl font-bold mb-4">London Ontario Neighbourhood Heat Map</h1>
      <div class="gold-divider mb-6"></div>
      <p class="text-xl text-white/70 max-w-2xl">
        Median list price, days on market, new listings, and more, across every neighbourhood in London -- from Oakridge, Byron, and Riverbend to Masonville, Old South, and Hyde Park. Switch the metric, click a neighbourhood to zoom in.
      </p>
      {asOf && <p class="text-sm text-white/50 mt-4">Stats as of {asOf}</p>}
    </div>
  </section>

  <section class="py-20 bg-cream">
    <div class="container-site max-w-5xl">
      <HeatMap snapshots={snapshots} height="640px" />

      <p class="text-center text-sm text-slate mt-8 max-w-2xl mx-auto">
        Active-listing stats are captured twice monthly (mid-month and month-end); sold-price stats are rolling 90-day medians. Read this as directional, not exact. Want to see individual sold listings?
        <a href="/sold-map/" class="text-gold-deep underline">View the sold prices map</a> (free sign-in required).
      </p>

      {notableChanges.length > 0 && (
        <div class="mt-14">
          <h2 class="font-serif text-2xl text-navy font-bold mb-4 text-center">Notable Moves This Month</h2>
          <div class="grid sm:grid-cols-3 gap-4">
            {notableChanges.map((c) => (
              <div class="bg-white rounded-2xl shadow-card p-5 text-center">
                <p class="font-serif text-lg text-navy font-bold">{c.area_name}</p>
                <p class="text-sm text-slate/70 mb-1">{c.metric.replaceAll('_', ' ')}</p>
                <p class={`text-xl font-bold ${(c.mom_pct_change ?? 0) > 0 ? 'text-emerald-600' : 'text-red-500'}`}>
                  {(c.mom_pct_change ?? 0) > 0 ? '+' : ''}{((c.mom_pct_change ?? 0) * 100).toFixed(1)}%
                </p>
              </div>
            ))}
          </div>
        </div>
      )}

      <div class="overflow-x-auto mt-14">
        <table class="w-full text-sm bg-white rounded-2xl shadow-card overflow-hidden">
          <thead>
            <tr class="bg-navy text-white text-left">
              <th class="px-4 py-3 font-medium">Neighbourhood</th>
              <th class="px-4 py-3 font-medium">Active Listings</th>
              <th class="px-4 py-3 font-medium">Median List Price</th>
              <th class="px-4 py-3 font-medium">Median Sold Price</th>
              <th class="px-4 py-3 font-medium">Units Sold (90d)</th>
              <th class="px-4 py-3 font-medium">Sale-to-List</th>
              <th class="px-4 py-3 font-medium">Avg. Days on Market</th>
              <th class="px-4 py-3 font-medium">Beds</th>
              <th class="px-4 py-3 font-medium">Baths</th>
              <th class="px-4 py-3 font-medium">% Detached</th>
              <th class="px-4 py-3 font-medium">Left Market</th>
            </tr>
          </thead>
          <tbody>
            {sortedByPrice.map((s) => (
              <tr class="border-b border-gray-100 last:border-0">
                <td class="px-4 py-3">
                  {SERVED_AREA_SLUGS.has(s.area_slug)
                    ? <a href={`/areas/${s.area_slug}/`} class="text-navy font-medium hover:text-gold transition-colors">{s.area_name}</a>
                    : <span class="text-navy font-medium">{s.area_name}</span>}
                </td>
                <td class="px-4 py-3 text-slate">{s.active_count ?? '—'}</td>
                <td class="px-4 py-3 text-slate">{s.median_list_price != null ? fmtPrice(s.median_list_price) : '—'}</td>
                <td class="px-4 py-3 text-slate">{s.median_sold_price != null ? fmtPrice(s.median_sold_price) : '—'}</td>
                <td class="px-4 py-3 text-slate">{s.units_sold ?? '—'}</td>
                <td class="px-4 py-3 text-slate">{s.avg_sale_to_list_ratio != null ? `${(s.avg_sale_to_list_ratio * 100).toFixed(1)}%` : '—'}</td>
                <td class="px-4 py-3 text-slate">{s.avg_days_on_market != null ? `${Math.round(s.avg_days_on_market)} days` : '—'}</td>
                <td class="px-4 py-3 text-slate">{s.median_bedrooms ?? '—'}</td>
                <td class="px-4 py-3 text-slate">{s.median_bathrooms ?? '—'}</td>
                <td class="px-4 py-3 text-slate">{s.pct_detached != null ? `${(s.pct_detached * 100).toFixed(0)}%` : '—'}</td>
                <td class="px-4 py-3 text-slate">{s.delisted_count ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-16">
        <h2 class="font-serif text-2xl text-navy font-bold mb-6 text-center">Neighbourhood Snapshots</h2>
        <div class="grid sm:grid-cols-2 gap-4">
          {sortedByPrice.map((s) => (
            <div id={`area-${s.area_slug}`} class="bg-white rounded-2xl shadow-card p-5 scroll-mt-24">
              <p class="font-serif text-lg text-navy font-bold mb-1.5">
                {SERVED_AREA_SLUGS.has(s.area_slug)
                  ? <a href={`/areas/${s.area_slug}/`} class="hover:text-gold transition-colors">{s.area_name}</a>
                  : s.area_name}
              </p>
              <p class="text-sm text-slate leading-relaxed">{summarizeArea(s)}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-16 max-w-3xl mx-auto">
        <h2 class="font-serif text-2xl text-navy font-bold mb-6 text-center">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {FAQS.map((faq) => (
            <div class="bg-white rounded-2xl shadow-card p-5">
              <p class="font-serif text-navy font-bold mb-1.5">{faq.q}</p>
              <p class="text-sm text-slate leading-relaxed">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-16">
        <MarketMapNotifyForm />
      </div>
    </div>
  </section>
</Base>
