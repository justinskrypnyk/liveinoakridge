---
import Base from '@/layouts/Base.astro';
import Schema from '@/components/Schema.astro';
import TrendLineChart from '@/components/TrendLineChart.astro';
import { SITE } from '@/data/site';
import { BLOG_POSTS } from '@/data/blog';
import BlogSignup from '@/components/BlogSignup.astro';

export function getStaticPaths() {
  // Entries with `href` (e.g. best-high-schools-london-ontario) are standalone
  // pages that already live at their own URL -- skip them here so we don't
  // generate a duplicate /blog/[slug]/ page for content that already exists.
  return BLOG_POSTS.filter((post) => !post.href).map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

// The served area a post is about, read from its slug (first match), so the
// end-of-post sign-up can offer that area's listings. General posts get none.
const SERVED_AREAS = [
  { slug: 'oakridge', name: 'Oakridge' },
  { slug: 'byron', name: 'Byron' },
  { slug: 'westmount', name: 'Westmount' },
  { slug: 'riverbend', name: 'Riverbend' },
  { slug: 'lambeth', name: 'Lambeth' },
  { slug: 'whitehills', name: 'Whitehills' },
  { slug: 'west-london', name: 'West London' },
];
const postArea = SERVED_AREAS
  .map((a) => ({ ...a, at: post.slug.indexOf(a.slug) }))
  .filter((a) => a.at !== -1)
  .sort((a, b) => a.at - b.at)[0];

// "Share this article" links. Each network reads the post's og:title/og:image
// itself, so only the URL (plus a title for X) needs to go along.
const shareUrl = `${SITE.url}/blog/${post.slug}/`;
const u = encodeURIComponent(shareUrl);
const SOCIAL_SHARES = [
  {
    method: 'facebook',
    label: 'Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${u}`,
    icon: 'M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07',
  },
  {
    method: 'linkedin',
    label: 'LinkedIn',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`,
    icon: 'M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z',
  },
  {
    method: 'x',
    label: 'X',
    href: `https://x.com/intent/tweet?url=${u}&text=${encodeURIComponent(post.title)}`,
    icon: 'M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.4l-5.8-7.58-6.64 7.58H.48l8.6-9.83L0 1.15h7.59l5.24 6.93 6.07-6.93zm-1.29 19.5h2.04L6.48 3.24H4.3l13.31 17.41z',
  },
];
const shareBtn = 'inline-flex items-center gap-2 rounded-full border border-navy/15 px-4 py-2 text-sm font-semibold text-navy hover:border-gold hover:text-gold-deep transition-colors';
---

<Base
  title={post.seoTitle ?? `${post.title} | Live In Oakridge Blog`}
  description={post.description}
  type="article"
  image={post.image}
>
  <Fragment slot="head">
    <Schema type="blog" pageUrl={`${SITE.url}/blog/${post.slug}/`} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      '@id': `${SITE.url}/blog/${post.slug}/#article`,
      headline: post.title,
      description: post.description,
      image: {
        '@type': 'ImageObject',
        url: post.image ? `${SITE.url}${post.image}` : `${SITE.url}/images/og-default.webp`,
        width: 1200,
        height: 630,
      },
      author: {
        '@type': 'Person',
        '@id': `${SITE.url}/#person`,
        name: post.author,
        url: `${SITE.url}/about/`,
        sameAs: [
          'https://www.youtube.com/@justinskrypnyk',
          'https://www.instagram.com/justinskrypnyk',
        ],
      },
      publisher: {
        '@type': 'Organization',
        '@id': `${SITE.url}/#realestateagent`,
        name: SITE.name,
        url: SITE.url,
        logo: {
          '@type': 'ImageObject',
          url: `${SITE.url}/images/live-in-oakridge-logo.webp`,
        },
      },
      datePublished: post.date,
      dateModified: post.date,
      url: `${SITE.url}/blog/${post.slug}/`,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': `${SITE.url}/blog/${post.slug}/`,
      },
      ...(post.tldr?.length ? { abstract: post.tldr.join(' ') } : {}),
      articleSection: post.category,
      inLanguage: 'en-CA',
      keywords: `${post.category}, London Ontario Real Estate, West London Real Estate, Justin Skrypnyk, Oakridge`,
      about: {
        '@type': 'Thing',
        name: 'London Ontario Real Estate',
        description: 'Residential real estate market in London, Ontario, Canada',
      },
      mentions: [
        { '@type': 'Place', name: 'London, Ontario', sameAs: 'https://en.wikipedia.org/wiki/London,_Ontario' },
        { '@type': 'Place', name: 'Oakridge, London, Ontario' },
        { '@type': 'Place', name: 'West London, Ontario' },
      ],
      locationCreated: { '@type': 'Place', name: 'London, Ontario, Canada' },
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['h1', '.post-tldr', 'article h2:first-of-type'],
      },
      isPartOf: { '@id': `${SITE.url}/#website` },
    })} />
    {post.faqs && post.faqs.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: post.faqs.map(faq => ({
          '@type': 'Question',
          name: faq.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: faq.answer,
          },
        })),
      })} />
    )}
  </Fragment>

  <section class="bg-navy py-10 md:py-16 text-white">
    <div class="container-site max-w-4xl">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-white/50 mb-8">
        <a href="/" class="hover:text-gold transition-colors">Home</a>
        <span>/</span>
        <a href="/blog/" class="hover:text-gold transition-colors">Blog</a>
        <span>/</span>
        <span class="text-white/70 line-clamp-1">{post.title}</span>
      </nav>

      <div class="flex items-center gap-3 mb-6">
        <span class="text-xs font-semibold text-gold bg-gold/15 px-3 py-1 rounded-full border border-gold/30">{post.category}</span>
        <span class="text-white/50 text-sm">{post.readTime}</span>
      </div>

      <h1 class="font-serif text-4xl md:text-5xl font-bold mb-6 leading-tight">{post.title}</h1>

      <div class="flex items-center gap-4 text-sm text-white/50">
        <div class="flex items-center gap-2">
          <img src="/images/justin-skrypnyk-headshot-avatar.webp" alt="Justin Skrypnyk" width="32" height="32" class="w-8 h-8 rounded-full object-cover" />
          <span>{post.author}</span>
        </div>
        <span>·</span>
        <time datetime={post.date}>{post.dateDisplay}</time>
      </div>
    </div>
  </section>

  <article class="py-8 md:py-16 bg-cream">
    <div class="container-site max-w-4xl">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2">
          {post.image && (
            <div class="mb-8 rounded-2xl overflow-hidden shadow-sm">
              <img
                src={post.image}
                alt={post.imageAlt ?? post.title}
                class="w-full h-auto object-cover"
                width="1200"
                height="630"
                loading="eager"
              />
            </div>
          )}

          {post.tldr && post.tldr.length > 0 && (
            <section class="post-tldr mb-8 bg-white rounded-2xl p-5 sm:p-8 shadow-sm border-l-4 border-gold" aria-labelledby="tldr-heading">
              <h2 id="tldr-heading" class="font-serif text-xl text-navy mb-3">TL;DR</h2>
              <ul class="list-disc pl-5 space-y-2 text-slate leading-relaxed marker:text-gold-deep">
                {post.tldr.map((point) => <li>{point}</li>)}
              </ul>
            </section>
          )}

          {post.charts && post.charts.length > 0 && (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
              {post.charts.map((chart) => (
                <div class="bg-white rounded-2xl p-5 shadow-sm">
                  <TrendLineChart
                    title={chart.title}
                    color={chart.color}
                    labels={chart.labels}
                    values={chart.values}
                    valueSuffix={chart.valueSuffix}
                  />
                </div>
              ))}
            </div>
          )}

          <div class="bg-white rounded-2xl p-5 sm:p-8 lg:p-10 shadow-sm prose prose-slate prose-headings:font-serif prose-headings:text-navy prose-a:text-gold-deep prose-strong:text-navy max-w-none" set:html={post.content} />

          {post.faqs && post.faqs.length > 0 && (
            <div class="mt-8 bg-white rounded-2xl p-5 sm:p-8 lg:p-10 shadow-sm">
              <h2 class="font-serif text-2xl text-navy mb-8">Frequently Asked Questions</h2>
              <div class="space-y-6">
                {post.faqs.map(faq => (
                  <div class="border-b border-slate/10 pb-6 last:border-0 last:pb-0">
                    <h3 class="font-semibold text-navy mb-2 leading-snug">{faq.question}</h3>
                    <p class="text-slate text-sm leading-relaxed">{faq.answer}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          <div class="mt-8 bg-white rounded-2xl p-5 sm:p-8 shadow-sm">
            <h2 class="font-serif text-xl text-navy mb-4">Share this article</h2>
            <div class="flex flex-wrap gap-3">
              <button type="button" data-share-copy class={shareBtn}>
                <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5"/></svg>
                <span data-share-label>Copy link</span>
              </button>
              <a data-share="email" href={`mailto:?subject=${encodeURIComponent(post.title)}&body=${encodeURIComponent(`${post.description}\n\n${shareUrl}`)}`} class={shareBtn}>
                <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path stroke-linecap="round" stroke-linejoin="round" d="m3 7 9 6 9-6"/></svg>
                Email
              </a>
              {SOCIAL_SHARES.map((s) => (
                <a data-share={s.method} href={s.href} target="_blank" rel="noopener noreferrer" class={shareBtn} aria-label={`Share on ${s.label} (opens in a new tab)`}>
                  <svg aria-hidden="true" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d={s.icon} /></svg>
                  {s.label}
                </a>
              ))}
              <button type="button" data-share-native hidden class={shareBtn}>
                <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v12M7 8l5-5 5 5M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6"/></svg>
                More
              </button>
            </div>
          </div>

          <BlogSignup postTitle={post.title} area={postArea ? { slug: postArea.slug, name: postArea.name } : undefined} />

          <div class="mt-8 bg-navy text-white rounded-2xl p-8 flex gap-6 items-start">
            <img src="/images/justin-skrypnyk-headshot-avatar.webp" alt="Justin Skrypnyk" width="64" height="64" class="w-16 h-16 rounded-2xl object-cover shrink-0" />
            <div>
              <h3 class="font-serif text-xl mb-1">{post.author}</h3>
              <p class="text-sm text-gold mb-2">Real Estate Broker | Sutton Group Chapman Realty Inc., Brokerage | Oakridge, London Ontario</p>
              <p class="text-sm text-white/60 leading-relaxed">Justin Skrypnyk is a Real Estate Broker serving Oakridge and West London. He writes regularly about the London Ontario market to help buyers and sellers make well-informed decisions.</p>
            </div>
          </div>
        </div>

        <aside class="space-y-6">
          <div class="bg-gold rounded-2xl p-6 text-center">
            <h3 class="font-serif text-lg text-navy mb-3">Questions About the Market?</h3>
            <p class="text-navy text-sm mb-5">Justin is available for a no-pressure conversation about your real estate situation.</p>
            <a href="/contact/" class="btn-white w-full justify-center">Get in Touch</a>
          </div>

          <div class="bg-white rounded-2xl p-6 shadow-sm">
            <h3 class="font-semibold text-navy mb-3 text-sm">Related Pages</h3>
            <ul class="space-y-2">
              <li><a href="/services/home-evaluation/" class="text-sm text-slate hover:text-gold transition-colors">Complimentary Home Evaluation</a></li>
              <li><a href="/areas/" class="text-sm text-slate hover:text-gold transition-colors">West London Neighbourhoods</a></li>
              <li><a href="/mortgages/calculator/" class="text-sm text-slate hover:text-gold transition-colors">Mortgage Calculator</a></li>
              <li><a href="/services/first-time-buyers/" class="text-sm text-slate hover:text-gold transition-colors">First-Time Buyer Guide</a></li>
            </ul>
          </div>

          <div class="bg-white rounded-2xl p-6 shadow-sm">
            <h3 class="font-semibold text-navy mb-4 text-sm">More Articles</h3>
            <ul class="space-y-3">
              {BLOG_POSTS.filter((p) => p.slug !== post.slug).slice(0, 3).map((p) => (
                <li>
                  <a href={p.href ?? `/blog/${p.slug}/`} class="text-sm text-slate hover:text-gold transition-colors leading-snug block">{p.title}</a>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </article>
</Base>

<script>
  // Share buttons. The copied/emailed link is the clean canonical URL (no
  // ?utm or #hash), and each use is sent to GA4 as its recommended `share`
  // event so we can see which posts actually get passed along.
  const track = (method: string) => {
    const w = window as unknown as { gtag?: (...args: unknown[]) => void };
    w.gtag?.('event', 'share', { method, content_type: 'article', item_id: location.pathname });
  };

  document.querySelector<HTMLButtonElement>('[data-share-copy]')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const label = btn.querySelector('[data-share-label]');
    const url = location.origin + location.pathname;
    try {
      await navigator.clipboard.writeText(url);
      if (label) label.textContent = 'Link copied';
    } catch {
      window.prompt('Copy this link:', url);
    }
    track('copy_link');
    setTimeout(() => { if (label) label.textContent = 'Copy link'; }, 2000);
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-share]').forEach((a) => {
    a.addEventListener('click', () => track(a.dataset.share ?? 'link'));
  });

  // "More" opens the phone's own share sheet (Messages, WhatsApp, Messenger,
  // etc.). Only shown where the browser supports it -- mostly phones.
  const native = document.querySelector<HTMLButtonElement>('[data-share-native]');
  if (native && typeof navigator.share === 'function') {
    native.hidden = false;
    native.addEventListener('click', async () => {
      try {
        await navigator.share({ title: document.title, url: location.origin + location.pathname });
        track('native');
      } catch {
        // Closing the share sheet throws AbortError -- nothing to do.
      }
    });
  }
</script>
