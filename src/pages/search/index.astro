---
export const prerender = false; // live Ontario-wide DDF search — see src/lib/ddf.ts
import Base from '@/layouts/Base.astro';
import { searchMarketListings, searchNationalPoolByBounds } from '@/lib/ddf';
import { fmtPrice, field, buildAddress, listingSlug } from '@/lib/listings';
import { AREAS } from '@/data/areas';
import { getAreaBounds, getAllAreasBounds } from '@/lib/area-boundaries';

const params = Astro.url.searchParams;
const q = params.get('q') || '';
const area = params.get('area') || '';
const minPrice = Number(params.get('minPrice')) || undefined;
const maxPrice = Number(params.get('maxPrice')) || undefined;
const propertyType = params.get('type') || '';
const page = Number(params.get('page')) || 1;

const priceSteps = Array.from({ length: 40 }, (_, i) => (i + 1) * 50000);
function shortPrice(n: number): string {
  if (n >= 1000000) return `$${(n / 1000000).toFixed(n % 1000000 === 0 ? 0 : 1)}M`;
  return `$${Math.round(n / 1000)}K`;
}

function areaUrl(slug: string): string {
  const u = new URLSearchParams(params);
  u.delete('q');
  u.delete('page');
  if (slug) u.set('area', slug);
  else u.delete('area');
  return `/search/?${u.toString()}`;
}

// Text search (a specific address/city/MLS® number anywhere in Ontario)
// stays on the existing AMPRE-backed path — unrelated to the map below,
// which is the "browse everything" default view.
const textResult = q
  ? await searchMarketListings({ query: q, minPrice, maxPrice, propertyType, page })
  : null;

const textCards = (textResult?.listings ?? []).map((l) => {
  const L = l as Record<string, unknown>;
  return {
    address: buildAddress(L),
    city: field(L, 'City'),
    price: fmtPrice(L.ListPrice),
    beds: field(L, 'BedroomsTotal'),
    baths: field(L, 'BathroomsTotalInteger', 'BathroomsTotal'),
    sqft: field(L, 'BuildingAreaTotal'),
    type: field(L, 'PropertySubType', 'PropertyType'),
    brokerage: field(L, 'ListOfficeName'),
    photoUrl: (L._photoUrl as string | null) ?? null,
    detailHref: `/search/${listingSlug(L)}/`,
  };
});

function pageUrl(p: number): string {
  const u = new URLSearchParams(params);
  u.set('page', String(p));
  return `/search/?${u.toString()}`;
}

// Browse mode (no `q`): a live, pannable/zoomable map covering every active
// residential listing in Ontario, sourced from National Pool (see
// src/lib/ddf.ts — AMPRE can't do viewport queries at all). Area tabs and
// the initial server render both start at a specific bounding box; from
// there the map component in the script below re-fetches on every pan/zoom.
const initialBounds = (area ? getAreaBounds(area) : null) ?? getAllAreasBounds();
const browseResult = !q
  ? await searchNationalPoolByBounds({ ...initialBounds, minPrice, maxPrice, propertyType: propertyType || undefined })
  : null;

const browseCards = (browseResult?.listings ?? []).map((l) => {
  const L = l as Record<string, unknown>;
  const geo = L._geo as { lat: number; lng: number } | null;
  return {
    lat: geo?.lat ?? null,
    lng: geo?.lng ?? null,
    mls: field(L, 'ListingKey', 'ListingId'),
    price: fmtPrice(L.ListPrice),
    rawPrice: Number(L.ListPrice) || 0,
    address: buildAddress(L),
    city: field(L, 'City'),
    beds: field(L, 'BedroomsTotal'),
    baths: field(L, 'BathroomsTotalInteger', 'BathroomsTotal'),
    sqft: field(L, 'BuildingAreaTotal'),
    type: field(L, 'PropertySubType'),
    brokerage: field(L, 'ListOfficeName'),
    photoUrl: (L._photoUrl as string | null) ?? null,
    href: `/search/${listingSlug(L)}/`,
  };
});

const areaBoundsJson = Object.fromEntries(
  AREAS.map((a) => [a.slug, getAreaBounds(a.slug)]).filter(([, b]) => b)
);
const allAreasBoundsForClient = getAllAreasBounds();
---

<Base
  title="Browse London MLS® Listings, Every Brokerage | Justin Skrypnyk Real Estate Broker"
  description="Browse every active MLS® listing in Ontario from every brokerage on one interactive map, or search a specific city, address, or MLS® number. Brought to you by Justin Skrypnyk, Real Estate Broker."
  noindex
>
  <section class="bg-navy py-16 text-white">
    <div class="container-site">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-white/40 mb-8">
        <a href="/" class="hover:text-gold transition-colors">Home</a>
        <span>/</span>
        <span class="text-white/70">Search Ontario Listings</span>
      </nav>
      <h1 class="font-serif text-5xl font-bold mb-4">Browse & Search MLS® Listings</h1>
      <div class="gold-divider mb-6"></div>
      <p class="text-xl text-white/70 max-w-2xl">
        Every active listing in Ontario, every brokerage, on one map — pan and zoom anywhere, or jump straight to a neighbourhood below. Or search a specific city, address, or MLS® number.
      </p>
    </div>
  </section>

  <section class="py-6 bg-white border-b border-gray-100 sticky top-20 z-30 shadow-sm">
    <div class="container-site">
      <form method="GET" action="/search/" id="filters-form" class="flex flex-wrap items-center gap-2.5">
        <input type="hidden" name="area" value={area} />
        <div class="relative flex-1 min-w-[240px]">
          <svg class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-navy/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          <input
            type="text"
            name="q"
            value={q}
            placeholder="Leave blank to browse the map, or search a city/address/MLS® number (e.g. Toronto, X13567832)"
            class="w-full pl-10 pr-4 py-2.5 rounded-full text-sm bg-cream border border-gray-200 text-navy placeholder-navy/40 focus:border-gold focus:outline-none transition-colors"
          />
        </div>
        <div class="relative">
          <select name="minPrice" id="minPrice-select" class="appearance-none pl-4 pr-9 py-2 rounded-full text-sm font-medium bg-cream text-navy/70 border border-gray-200 hover:border-gold focus:border-gold focus:outline-none transition-colors cursor-pointer">
            <option value="">No Min</option>
            {priceSteps.map((p) => <option value={p} selected={minPrice === p}>{shortPrice(p)}</option>)}
          </select>
        </div>
        <span class="text-navy/30 text-sm">–</span>
        <div class="relative">
          <select name="maxPrice" id="maxPrice-select" class="appearance-none pl-4 pr-9 py-2 rounded-full text-sm font-medium bg-cream text-navy/70 border border-gray-200 hover:border-gold focus:border-gold focus:outline-none transition-colors cursor-pointer">
            <option value="">No Max</option>
            {priceSteps.map((p) => <option value={p} selected={maxPrice === p}>{shortPrice(p)}</option>)}
          </select>
        </div>
        <div class="relative">
          <select name="type" id="type-select" class="appearance-none pl-4 pr-9 py-2 rounded-full text-sm font-medium bg-cream text-navy/70 border border-gray-200 hover:border-gold focus:border-gold focus:outline-none transition-colors cursor-pointer">
            <option value="">Any Type</option>
            <option value="Detached" selected={propertyType === 'Detached'}>Detached</option>
            <option value="Semi" selected={propertyType === 'Semi'}>Semi-Detached</option>
            <option value="Townhouse" selected={propertyType === 'Townhouse'}>Townhouse</option>
            <option value="Condo" selected={propertyType === 'Condo'}>Condo / Apartment</option>
          </select>
        </div>
        <button type="submit" class="btn-primary !py-2.5 !px-6">Search</button>
      </form>

      {!q && (
        <div class="flex flex-wrap items-center gap-2 mt-4">
          <a
            href={areaUrl('')}
            data-area-tab
            data-bounds={JSON.stringify(allAreasBoundsForClient)}
            class={`text-xs font-semibold px-3.5 py-1.5 rounded-full transition-colors ${!area ? 'bg-navy text-white' : 'bg-cream text-navy/70 border border-gray-200 hover:border-gold'}`}
          >All London</a>
          {AREAS.map((a) => (
            <a
              href={areaUrl(a.slug)}
              data-area-tab
              data-bounds={JSON.stringify(areaBoundsJson[a.slug] ?? null)}
              class={`text-xs font-semibold px-3.5 py-1.5 rounded-full transition-colors ${area === a.slug ? 'bg-navy text-white' : 'bg-cream text-navy/70 border border-gray-200 hover:border-gold'}`}
            >{a.shortName}</a>
          ))}
        </div>
      )}

      {q ? (
        <p class="text-sm text-slate mt-3">
          {textResult?.totalMatching ?? 0} active listing{(textResult?.totalMatching ?? 0) !== 1 ? 's' : ''} matching "{q}"
        </p>
      ) : (
        <p id="results-count" class="text-sm text-slate mt-3">
          {browseResult?.capped
            ? `Showing ${browseCards.length} of ${browseResult.total.toLocaleString()} active listings in view — zoom in to narrow down`
            : `${browseResult?.total ?? 0} active listing${(browseResult?.total ?? 0) !== 1 ? 's' : ''} in view · all REALTORS®`}
        </p>
      )}
    </div>
  </section>

  <section class="py-12 bg-cream">
    <div class="container-site">
      {q ? (
        textCards.length === 0 ? (
          <div class="max-w-xl mx-auto text-center py-16">
            <div class="text-6xl mb-6">🏡</div>
            <h2 class="font-serif text-2xl text-navy mb-2">No listings found</h2>
            <p class="text-slate">Try a different city, address, or MLS® number, or widen your price range.</p>
          </div>
        ) : (
          <>
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
              {textCards.map((l) => (
                <article class="listing-card bg-white rounded-2xl shadow-card overflow-hidden hover:shadow-lg hover:-translate-y-0.5 transition-all border border-gray-100">
                  <div class="aspect-[4/3] bg-cream relative overflow-hidden">
                    {l.photoUrl ? (
                      <img src={l.photoUrl} alt={`${l.address}, ${l.city}`} class="w-full h-full object-cover" loading="lazy" />
                    ) : (
                      <div class="flex items-center justify-center h-full"><span class="text-5xl">🏡</span></div>
                    )}
                    {l.type && (
                      <div class="absolute top-2 right-2">
                        <span class="bg-navy/80 text-white text-xs font-medium px-2 py-0.5 rounded-full">{l.type}</span>
                      </div>
                    )}
                  </div>
                  <a href={l.detailHref} class="block p-3.5">
                    <div class="font-serif text-lg text-navy font-bold mb-0.5">{l.price}</div>
                    <p class="text-slate text-xs leading-snug mb-2 line-clamp-1">{l.address}{l.city ? `, ${l.city}` : ''}</p>
                    <div class="flex items-center gap-3 text-xs text-navy/70 border-t border-gray-100 pt-2">
                      {l.beds && <span>{l.beds} bed</span>}
                      {l.baths && <span>{l.baths} bath</span>}
                      {l.sqft && <span>{Number(l.sqft).toLocaleString()} sq ft</span>}
                    </div>
                    <p class="text-[10px] text-slate/50 mt-1.5">Courtesy of {l.brokerage}</p>
                  </a>
                  <div class="flex gap-2 px-3.5 pb-3.5">
                    <a href={l.detailHref} class="flex-1 bg-navy text-white text-xs font-semibold text-center py-2 rounded-lg hover:bg-navy/80 transition-colors">
                      View Full Details
                    </a>
                  </div>
                </article>
              ))}
            </div>

            {(textResult?.pageCount ?? 0) > 1 && (
              <div class="flex items-center justify-center gap-2 mt-10">
                {(textResult?.page ?? 1) > 1 && (
                  <a href={pageUrl((textResult?.page ?? 1) - 1)} class="px-4 py-2 rounded-full text-sm font-medium bg-white border border-gray-200 text-navy hover:border-gold transition-colors">Previous</a>
                )}
                <span class="text-sm text-slate px-2">Page {textResult?.page} of {textResult?.pageCount}</span>
                {(textResult?.page ?? 1) < (textResult?.pageCount ?? 1) && (
                  <a href={pageUrl((textResult?.page ?? 1) + 1)} class="px-4 py-2 rounded-full text-sm font-medium bg-white border border-gray-200 text-navy hover:border-gold transition-colors">Next</a>
                )}
              </div>
            )}
          </>
        )
      ) : (
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
          <div class="order-2 lg:order-1">
            <div id="grid-cards" class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {browseCards.length === 0 && (
                <div class="col-span-full max-w-xl mx-auto text-center py-16">
                  <div class="text-6xl mb-6">🏡</div>
                  <h2 class="font-serif text-2xl text-navy mb-2">No listings in this view</h2>
                  <p class="text-slate">Pan or zoom the map, or widen your price range.</p>
                </div>
              )}
              {browseCards.map((l) => (
                <article class="listing-card bg-white rounded-2xl shadow-card overflow-hidden hover:shadow-lg hover:-translate-y-0.5 transition-all border border-gray-100" data-mls={l.mls}>
                  <div class="aspect-[4/3] bg-cream relative overflow-hidden">
                    {l.photoUrl ? (
                      <img src={l.photoUrl} alt={`${l.address}, ${l.city}`} class="w-full h-full object-cover" loading="lazy" />
                    ) : (
                      <div class="flex items-center justify-center h-full"><span class="text-5xl">🏡</span></div>
                    )}
                    {l.type && (
                      <div class="absolute top-2 right-2">
                        <span class="bg-navy/80 text-white text-xs font-medium px-2 py-0.5 rounded-full">{l.type}</span>
                      </div>
                    )}
                  </div>
                  <a href={l.href} class="block p-3.5">
                    <div class="font-serif text-lg text-navy font-bold mb-0.5">{l.price}</div>
                    <p class="text-slate text-xs leading-snug mb-2 line-clamp-1">{l.address}{l.city ? `, ${l.city}` : ''}</p>
                    <div class="flex items-center gap-3 text-xs text-navy/70 border-t border-gray-100 pt-2">
                      {l.beds && <span>{l.beds} bed</span>}
                      {l.baths && <span>{l.baths} bath</span>}
                      {l.sqft && <span>{Number(l.sqft).toLocaleString()} sq ft</span>}
                    </div>
                    <p class="text-[10px] text-slate/50 mt-1.5">Courtesy of {l.brokerage}</p>
                  </a>
                  <div class="flex gap-2 px-3.5 pb-3.5">
                    <a href={l.href} class="flex-1 bg-navy text-white text-xs font-semibold text-center py-2 rounded-lg hover:bg-navy/80 transition-colors">
                      View Full Details
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </div>

          <div class="order-1 lg:order-2 lg:sticky lg:top-24">
            <div class="rounded-2xl overflow-hidden shadow-card border border-gray-100">
              <div id="live-map" style="height: 600px"></div>
            </div>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Required MLS/REALTOR trademark statement — every page of a National Pool Website must display this -->
  <section class="py-6 bg-white border-t border-gray-100">
    <div class="container-site">
      <p class="text-xs text-slate/60 text-center max-w-3xl mx-auto">
        REALTOR®, REALTORS®, and the REALTOR® logo are certification marks owned by REALTOR® Canada Inc. and licensed exclusively to The Canadian Real Estate Association (CREA). MLS® and the MLS® logo are owned by CREA. This website is operated by Justin Skrypnyk, Real Estate Broker, Sutton Group Chapman Realty Inc., Brokerage, a member of CREA. See our <a href="/terms-of-use/" class="text-gold hover:underline">Terms of Use</a>.
      </p>
    </div>
  </section>
</Base>

<!-- Terms of Use consent banner — enhanced browse-wrap per CREA DDF Rule 6(d) -->
<div id="terms-banner" class="hidden fixed bottom-0 inset-x-0 z-50 bg-navy text-white shadow-2xl">
  <div class="container-site py-4 flex flex-col sm:flex-row items-center gap-4">
    <p class="text-sm text-white/80 flex-1">
      By using this Ontario-wide listing search, you agree to our <a href="/terms-of-use/" target="_blank" class="text-gold hover:underline">Terms of Use</a>, including the CREA/REALTOR® trademark notices and permitted-use restrictions.
    </p>
    <button id="terms-accept" type="button" class="btn-primary !py-2 !px-6 whitespace-nowrap shrink-0">Got It</button>
  </div>
</div>

<script>
  const KEY = 'terms_of_use_ack_v1';
  const banner = document.getElementById('terms-banner');
  if (banner && !localStorage.getItem(KEY)) {
    banner.classList.remove('hidden');
  }
  document.getElementById('terms-accept')?.addEventListener('click', () => {
    localStorage.setItem(KEY, '1');
    banner?.classList.add('hidden');
  });
</script>

{!q && (
  <script define:vars={{ initialBounds, initialCards: browseCards, allAreasBounds: allAreasBoundsForClient }}>
    function esc(s) {
      const d = document.createElement('div');
      d.textContent = s ?? '';
      return d.innerHTML;
    }

    function shortPrice(n) {
      if (n >= 1000000) return `$${(n / 1000000).toFixed(n % 1000000 === 0 ? 0 : 1)}M`;
      if (n >= 1000) return `$${Math.round(n / 1000)}K`;
      return `$${n}`;
    }

    function cardHtml(l) {
      return `
        <article class="listing-card bg-white rounded-2xl shadow-card overflow-hidden hover:shadow-lg hover:-translate-y-0.5 transition-all border border-gray-100" data-mls="${esc(l.mls)}">
          <div class="aspect-[4/3] bg-cream relative overflow-hidden">
            ${l.photoUrl
              ? `<img src="${esc(l.photoUrl)}" alt="" class="w-full h-full object-cover" loading="lazy" />`
              : `<div class="flex items-center justify-center h-full"><span class="text-5xl">🏡</span></div>`}
            ${l.type ? `<div class="absolute top-2 right-2"><span class="bg-navy/80 text-white text-xs font-medium px-2 py-0.5 rounded-full">${esc(l.type)}</span></div>` : ''}
          </div>
          <a href="${l.href}" class="block p-3.5">
            <div class="font-serif text-lg text-navy font-bold mb-0.5">${esc(l.price)}</div>
            <p class="text-slate text-xs leading-snug mb-2 line-clamp-1">${esc(l.address)}${l.city ? `, ${esc(l.city)}` : ''}</p>
            <div class="flex items-center gap-3 text-xs text-navy/70 border-t border-gray-100 pt-2">
              ${l.beds ? `<span>${esc(l.beds)} bed</span>` : ''}
              ${l.baths ? `<span>${esc(l.baths)} bath</span>` : ''}
              ${l.sqft ? `<span>${Number(l.sqft).toLocaleString()} sq ft</span>` : ''}
            </div>
            <p class="text-[10px] text-slate/50 mt-1.5">Courtesy of ${esc(l.brokerage)}</p>
          </a>
          <div class="flex gap-2 px-3.5 pb-3.5">
            <a href="${l.href}" class="flex-1 bg-navy text-white text-xs font-semibold text-center py-2 rounded-lg hover:bg-navy/80 transition-colors">View Full Details</a>
          </div>
        </article>
      `;
    }

    function popupHtml(l) {
      return `
        <a href="${l.href}" style="display:block;width:240px;text-decoration:none;color:inherit;font-family:Inter,sans-serif;">
          <div style="width:100%;height:130px;border-radius:8px;overflow:hidden;background:#f0f9f6;margin-bottom:8px;">
            ${l.photoUrl
              ? `<img src="${esc(l.photoUrl)}" alt="" style="width:100%;height:100%;object-fit:cover;" />`
              : `<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:32px;">🏡</div>`}
          </div>
          <div style="display:flex;align-items:center;justify-content:between;gap:6px;">
            <span style="font-weight:800;font-size:16px;color:#0c2340;">${esc(l.price)}</span>
            <span style="margin-left:auto;background:#10b981;color:#0c2340;font-size:10px;font-weight:700;padding:2px 8px;border-radius:999px;">For Sale</span>
          </div>
          <div style="font-size:12.5px;color:#334155;margin:3px 0 6px;line-height:1.3;">${esc(l.address)}${l.city ? `, ${esc(l.city)}` : ''}</div>
          <div style="display:flex;gap:10px;font-size:11.5px;color:#0c2340;font-weight:600;margin-bottom:6px;">
            ${l.beds ? `<span>🛏 ${esc(l.beds)}</span>` : ''}
            ${l.baths ? `<span>🛁 ${esc(l.baths)}</span>` : ''}
            ${l.sqft ? `<span>${Number(l.sqft).toLocaleString()} ft²</span>` : ''}
          </div>
          <div style="font-size:10px;color:#94a3b8;border-top:1px solid #eee;padding-top:5px;">${esc(l.mls)}, ${esc(l.brokerage)}</div>
        </a>
      `;
    }

    function loadStylesheet(href, integrity) {
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = href;
      if (integrity) link.integrity = integrity;
      link.crossOrigin = 'anonymous';
      document.head.appendChild(link);
    }

    function loadScript(src, integrity) {
      return new Promise((resolve) => {
        const script = document.createElement('script');
        script.src = src;
        if (integrity) script.integrity = integrity;
        script.crossOrigin = 'anonymous';
        script.onload = resolve;
        document.body.appendChild(script);
      });
    }

    async function loadLeaflet() {
      if (!window.L) {
        loadStylesheet('https://unpkg.com/leaflet@1.9.4/dist/leaflet.css', 'sha384-sHL9NAb7lN7rfvG5lfHpm643Xkcjzp4jFvuavGOndn6pjVqS6ny56CAt3nsEVT4H');
        await loadScript('https://unpkg.com/leaflet@1.9.4/dist/leaflet.js', 'sha384-cxOPjt7s7Iz04uaHJceBmS+qpjv2JkIHNVcuOrM+YHwZOmJGBXI00mdUXEq65HTH');
      }
      if (!window.L.markerClusterGroup) {
        loadStylesheet('https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css', null);
        loadStylesheet('https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css', null);
        await loadScript('https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js', null);
      }
    }

    async function initLiveMapSearch() {
      await loadLeaflet();

      const mapEl = document.getElementById('live-map');
      const gridEl = document.getElementById('grid-cards');
      const countEl = document.getElementById('results-count');
      if (!mapEl) return;

      const map = L.map(mapEl, { scrollWheelZoom: true });
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 19,
      }).addTo(map);
      map.fitBounds([[initialBounds.south, initialBounds.west], [initialBounds.north, initialBounds.east]]);

      const priceIcon = (label) => L.divIcon({
        html: `<div style="display:inline-block;background:#10b981;color:#0c2340;font:700 12px Inter,sans-serif;padding:5px 10px;border-radius:999px;box-shadow:0 2px 8px rgba(12,35,64,.35);white-space:nowrap;border:2px solid #fff;">${label}</div>`,
        className: '',
        iconSize: [0, 0],
        iconAnchor: [0, 12],
      });

      let clusterLayer = L.markerClusterGroup().addTo(map);
      let highlightedCard = null;
      let highlightTimeout = null;

      function highlightListingCard(mls) {
        if (!mls) return;
        const card = gridEl?.querySelector(`[data-mls="${window.CSS && CSS.escape ? CSS.escape(mls) : mls}"]`);
        if (!card) return;
        if (highlightedCard && highlightedCard !== card) {
          highlightedCard.style.outline = '';
          highlightedCard.style.outlineOffset = '';
        }
        clearTimeout(highlightTimeout);
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        card.style.outline = '3px solid #10b981';
        card.style.outlineOffset = '3px';
        highlightedCard = card;
        highlightTimeout = setTimeout(() => {
          card.style.outline = '';
          card.style.outlineOffset = '';
          highlightedCard = null;
        }, 2500);
      }

      function renderListings(listings, total, capped) {
        clusterLayer.clearLayers();
        const markers = listings
          .filter((l) => l.lat && l.lng)
          .map((l) => {
            const marker = L.marker([l.lat, l.lng], { icon: priceIcon(shortPrice(l.rawPrice)) }).bindPopup(popupHtml(l), { maxWidth: 260 });
            marker.on('click', () => highlightListingCard(l.mls));
            return marker;
          });
        clusterLayer.addLayers(markers);

        if (gridEl) {
          gridEl.innerHTML = listings.length
            ? listings.map(cardHtml).join('')
            : `<div class="col-span-full max-w-xl mx-auto text-center py-16"><div class="text-6xl mb-6">🏡</div><h2 class="font-serif text-2xl text-navy mb-2">No listings in this view</h2><p class="text-slate">Pan or zoom the map, or widen your price range.</p></div>`;
        }
        if (countEl) {
          countEl.textContent = capped
            ? `Showing ${listings.length} of ${total.toLocaleString()} active listings in view — zoom in to narrow down`
            : `${total} active listing${total !== 1 ? 's' : ''} in view · all REALTORS®`;
        }
      }

      renderListings(initialCards, initialCards.length, false);

      function currentFilters() {
        const form = document.getElementById('filters-form');
        const data = new FormData(form);
        return {
          minPrice: data.get('minPrice') || '',
          maxPrice: data.get('maxPrice') || '',
          type: data.get('type') || '',
        };
      }

      let fetchToken = 0;
      let fetchTimeout = null;
      async function fetchForCurrentView() {
        const myToken = ++fetchToken;
        const bounds = map.getBounds();
        const { minPrice, maxPrice, type } = currentFilters();
        const qs = new URLSearchParams({
          north: String(bounds.getNorth()),
          south: String(bounds.getSouth()),
          east: String(bounds.getEast()),
          west: String(bounds.getWest()),
        });
        if (minPrice) qs.set('minPrice', minPrice);
        if (maxPrice) qs.set('maxPrice', maxPrice);
        if (type) qs.set('type', type);

        try {
          const res = await fetch(`/api/map-listings.json?${qs.toString()}`);
          if (!res.ok || myToken !== fetchToken) return;
          const data = await res.json();
          if (myToken !== fetchToken) return;
          renderListings(data.listings, data.total, data.capped);
        } catch {
          // Network hiccup — leave the previously rendered view as-is.
        }
      }

      map.on('moveend', () => {
        clearTimeout(fetchTimeout);
        fetchTimeout = setTimeout(fetchForCurrentView, 400);
      });

      // Area tabs move the map instead of reloading the page; filters
      // (price/type) re-trigger a fetch for the current view instead of a
      // full-page form submit. Both still work as plain links/a form submit
      // with JS disabled.
      document.querySelectorAll('[data-area-tab]').forEach((tab) => {
        tab.addEventListener('click', (e) => {
          const raw = tab.getAttribute('data-bounds');
          const bounds = raw ? JSON.parse(raw) : null;
          if (!bounds) return; // no known bounds for this tab — let it navigate normally
          e.preventDefault();
          document.querySelectorAll('[data-area-tab]').forEach((t) => {
            t.classList.remove('bg-navy', 'text-white');
            t.classList.add('bg-cream', 'text-navy/70', 'border', 'border-gray-200');
          });
          tab.classList.add('bg-navy', 'text-white');
          tab.classList.remove('bg-cream', 'text-navy/70', 'border', 'border-gray-200');
          map.fitBounds([[bounds.south, bounds.west], [bounds.north, bounds.east]]);
        });
      });

      const filtersForm = document.getElementById('filters-form');
      filtersForm?.addEventListener('submit', (e) => {
        if (document.querySelector('input[name="q"]').value.trim()) return; // let text search submit normally
        e.preventDefault();
        fetchForCurrentView();
      });
    }

    initLiveMapSearch();
  </script>
)}
