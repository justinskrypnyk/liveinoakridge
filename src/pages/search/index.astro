<!-- Collapsible filter block — the sticky bar eats a lot of screen space,
     especially on mobile, so it can be tucked away leaving just the area
     tabs and results count visible. Remembered across visits. -->
<script>
  const FILTERS_COLLAPSED_KEY = 'search_filters_collapsed';
  const filtersToggle = document.getElementById('filters-toggle');
  const filtersCollapsible = document.getElementById('filters-collapsible');
  const filtersToggleIcon = document.getElementById('filters-toggle-icon');

  function setFiltersCollapsed(collapsed) {
    filtersCollapsible?.classList.toggle('hidden', collapsed);
    filtersToggleIcon?.classList.toggle('-rotate-90', collapsed);
    filtersToggle?.setAttribute('aria-expanded', String(!collapsed));
  }

  setFiltersCollapsed(localStorage.getItem(FILTERS_COLLAPSED_KEY) === '1');

  filtersToggle?.addEventListener('click', () => {
    const collapsed = !filtersCollapsible?.classList.contains('hidden');
    setFiltersCollapsed(collapsed);
    localStorage.setItem(FILTERS_COLLAPSED_KEY, collapsed ? '1' : '0');
  });

  // The map's sticky top offset has to sit right below the filter bar above
  // it, but that bar's height isn't fixed — it changes when filters
  // collapse/expand, when the area-tab pills wrap to a second line at
  // narrower desktop widths, or if its content changes for any other
  // reason. A hardcoded offset drifts out of sync with any of that and the
  // map (plus any open marker popup) ends up rendering underneath the bar.
  // ResizeObserver keeps it correct regardless of what caused the resize.
  const filterBar = document.getElementById('search-filter-bar');
  const mapStickyWrap = document.getElementById('map-sticky-wrap');
  if (filterBar && mapStickyWrap && window.ResizeObserver) {
    const syncMapOffset = () => {
      const barTop = parseFloat(getComputedStyle(filterBar).top) || 0;
      mapStickyWrap.style.top = `${barTop + filterBar.offsetHeight}px`;
    };
    new ResizeObserver(syncMapOffset).observe(filterBar);
    syncMapOffset();
  }
</script>

{!q && (
  <script define:vars={{ initialBounds, initialCards: browseCards, allAreasBounds: allAreasBoundsForClient }}>
    // `define:vars` scripts are inline, non-module scripts (Astro can't run
    // them through Vite), so they can't `import` the shared helpers in
    // src/lib/save-listing-client.ts — duplicated here instead of risking a
    // cross-script load-order race with SaveListingModal.astro's module
    // script. Both read/write the same sessionStorage key and the same
    // data-save-heart/.heart-outline/.heart-filled contract, so state still
    // stays in sync everywhere on the page.
    function syncHeartButtons(root) {
      let saved;
      try {
        saved = new Set(JSON.parse(sessionStorage.getItem('saved_listings_v1') || '[]'));
      } catch {
        saved = new Set();
      }
      (root || document).querySelectorAll('[data-save-heart]').forEach((btn) => {
        const filled = saved.has(btn.getAttribute('data-mls') || '');
        btn.classList.toggle('is-saved', filled);
        btn.setAttribute('aria-pressed', String(filled));
        btn.querySelector('.heart-outline')?.classList.toggle('hidden', filled);
        btn.querySelector('.heart-filled')?.classList.toggle('hidden', !filled);
      });
    }

    function esc(s) {
      const d = document.createElement('div');
      d.textContent = s ?? '';
      return d.innerHTML;
    }

    function shortPrice(n) {
      if (n >= 1000000) return `$${(n / 1000000).toFixed(n % 1000000 === 0 ? 0 : 1)}M`;
      if (n >= 1000) return `$${Math.round(n / 1000)}K`;
      return `$${n}`;
    }

    // Matches SaveHeartButton.astro's markup exactly — save-listing-client.ts's
    // syncHeartButtons()/setHeartVisual() and the delegated click handler in
    // SaveListingModal.astro key off these same classes/data attributes
    // regardless of whether a heart came from server-rendered HTML, this
    // client re-render, or a Leaflet popup.
    function heartHtml(mls, address, extraClass) {
      return `
        <button type="button" data-save-heart data-mls="${esc(mls)}" data-address="${esc(address)}" aria-label="Save this listing" aria-pressed="false" class="save-heart-btn w-8 h-8 rounded-full bg-white/90 shadow-md flex items-center justify-center hover:scale-110 transition-transform ${extraClass || ''}">
          <svg class="heart-outline w-4 h-4 text-navy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-6.716-4.35-9.428-8.06C.94 10.42 1.2 6.9 3.808 5.06 6.06 3.47 9 4.08 12 7.2c3-3.12 5.94-3.73 8.192-2.14 2.608 1.84 2.868 5.36 1.236 7.88C18.716 16.65 12 21 12 21z"/></svg>
          <svg class="heart-filled w-4 h-4 text-rose-500 hidden" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21s-6.716-4.35-9.428-8.06C.94 10.42 1.2 6.9 3.808 5.06 6.06 3.47 9 4.08 12 7.2c3-3.12 5.94-3.73 8.192-2.14 2.608 1.84 2.868 5.36 1.236 7.88C18.716 16.65 12 21 12 21z"/></svg>
        </button>
      `;
    }

    function cardHtml(l) {
      const address = `${l.address}${l.city ? `, ${l.city}` : ''}`;
      return `
        <article class="listing-card bg-white rounded-2xl shadow-card overflow-hidden hover:shadow-lg hover:-translate-y-0.5 transition-all border border-gray-100" data-mls="${esc(l.mls)}">
          <div class="aspect-[4/3] bg-cream relative overflow-hidden">
            ${l.photoUrl
              ? `<img src="${esc(l.photoUrl)}" alt="${esc(l.photoAlt)}" class="w-full h-full object-contain" loading="lazy" />`
              : `<div class="flex items-center justify-center h-full"><span class="text-5xl">🏡</span></div>`}
            ${l.isOwn ? `<div class="absolute top-2 left-2"><span class="bg-gold text-navy text-xs font-bold px-2 py-0.5 rounded-full">In-House Listing</span></div>` : ''}
            ${l.type ? `<div class="absolute top-2 right-2"><span class="bg-navy/80 text-white text-xs font-medium px-2 py-0.5 rounded-full">${esc(l.type)}</span></div>` : ''}
            ${heartHtml(l.mls, address, 'absolute bottom-2 right-2')}
          </div>
          <div class="block p-3.5 cursor-pointer">
            <div class="font-serif text-lg text-navy font-bold mb-0.5">${esc(l.price)}</div>
            <p class="text-slate text-xs leading-snug mb-2 line-clamp-1">${esc(l.address)}${l.city ? `, ${esc(l.city)}` : ''}</p>
            <div class="flex items-center gap-3 text-xs text-navy/70 border-t border-gray-100 pt-2">
              ${l.beds ? `<span>${esc(l.beds)} bed</span>` : ''}
              ${l.baths ? `<span>${esc(l.baths)} bath</span>` : ''}
              ${l.sqft ? `<span>${Number(l.sqft).toLocaleString()} sq ft</span>` : ''}
            </div>
            <p class="text-[10px] text-slate/50 mt-1.5">Courtesy of ${esc(l.brokerage)}</p>
          </div>
          <div class="flex gap-2 px-3.5 pb-3.5">
            <a href="${l.href}" class="flex-1 bg-navy text-white text-xs font-semibold text-center py-2 rounded-lg hover:bg-navy/80 transition-colors">View Full Details</a>
          </div>
        </article>
      `;
    }

    function popupHtml(l) {
      const address = `${l.address}${l.city ? `, ${l.city}` : ''}`;
      return `
        <div style="width:240px;padding-top:18px;font-family:Inter,sans-serif;">
          <div style="width:100%;height:130px;border-radius:8px;overflow:hidden;background:#f0f9f6;margin-bottom:8px;position:relative;">
            ${l.photoUrl
              ? `<img src="${esc(l.photoUrl)}" alt="${esc(l.photoAlt)}" style="width:100%;height:100%;object-fit:contain;" />`
              : `<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:32px;">🏡</div>`}
            <div style="position:absolute;bottom:6px;right:6px;">${heartHtml(l.mls, address)}</div>
          </div>
          <a href="${l.href}" style="display:block;text-decoration:none;color:inherit;">
            <div style="display:flex;align-items:center;justify-content:between;gap:6px;">
              <span style="font-weight:800;font-size:16px;color:#0c2340;">${esc(l.price)}</span>
              <span style="margin-left:auto;background:#10b981;color:#0c2340;font-size:10px;font-weight:700;padding:2px 8px;border-radius:999px;">${l.isOwn ? "In-House Listing" : 'For Sale'}</span>
            </div>
            <div style="font-size:12.5px;color:#334155;margin:3px 0 6px;line-height:1.3;">${esc(l.address)}${l.city ? `, ${esc(l.city)}` : ''}</div>
            <div style="display:flex;gap:10px;font-size:11.5px;color:#0c2340;font-weight:600;margin-bottom:6px;">
              ${l.beds ? `<span>🛏 ${esc(l.beds)}</span>` : ''}
              ${l.baths ? `<span>🛁 ${esc(l.baths)}</span>` : ''}
              ${l.sqft ? `<span>${Number(l.sqft).toLocaleString()} ft²</span>` : ''}
            </div>
            <div style="font-size:10px;color:#94a3b8;border-top:1px solid #eee;padding-top:5px;">${esc(l.mls)}, ${esc(l.brokerage)}</div>
          </a>
        </div>
      `;
    }

    function loadStylesheet(href, integrity) {
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = href;
      if (integrity) link.integrity = integrity;
      link.crossOrigin = 'anonymous';
      document.head.appendChild(link);
    }

    function loadScript(src, integrity) {
      return new Promise((resolve) => {
        const script = document.createElement('script');
        script.src = src;
        if (integrity) script.integrity = integrity;
        script.crossOrigin = 'anonymous';
        script.onload = resolve;
        document.body.appendChild(script);
      });
    }

    async function loadLeaflet() {
      if (!window.L) {
        loadStylesheet('https://unpkg.com/leaflet@1.9.4/dist/leaflet.css', 'sha384-sHL9NAb7lN7rfvG5lfHpm643Xkcjzp4jFvuavGOndn6pjVqS6ny56CAt3nsEVT4H');
        await loadScript('https://unpkg.com/leaflet@1.9.4/dist/leaflet.js', 'sha384-cxOPjt7s7Iz04uaHJceBmS+qpjv2JkIHNVcuOrM+YHwZOmJGBXI00mdUXEq65HTH');
      }
      if (!window.L.markerClusterGroup) {
        loadStylesheet('https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css', null);
        loadStylesheet('https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css', null);
        await loadScript('https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js', null);
      }
    }

    async function initLiveMapSearch() {
      await loadLeaflet();

      const mapEl = document.getElementById('live-map');
      const gridEl = document.getElementById('grid-cards');
      const countEl = document.getElementById('results-count');
      if (!mapEl) return;

      const map = L.map(mapEl, { scrollWheelZoom: true });
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 19,
      }).addTo(map);
      map.fitBounds([[initialBounds.south, initialBounds.west], [initialBounds.north, initialBounds.east]]);

      const priceIcon = (label) => L.divIcon({
        html: `<div style="display:inline-block;background:#10b981;color:#0c2340;font:700 12px Inter,sans-serif;padding:5px 10px;border-radius:999px;box-shadow:0 2px 8px rgba(12,35,64,.35);white-space:nowrap;border:2px solid #fff;">${label}</div>`,
        className: '',
        iconSize: [0, 0],
        iconAnchor: [0, 12],
      });

      let clusterLayer = L.markerClusterGroup().addTo(map);
      let highlightedCard = null;
      let highlightTimeout = null;
      let markersByMls = new Map();

      function highlightListingCard(mls) {
        if (!mls) return;
        const card = gridEl?.querySelector(`[data-mls="${window.CSS && CSS.escape ? CSS.escape(mls) : mls}"]`);
        if (!card) return;
        if (highlightedCard && highlightedCard !== card) {
          highlightedCard.style.outline = '';
          highlightedCard.style.outlineOffset = '';
        }
        clearTimeout(highlightTimeout);
        // Deliberately no scrollIntoView here: with the default "All London"
        // view capped at 300 listings sorted Newest First, a card can be
        // ~150 rows / 60,000px down the page, and force-scrolling the whole
        // page to it (rather than just the map's own popup, which already
        // shows the photo/price/address) reads as randomly jumping to the
        // footer. Just highlight the card if it happens to already be on
        // screen.
        card.style.outline = '3px solid #10b981';
        card.style.outlineOffset = '3px';
        highlightedCard = card;
        highlightTimeout = setTimeout(() => {
          card.style.outline = '';
          card.style.outlineOffset = '';
          highlightedCard = null;
        }, 2500);
      }

      // `skipGridRender` matters for the very first call: #grid-cards is
      // already server-rendered with this same `initialCards` data (see the
      // browseCards.map() block above), complete with the eager/lazy loading
      // hints on its images. Re-writing it here — after Leaflet has finished
      // loading from unpkg.com — would both be redundant and would strip
      // those hints from the LCP-candidate card image. Panning/filtering
      // (which do need a real re-render) call this with skipGridRender unset.
      function renderListings(listings, total, capped, { skipGridRender = false } = {}) {
        clusterLayer.clearLayers();
        markersByMls = new Map();
        const markers = listings
          .filter((l) => l.lat && l.lng)
          .map((l) => {
            const marker = L.marker([l.lat, l.lng], { icon: priceIcon(shortPrice(l.rawPrice)) }).bindPopup(popupHtml(l), { maxWidth: 260, autoPanPadding: [24, 40] });
            marker.on('click', () => highlightListingCard(l.mls));
            marker.on('popupopen', (e) => syncHeartButtons(e.popup.getElement()));
            if (l.mls) markersByMls.set(l.mls, marker);
            return marker;
          });
        clusterLayer.addLayers(markers);

        if (gridEl && !skipGridRender) {
          gridEl.innerHTML = listings.length
            ? listings.map(cardHtml).join('')
            : `<div class="col-span-full max-w-xl mx-auto text-center py-16"><div class="text-6xl mb-6">🏡</div><h2 class="font-serif text-2xl text-navy mb-2">No listings in this view</h2><p class="text-slate">Pan or zoom the map, or widen your price range.</p></div>`;
          syncHeartButtons(gridEl);
        }
        if (countEl) {
          countEl.textContent = capped
            ? `Showing ${listings.length} of ${total.toLocaleString()} active listings in view — zoom in to narrow down`
            : `${total} active listing${total !== 1 ? 's' : ''} in view · all REALTORS®`;
        }
      }

      renderListings(initialCards, initialCards.length, false, { skipGridRender: true });

      // Click-to-map: clicking a card body (anywhere but the heart or "View
      // Full Details") pans/zooms the live map to that listing's pin and
      // opens its popup — mirrors what clicking the pin itself does, in
      // reverse. Every browse card's mls is guaranteed to have a marker in
      // markersByMls, since cards and markers are rendered from the exact
      // same `listings` array on every fetch.
      function focusListing(mls) {
        const marker = markersByMls.get(mls);
        if (!marker) return;
        const targetZoom = Math.max(map.getZoom(), 15);
        clearTimeout(fetchTimeout);
        map.once('moveend', async () => {
          await fetchForCurrentView();
          markersByMls.get(mls)?.openPopup();
        });
        map.flyTo(marker.getLatLng(), targetZoom, { duration: 0.8 });
      }

      gridEl?.addEventListener('click', (e) => {
        if (e.target.closest('[data-save-heart]')) return;
        if (e.target.closest('a[href]')) return;
        const card = e.target.closest('.listing-card');
        const mls = card?.getAttribute('data-mls');
        if (!mls) return;
        focusListing(mls);
        // On mobile the map sits stacked above the grid rather than beside
        // it (see the order-1/order-2 classes on these two columns) — bring
        // it into view since the user is likely scrolled down into the list.
        if (!window.matchMedia('(min-width: 1024px)').matches) {
          mapEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });

      function currentFilters() {
        const form = document.getElementById('filters-form');
        // FormData(form) includes elements associated via form="filters-form"
        // even though they're not DOM descendants of the <form> — standard
        // behaviour, lets the More Filters panel live anywhere in the DOM
        // (needed for the fixed-position mobile drawer) while still counting
        // as one form.
        const data = new FormData(form);
        return {
          minPrice: data.get('minPrice') || '',
          maxPrice: data.get('maxPrice') || '',
          types: data.get('types') || '',
          minBeds: data.get('minBeds') || '',
          minBaths: data.get('minBaths') || '',
          minParking: data.get('minParking') || '',
          minSqft: data.get('minSqft') || '',
          maxSqft: data.get('maxSqft') || '',
          days: data.get('days') || '',
          keyword: (data.get('keyword') || '').trim(),
          sort: data.get('sort') || '',
        };
      }

      function updateMoreFiltersBadge() {
        const f = currentFilters();
        const count = [f.minBeds, f.minBaths, f.minParking, f.minSqft, f.maxSqft, f.days, f.keyword].filter(Boolean).length;
        const badge = document.getElementById('more-filters-count');
        if (!badge) return;
        if (count > 0) {
          badge.textContent = String(count);
          badge.classList.remove('hidden');
          badge.classList.add('flex');
        } else {
          badge.classList.add('hidden');
          badge.classList.remove('flex');
        }
      }
      updateMoreFiltersBadge();

      let fetchToken = 0;
      let fetchTimeout = null;
      async function fetchForCurrentView() {
        updateMoreFiltersBadge();
        const myToken = ++fetchToken;
        const bounds = map.getBounds();
        const { minPrice, maxPrice, types, minBeds, minBaths, minParking, minSqft, maxSqft, days, keyword, sort } = currentFilters();
        const qs = new URLSearchParams({
          north: String(bounds.getNorth()),
          south: String(bounds.getSouth()),
          east: String(bounds.getEast()),
          west: String(bounds.getWest()),
        });
        if (minPrice) qs.set('minPrice', minPrice);
        if (maxPrice) qs.set('maxPrice', maxPrice);
        if (types) qs.set('types', types);
        if (minBeds) qs.set('minBeds', minBeds);
        if (minBaths) qs.set('minBaths', minBaths);
        if (minParking) qs.set('minParking', minParking);
        if (minSqft) qs.set('minSqft', minSqft);
        if (maxSqft) qs.set('maxSqft', maxSqft);
        if (days) qs.set('days', days);
        if (keyword) qs.set('keyword', keyword);
        if (sort) qs.set('sort', sort);

        try {
          const res = await fetch(`/api/map-listings.json?${qs.toString()}`);
          if (!res.ok || myToken !== fetchToken) return;
          const data = await res.json();
          if (myToken !== fetchToken) return;
          renderListings(data.listings, data.total, data.capped);
        } catch {
          // Network hiccup — leave the previously rendered view as-is.
        }
      }

      map.on('moveend', () => {
        clearTimeout(fetchTimeout);
        fetchTimeout = setTimeout(fetchForCurrentView, 400);
      });

      // Area tabs move the map instead of reloading the page; filters
      // (price/type) re-trigger a fetch for the current view instead of a
      // full-page form submit. Both still work as plain links/a form submit
      // with JS disabled.
      document.querySelectorAll('[data-area-tab]').forEach((tab) => {
        tab.addEventListener('click', (e) => {
          const raw = tab.getAttribute('data-bounds');
          const bounds = raw ? JSON.parse(raw) : null;
          if (!bounds) return; // no known bounds for this tab — let it navigate normally
          e.preventDefault();
          document.querySelectorAll('[data-area-tab]').forEach((t) => {
            t.classList.remove('bg-navy', 'text-white');
            t.classList.add('bg-cream', 'text-navy/70', 'border', 'border-gray-200');
          });
          tab.classList.add('bg-navy', 'text-white');
          tab.classList.remove('bg-cream', 'text-navy/70', 'border', 'border-gray-200');
          map.fitBounds([[bounds.south, bounds.west], [bounds.north, bounds.east]]);
        });
      });

      const filtersForm = document.getElementById('filters-form');
      filtersForm?.addEventListener('submit', (e) => {
        if (document.querySelector('input[name="q"]').value.trim()) return; // let text search submit normally
        e.preventDefault();
        closeMoreFilters();
        fetchForCurrentView();
      });

      // Property Type: a checkbox multi-select dropdown (same pattern as
      // /sold-map/'s), writing into a hidden `types` form field so plain
      // form submission (the text-search path) and the JS-driven map fetch
      // (currentFilters() -> FormData) both pick up the same value.
      const typeToggle = document.getElementById('type-toggle');
      const typePanel = document.getElementById('type-panel');
      const typeBackdrop = document.getElementById('type-backdrop');
      const typeAllCheckbox = document.getElementById('type-all');
      const typeOptionCheckboxes = Array.from(document.querySelectorAll('.type-option'));
      const typeToggleLabel = document.getElementById('type-toggle-label');
      const typesHiddenInput = document.getElementById('types-hidden-input');
      let selectedTypes = (typesHiddenInput?.value || '').split(',').filter(Boolean);

      function openTypePanel() {
        typePanel?.classList.remove('hidden');
        typeBackdrop?.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
      function closeTypePanel() {
        typePanel?.classList.add('hidden');
        typeBackdrop?.classList.add('hidden');
        document.body.style.overflow = '';
      }
      typeToggle?.addEventListener('click', openTypePanel);
      typeBackdrop?.addEventListener('click', closeTypePanel);

      typeAllCheckbox?.addEventListener('change', () => {
        if (typeAllCheckbox.checked) typeOptionCheckboxes.forEach((c) => { c.checked = false; });
      });
      typeOptionCheckboxes.forEach((c) => {
        c.addEventListener('change', () => {
          if (c.checked) typeAllCheckbox.checked = false;
          const anyChecked = typeOptionCheckboxes.some((o) => o.checked);
          if (!anyChecked) typeAllCheckbox.checked = true;
        });
      });

      document.getElementById('type-cancel')?.addEventListener('click', () => {
        typeOptionCheckboxes.forEach((c) => { c.checked = selectedTypes.includes(c.value); });
        typeAllCheckbox.checked = selectedTypes.length === 0;
        closeTypePanel();
      });
      document.getElementById('type-save')?.addEventListener('click', () => {
        selectedTypes = typeOptionCheckboxes.filter((c) => c.checked).map((c) => c.value);
        if (typesHiddenInput) typesHiddenInput.value = selectedTypes.join(',');
        if (typeToggleLabel) {
          typeToggleLabel.textContent = selectedTypes.length === 0
            ? 'Any Type'
            : selectedTypes.length === 1
              ? document.querySelector(`.type-option[value="${selectedTypes[0]}"]`)?.parentElement?.textContent.trim()
              : `${selectedTypes.length} Types`;
        }
        closeTypePanel();
        fetchForCurrentView();
      });
      document.addEventListener('click', (e) => {
        if (typePanel?.classList.contains('hidden')) return;
        if (typePanel.contains(e.target) || typeToggle?.contains(e.target)) return;
        closeTypePanel();
      });

      // More Filters: an inline dropdown on desktop, a bottom-sheet drawer
      // (with backdrop) on mobile — same panel, positioned differently via
      // the lg: breakpoint classes already on it in the markup.
      const moreFiltersToggle = document.getElementById('more-filters-toggle');
      const moreFiltersPanel = document.getElementById('more-filters-panel');
      const moreFiltersBackdrop = document.getElementById('more-filters-backdrop');
      const moreFiltersClose = document.getElementById('more-filters-close');

      function openMoreFilters() {
        moreFiltersPanel?.classList.remove('hidden');
        moreFiltersBackdrop?.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
      function closeMoreFilters() {
        moreFiltersPanel?.classList.add('hidden');
        moreFiltersBackdrop?.classList.add('hidden');
        document.body.style.overflow = '';
      }
      moreFiltersToggle?.addEventListener('click', () => {
        if (moreFiltersPanel?.classList.contains('hidden')) openMoreFilters();
        else closeMoreFilters();
      });
      moreFiltersClose?.addEventListener('click', closeMoreFilters);
      moreFiltersBackdrop?.addEventListener('click', closeMoreFilters);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeMoreFilters();
      });
      // Desktop dropdown: clicking outside it closes it too (the backdrop
      // div is lg:hidden, so this covers the case the backdrop doesn't).
      document.addEventListener('click', (e) => {
        if (moreFiltersPanel?.classList.contains('hidden')) return;
        if (moreFiltersPanel.contains(e.target) || moreFiltersToggle?.contains(e.target)) return;
        closeMoreFilters();
      });
    }

    initLiveMapSearch();
  </script>
)}
