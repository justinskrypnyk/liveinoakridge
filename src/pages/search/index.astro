---
export const prerender = false; // live Ontario-wide DDF search — see src/lib/ddf.ts
import Base from '@/layouts/Base.astro';
import Schema from '@/components/Schema.astro';
import SaveHeartButton from '@/components/SaveHeartButton.astro';
import SaveListingModal from '@/components/SaveListingModal.astro';
import SaveSearchModal from '@/components/SaveSearchModal.astro';
import WatchNearbyModal from '@/components/WatchNearbyModal.astro';
import { SITE } from '@/data/site';
import { searchMarketListings, searchNationalPoolByBounds, getActiveListingKeys } from '@/lib/ddf';
import { fmtPrice, field, buildAddress, buildStreetAddress, listingSlug, listingPhotoAlt, neighbourhoodForPoint } from '@/lib/listings';
import { AREAS } from '@/data/areas';
import { getAreaBounds, getAllAreasBounds } from '@/lib/area-boundaries';

const params = Astro.url.searchParams;
const q = params.get('q') || '';
const area = params.get('area') || '';
const minPrice = Number(params.get('minPrice')) || undefined;
const maxPrice = Number(params.get('maxPrice')) || undefined;
const propertyTypes = (params.get('types') || '').split(',').filter(Boolean);
const page = Number(params.get('page')) || 1;
const minBeds = Number(params.get('minBeds')) || undefined;
const minBaths = Number(params.get('minBaths')) || undefined;
const minParking = Number(params.get('minParking')) || undefined;
const minSqft = Number(params.get('minSqft')) || undefined;
const maxSqft = Number(params.get('maxSqft')) || undefined;
const daysOnMarket = Number(params.get('days')) || undefined;
const keyword = params.get('keyword') || '';
const sortBy = (params.get('sort') as 'newest' | 'price-asc' | 'price-desc' | 'beds-desc' | null) || 'newest';

// This page only ever reliably distinguishes the 4 coarse categories its
// underlying feeds' StructureType/PropertySubType matching already supports
// (see ddf.ts) -- not the full 8-category VOW breakdown, which relies on
// AMPRE's own precise PropertySubType strings that National Pool (spanning
// every Ontario board) doesn't share. Reusing PROPERTY_TYPE_OPTIONS' slugs
// for the ones that DO map cleanly keeps one shared list instead of a
// second near-duplicate; 'condo-townhouse' is deliberately left off since
// searchNationalPoolByBounds's keywordMap folds it into the same 'condo'
// bucket as 'condo-apt' has no separate keyword set for it.
const SEARCH_PROPERTY_TYPE_OPTIONS = [
  { slug: 'detached', label: 'Detached' },
  { slug: 'semi', label: 'Semi-Detached' },
  { slug: 'townhouse', label: 'Townhouse' },
  { slug: 'condo', label: 'Condo / Apartment' },
];

const priceSteps = Array.from({ length: 40 }, (_, i) => (i + 1) * 50000);
function shortPrice(n: number): string {
  if (n >= 1000000) return `$${(n / 1000000).toFixed(n % 1000000 === 0 ? 0 : 1)}M`;
  return `$${Math.round(n / 1000)}K`;
}

function areaUrl(slug: string): string {
  const u = new URLSearchParams(params);
  u.delete('q');
  u.delete('page');
  if (slug) u.set('area', slug);
  else u.delete('area');
  return `/search/?${u.toString()}`;
}

// getActiveListingKeys(), the text search, and the map browse search are
// all independent live fetches — run them concurrently instead of stacking
// them sequentially. (This used to be 3 separate `await`s in a row; on a
// cold instance that meant a full National-Pool-bounds search only started
// after a completely unrelated AMPRE lookup finished, which measured as the
// dominant cost behind a 14.7s GTmetrix LCP on this page.)
const initialBounds = (area ? getAreaBounds(area) : null) ?? getAllAreasBounds();

const [ownKeys, textResult, browseResult] = await Promise.all([
  getActiveListingKeys(),
  // Text search (a specific address/city/MLS® number anywhere in Ontario)
  // stays on the existing AMPRE-backed path — unrelated to the map below,
  // which is the "browse everything" default view.
  q ? searchMarketListings({ query: q, minPrice, maxPrice, propertyTypes, minBeds, minBaths, minParking, minSqft, maxSqft, page }) : Promise.resolve(null),
  !q
    ? searchNationalPoolByBounds({
        ...initialBounds, minPrice, maxPrice, propertyTypes,
        minBeds, minBaths, minParking, minSqft, maxSqft, daysOnMarket, keyword: keyword || undefined, sortBy,
      })
    : Promise.resolve(null),
]);

const textCards = (textResult?.listings ?? []).map((l) => {
  const L = l as Record<string, unknown>;
  const address = buildAddress(L);
  const city = field(L, 'City');
  const beds = field(L, 'BedroomsTotal');
  const propertyType = field(L, 'PropertySubType', 'PropertyType');
  // No lat/lng on this AMPRE text-search path (unlike browseCards below), so
  // neighbourhood falls back to city — see listingPhotoAlt's own fallback.
  return {
    address,
    city,
    price: fmtPrice(L.ListPrice),
    beds,
    baths: field(L, 'BathroomsTotalInteger', 'BathroomsTotal'),
    sqft: field(L, 'BuildingAreaTotal'),
    type: propertyType,
    brokerage: field(L, 'ListOfficeName'),
    isOwn: ownKeys.has(field(L, 'ListingKey', 'ListingId').toLowerCase()),
    photoUrl: (L._photoUrl as string | null) ?? null,
    photoAlt: listingPhotoAlt({ address: buildStreetAddress(L), city, beds, propertyType }, 0),
    detailHref: `/search/${listingSlug(L)}/`,
    mls: field(L, 'ListingKey', 'ListingId'),
  };
});

function pageUrl(p: number): string {
  const u = new URLSearchParams(params);
  u.set('page', String(p));
  return `/search/?${u.toString()}`;
}

// Browse mode (no `q`): a live, pannable/zoomable map covering every active
// residential listing in Ontario, sourced from National Pool (see
// src/lib/ddf.ts — AMPRE can't do viewport queries at all). Area tabs and
// the initial server render both start at a specific bounding box (computed
// above, alongside the Promise.all this feeds); from there the map component
// in the script below re-fetches on every pan/zoom.
const browseCards = (browseResult?.listings ?? []).map((l) => {
  const L = l as Record<string, unknown>;
  const geo = L._geo as { lat: number; lng: number } | null;
  const mls = field(L, 'ListingKey', 'ListingId');
  const address = buildAddress(L);
  const city = field(L, 'City');
  const beds = field(L, 'BedroomsTotal');
  const propertyType = field(L, 'PropertySubType');
  const neighbourhood = neighbourhoodForPoint(geo);
  return {
    lat: geo?.lat ?? null,
    lng: geo?.lng ?? null,
    mls,
    price: fmtPrice(L.ListPrice),
    rawPrice: Number(L.ListPrice) || 0,
    address,
    city,
    beds,
    baths: field(L, 'BathroomsTotalInteger', 'BathroomsTotal'),
    sqft: field(L, 'BuildingAreaTotal'),
    type: propertyType,
    brokerage: field(L, 'ListOfficeName'),
    isOwn: ownKeys.has(mls.toLowerCase()),
    photoUrl: (L._photoUrl as string | null) ?? null,
    // Same photo/index is used for both the grid card and this listing's
    // map-popup preview — one alt string covers both.
    photoAlt: listingPhotoAlt({ address: buildStreetAddress(L), city, neighbourhood, beds, propertyType }, 0),
    href: `/search/${listingSlug(L)}/`,
  };
});

const areaBoundsJson = Object.fromEntries(
  AREAS.map((a) => [a.slug, getAreaBounds(a.slug)]).filter(([, b]) => b)
);
const allAreasBoundsForClient = getAllAreasBounds();
---

<Base
  title="Browse London MLS® Listings, Every Brokerage | Justin Skrypnyk Real Estate Broker"
  description="Browse every active MLS® listing in Ontario from every brokerage on one interactive map, or search a specific city, address, or MLS® number. Brought to you by Justin Skrypnyk, Real Estate Broker."
>
  <Fragment slot="head">
    <Schema
      type="listing-collection"
      description="Every active MLS® listing in Ontario, every brokerage, browsable on one live map or by neighbourhood, city, address, or MLS® number."
      itemListName="Browse & Search MLS® Listings"
      itemListTotal={browseResult?.total ?? browseCards.length}
      itemList={browseCards.slice(0, 40).map((l) => ({
        name: `${l.address}${l.city ? `, ${l.city}` : ''} — ${l.price}`,
        url: `${SITE.url}${l.href}`,
      }))}
      breadcrumbs={[
        { name: 'Home', url: SITE.url },
        { name: 'Search Ontario Listings', url: `${SITE.url}/search/` },
      ]}
    />
  </Fragment>

  <section class="bg-navy py-16 text-white">
    <div class="container-site">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-white/50 mb-8">
        <a href="/" class="hover:text-gold transition-colors">Home</a>
        <span>/</span>
        <span class="text-white/70">Search Ontario Listings</span>
      </nav>
      <h1 class="font-serif text-5xl font-bold mb-4">Browse & Search MLS® Listings</h1>
      <div class="gold-divider mb-6"></div>
      <p class="text-xl text-white/70 max-w-2xl">
        Every active listing in Ontario, every brokerage, on one map — pan and zoom anywhere, or jump straight to a neighbourhood below. Or search a specific city, address, or MLS® number.
      </p>
    </div>
  </section>

  <section id="search-filter-bar" class="py-3 bg-white border-b border-gray-100 sticky top-20 z-30 shadow-sm">
    <div class="container-site">
      <button
        type="button"
        id="filters-toggle"
        class="flex items-center gap-2 text-sm font-semibold text-navy py-0.5 -my-0.5"
        aria-expanded="true"
        aria-controls="filters-collapsible"
      >
        <svg id="filters-toggle-icon" class="w-4 h-4 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        Search Filters
      </button>

      <div id="filters-collapsible" class="pt-2">
      <form method="GET" action="/search/" id="filters-form" class="flex flex-wrap items-center gap-2">
        <input type="hidden" name="area" value={area} />
        <div class="relative flex-1 min-w-[240px]">
          <svg class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-navy/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          <input
            type="text"
            name="q"
            value={q}
            placeholder="Leave blank to browse the map, or search a city/address/MLS® number (e.g. Toronto, X13567832)"
            class="w-full pl-10 pr-4 py-2 rounded-full text-sm bg-cream border border-gray-200 text-navy placeholder-navy/40 focus:border-gold focus:outline-none transition-colors"
          />
        </div>
        <div class="relative">
          <select name="minPrice" id="minPrice-select" aria-label="Minimum price" class="appearance-none pl-4 pr-9 py-1.5 rounded-full text-sm font-medium bg-cream text-navy/70 border border-gray-200 hover:border-gold focus:border-gold focus:outline-none transition-colors cursor-pointer">
            <option value="">No Min</option>
            {priceSteps.map((p) => <option value={p} selected={minPrice === p}>{shortPrice(p)}</option>)}
          </select>
        </div>
        <span class="text-navy/30 text-sm">–</span>
        <div class="relative">
          <select name="maxPrice" id="maxPrice-select" aria-label="Maximum price" class="appearance-none pl-4 pr-9 py-1.5 rounded-full text-sm font-medium bg-cream text-navy/70 border border-gray-200 hover:border-gold focus:border-gold focus:outline-none transition-colors cursor-pointer">
            <option value="">No Max</option>
            {priceSteps.map((p) => <option value={p} selected={maxPrice === p}>{shortPrice(p)}</option>)}
          </select>
        </div>
        <div class="relative">
          <input type="hidden" form="filters-form" name="types" id="types-hidden-input" value={propertyTypes.join(',')} />
          <button type="button" id="type-toggle" class="flex items-center gap-1.5 pl-4 pr-3.5 py-1.5 rounded-full text-sm font-medium bg-cream text-navy/70 border border-gray-200 hover:border-gold transition-colors cursor-pointer">
            <span id="type-toggle-label">{propertyTypes.length === 0 ? 'Any Type' : propertyTypes.length === 1 ? SEARCH_PROPERTY_TYPE_OPTIONS.find((o) => o.slug === propertyTypes[0])?.label : `${propertyTypes.length} Types`}</span>
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div id="type-backdrop" class="hidden fixed inset-0 bg-navy/40 z-40 lg:hidden"></div>
          <div id="type-panel" class="hidden fixed inset-x-0 bottom-0 z-50 bg-white rounded-t-3xl shadow-2xl p-5 max-h-[85vh] overflow-y-auto lg:absolute lg:inset-x-auto lg:bottom-auto lg:top-full lg:mt-2 lg:left-0 lg:w-64 lg:rounded-2xl lg:border lg:border-gray-100 lg:max-h-none lg:overflow-visible">
            <p class="font-serif text-lg text-navy font-bold mb-3 lg:hidden">Property Type</p>
            <label class="flex items-center gap-2.5 py-1.5 text-sm text-navy font-semibold cursor-pointer">
              <input type="checkbox" id="type-all" checked={propertyTypes.length === 0} class="w-4 h-4 accent-navy" />
              Any Type
            </label>
            <div class="border-t border-gray-100 my-2"></div>
            {SEARCH_PROPERTY_TYPE_OPTIONS.map((opt) => (
              <label class="flex items-center gap-2.5 py-1.5 text-sm text-navy/80 cursor-pointer">
                <input type="checkbox" class="type-option w-4 h-4 accent-navy" value={opt.slug} checked={propertyTypes.includes(opt.slug)} />
                {opt.label}
              </label>
            ))}
            <div class="flex gap-2 mt-4">
              <button type="button" id="type-cancel" class="flex-1 text-sm font-semibold px-4 py-2 rounded-lg border border-gray-200 text-navy hover:border-gold transition-colors">Cancel</button>
              <button type="button" id="type-save" class="flex-1 text-sm font-semibold px-4 py-2 rounded-lg bg-navy text-white hover:bg-navy/80 transition-colors">Save</button>
            </div>
          </div>
        </div>
        <div class="relative">
          <button
            type="button"
            id="more-filters-toggle"
            class="flex items-center gap-1.5 pl-4 pr-3.5 py-1.5 rounded-full text-sm font-medium bg-cream text-navy/70 border border-gray-200 hover:border-gold transition-colors cursor-pointer"
          >
            More Filters
            <span id="more-filters-count" class="hidden bg-emerald-500 text-navy text-[10px] font-bold w-4 h-4 rounded-full items-center justify-center leading-none"></span>
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </button>

          <div id="more-filters-backdrop" class="hidden fixed inset-0 bg-navy/40 z-40 lg:hidden"></div>

          <div
            id="more-filters-panel"
            class="hidden fixed inset-x-0 bottom-0 z-50 bg-white rounded-t-3xl shadow-2xl p-5 max-h-[85vh] overflow-y-auto lg:absolute lg:inset-x-auto lg:bottom-auto lg:top-full lg:mt-2 lg:right-0 lg:w-[560px] lg:rounded-2xl lg:border lg:border-gray-100 lg:max-h-none lg:overflow-visible"
          >
            <div class="flex items-center justify-between mb-4 lg:hidden">
              <span class="font-serif text-lg text-navy font-bold">More Filters</span>
              <button type="button" id="more-filters-close" aria-label="Close filters" class="w-8 h-8 rounded-full hover:bg-cream flex items-center justify-center">
                <svg class="w-5 h-5 text-navy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
              </button>
            </div>

            <div class="mb-5">
              <div class="text-xs font-semibold uppercase tracking-wider text-navy/50 mb-2">Bedrooms</div>
              <div class="flex flex-wrap gap-2">
                <input type="radio" form="filters-form" name="minBeds" id="minBeds-any" value="" class="peer/b0 sr-only" checked={!minBeds} />
                <label for="minBeds-any" class="cursor-pointer text-xs font-semibold px-3.5 py-1.5 rounded-full border border-gray-200 text-navy/70 peer-checked/b0:bg-navy peer-checked/b0:text-white peer-checked/b0:border-navy transition-colors">Any</label>
                {[1, 2, 3, 4, 5].map((n) => (
                  <>
                    <input type="radio" form="filters-form" name="minBeds" id={`minBeds-${n}`} value={n} class={`peer/b${n} sr-only`} checked={minBeds === n} />
                    <label for={`minBeds-${n}`} class={`cursor-pointer text-xs font-semibold px-3.5 py-1.5 rounded-full border border-gray-200 text-navy/70 peer-checked/b${n}:bg-navy peer-checked/b${n}:text-white peer-checked/b${n}:border-navy transition-colors`}>{n}+</label>
                  </>
                ))}
              </div>
            </div>

            <div class="mb-5">
              <div class="text-xs font-semibold uppercase tracking-wider text-navy/50 mb-2">Bathrooms</div>
              <div class="flex flex-wrap gap-2">
                <input type="radio" form="filters-form" name="minBaths" id="minBaths-any" value="" class="peer/a0 sr-only" checked={!minBaths} />
                <label for="minBaths-any" class="cursor-pointer text-xs font-semibold px-3.5 py-1.5 rounded-full border border-gray-200 text-navy/70 peer-checked/a0:bg-navy peer-checked/a0:text-white peer-checked/a0:border-navy transition-colors">Any</label>
                {[1, 2, 3, 4, 5].map((n) => (
                  <>
                    <input type="radio" form="filters-form" name="minBaths" id={`minBaths-${n}`} value={n} class={`peer/a${n} sr-only`} checked={minBaths === n} />
                    <label for={`minBaths-${n}`} class={`cursor-pointer text-xs font-semibold px-3.5 py-1.5 rounded-full border border-gray-200 text-navy/70 peer-checked/a${n}:bg-navy peer-checked/a${n}:text-white peer-checked/a${n}:border-navy transition-colors`}>{n}+</label>
                  </>
                ))}
              </div>
            </div>

            <div class="mb-5">
              <div class="text-xs font-semibold uppercase tracking-wider text-navy/50 mb-2">Garage / Covered Parking</div>
              <div class="flex flex-wrap gap-2">
                <input type="radio" form="filters-form" name="minParking" id="minParking-any" value="" class="peer/p0 sr-only" checked={!minParking} />
                <label for="minParking-any" class="cursor-pointer text-xs font-semibold px-3.5 py-1.5 rounded-full border border-gray-200 text-navy/70 peer-checked/p0:bg-navy peer-checked/p0:text-white peer-checked/p0:border-navy transition-colors">Any</label>
                {[1, 2, 3, 4, 5].map((n) => (
                  <>
                    <input type="radio" form="filters-form" name="minParking" id={`minParking-${n}`} value={n} class={`peer/p${n} sr-only`} checked={minParking === n} />
                    <label for={`minParking-${n}`} class={`cursor-pointer text-xs font-semibold px-3.5 py-1.5 rounded-full border border-gray-200 text-navy/70 peer-checked/p${n}:bg-navy peer-checked/p${n}:text-white peer-checked/p${n}:border-navy transition-colors`}>{n}+</label>
                  </>
                ))}
              </div>
            </div>

            <div class="grid grid-cols-2 gap-4 mb-5">
              <div>
                <div class="text-xs font-semibold uppercase tracking-wider text-navy/50 mb-2">Square Footage</div>
                <div class="flex items-center gap-2">
                  <input type="number" form="filters-form" name="minSqft" value={minSqft || ''} placeholder="Min" min="0" step="100" class="w-full px-3 py-2 rounded-lg text-sm bg-cream border border-gray-200 text-navy placeholder-navy/40 focus:border-gold focus:outline-none transition-colors" />
                  <span class="text-navy/30 text-sm shrink-0">–</span>
                  <input type="number" form="filters-form" name="maxSqft" value={maxSqft || ''} placeholder="Max" min="0" step="100" class="w-full px-3 py-2 rounded-lg text-sm bg-cream border border-gray-200 text-navy placeholder-navy/40 focus:border-gold focus:outline-none transition-colors" />
                </div>
              </div>
              <div>
                <div class="text-xs font-semibold uppercase tracking-wider text-navy/50 mb-2">Days on Market</div>
                <select form="filters-form" name="days" class="w-full appearance-none pl-4 pr-9 py-2 rounded-full text-sm font-medium bg-cream text-navy/70 border border-gray-200 hover:border-gold focus:border-gold focus:outline-none transition-colors cursor-pointer">
                  <option value="">Any time</option>
                  <option value="7" selected={daysOnMarket === 7}>Last 7 days</option>
                  <option value="30" selected={daysOnMarket === 30}>Last 30 days</option>
                  <option value="90" selected={daysOnMarket === 90}>Last 90 days</option>
                </select>
              </div>
            </div>

            <div class="mb-1">
              <div class="text-xs font-semibold uppercase tracking-wider text-navy/50 mb-2">Keyword</div>
              <input
                type="text"
                form="filters-form"
                name="keyword"
                value={keyword}
                placeholder="e.g. finished basement, pool, in-law suite"
                class="w-full px-4 py-2 rounded-full text-sm bg-cream border border-gray-200 text-navy placeholder-navy/40 focus:border-gold focus:outline-none transition-colors"
              />
            </div>

            <button type="submit" form="filters-form" class="btn-primary w-full justify-center mt-5 lg:hidden">Show Results</button>
          </div>
        </div>

        <button type="submit" class="btn-primary !py-2 !px-6">Search</button>
      </form>
      </div>

      {!q && (
        <div class="flex flex-wrap items-center gap-1.5 mt-3">
          <a
            href={areaUrl('')}
            data-area-tab
            data-bounds={JSON.stringify(allAreasBoundsForClient)}
            class={`text-xs font-semibold px-3 py-1 rounded-full transition-colors ${!area ? 'bg-navy text-white' : 'bg-cream text-navy/70 border border-gray-200 hover:border-gold'}`}
          >All London</a>
          {AREAS.map((a) => (
            <a
              href={areaUrl(a.slug)}
              data-area-tab
              data-bounds={JSON.stringify(areaBoundsJson[a.slug] ?? null)}
              class={`text-xs font-semibold px-3 py-1 rounded-full transition-colors ${area === a.slug ? 'bg-navy text-white' : 'bg-cream text-navy/70 border border-gray-200 hover:border-gold'}`}
            >{a.shortName}</a>
          ))}
        </div>
      )}

      {q ? (
        <div class="flex flex-wrap items-center justify-between gap-3 mt-2.5">
          <p class="text-sm text-slate">
            {textResult?.totalMatching ?? 0} active listing{(textResult?.totalMatching ?? 0) !== 1 ? 's' : ''} matching "{q}"
          </p>
          <button
            type="button"
            data-save-search-trigger
            class="flex items-center gap-1.5 pl-4 pr-3.5 py-1.5 rounded-full text-xs font-semibold bg-cream text-navy/70 border border-gray-200 hover:border-gold transition-colors cursor-pointer whitespace-nowrap"
          >
            🔔 Notify Me
          </button>
        </div>
      ) : (
        <div class="flex flex-wrap items-center justify-between gap-3 mt-2.5">
          <p id="results-count" class="text-sm text-slate">
            {browseResult?.capped
              ? `Showing ${browseCards.length} of ${browseResult.total.toLocaleString()} active listings in view — zoom in to narrow down`
              : `${browseResult?.total ?? 0} active listing${(browseResult?.total ?? 0) !== 1 ? 's' : ''} in view · all REALTORS®`}
          </p>
          <div class="flex items-center gap-2">
            <button
              type="button"
              data-save-search-trigger
              class="flex items-center gap-1.5 pl-4 pr-3.5 py-1.5 rounded-full text-xs font-semibold bg-cream text-navy/70 border border-gray-200 hover:border-gold transition-colors cursor-pointer whitespace-nowrap"
            >
              🔔 Notify Me
            </button>
            <div class="relative">
              <label for="sort-select" class="sr-only">Sort by</label>
              <select
                form="filters-form"
                name="sort"
                id="sort-select"
                class="appearance-none pl-4 pr-9 py-1.5 rounded-full text-xs font-semibold bg-cream text-navy/70 border border-gray-200 hover:border-gold focus:border-gold focus:outline-none transition-colors cursor-pointer"
