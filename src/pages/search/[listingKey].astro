---
export const prerender = false; // live Ontario-wide DDF lookup — see src/lib/ddf.ts
import Base from '@/layouts/Base.astro';
import GoogleMap from '@/components/GoogleMap.astro';
import ContactForm from '@/components/ContactForm.astro';
import { SITE } from '@/data/site';
import { getMarketListingByKey } from '@/lib/ddf';
import { fmtPrice, field, buildAddress, realtorUrl, photos } from '@/lib/listings';

const { listingKey } = Astro.params;
const listing = listingKey ? await getMarketListingByKey(listingKey) : null;

if (!listing) {
  return Astro.redirect('/search/', 302);
}

const address = buildAddress(listing);
const city = field(listing, 'City');
const price = fmtPrice(listing.ListPrice);
const rawPrice = Number(listing.ListPrice) || 0;
const beds = field(listing, 'BedroomsTotal');
const bedsAbove = field(listing, 'BedroomsAboveGrade');
const bedsBelow = field(listing, 'BedroomsBelowGrade');
const baths = field(listing, 'BathroomsTotalInteger');
const sqft = field(listing, 'BuildingAreaTotal');
const propertyType = field(listing, 'PropertySubType', 'PropertyType');
const style = Array.isArray(listing.ArchitecturalStyle) ? (listing.ArchitecturalStyle as string[]).join(', ') : '';
const yearBuilt = field(listing, 'YearBuilt');
const taxes = listing.TaxAnnualAmount ? fmtPrice(listing.TaxAnnualAmount) : '';
const parking = field(listing, 'ParkingTotal');
const garage = field(listing, 'CoveredSpaces');
const lotWidth = field(listing, 'LotWidth');
const lotDepth = field(listing, 'LotDepth');
const mlsNumber = field(listing, 'ListingKey', 'ListingId');
const remarks = field(listing, 'PublicRemarks');
const listOfficeName = field(listing, 'ListOfficeName') || 'the listing brokerage';
const photoUrls = photos(listing);
const mapQuery = address;

const facts: [string, string][] = [
  ['MLS® Number', mlsNumber],
  ['Price', price],
  ['Property Type', propertyType],
  ['Style', style],
  ['Year Built', yearBuilt],
  ['Bedrooms', bedsAbove || bedsBelow ? `${bedsAbove || 0} above grade, ${bedsBelow || 0} below grade` : beds],
  ['Bathrooms', baths],
  ['Square Footage', sqft ? `${Number(sqft).toLocaleString()} sq ft` : ''],
  ['Lot Size', lotWidth && lotDepth ? `${lotWidth} ft × ${lotDepth} ft` : ''],
  ['Parking Total', parking],
  ['Garage / Covered Spaces', garage],
  ['Annual Property Taxes', taxes],
  ['City', city],
  ['Listing Brokerage', listOfficeName],
].filter(([, v]) => v);
---

<Base
  title={`${address} | ${price} | Justin Skrypnyk Real Estate Broker`}
  description={`${address} — ${price}. ${beds ? `${beds} bed` : ''}${baths ? `, ${baths} bath` : ''} ${propertyType} listed by ${listOfficeName}. Contact Justin Skrypnyk, Real Estate Broker, for details or to book a showing.`}
  noindex
>
  <section class="bg-navy pt-8 pb-4 text-white">
    <div class="container-site">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-white/40 flex-wrap">
        <a href="/" class="hover:text-gold transition-colors">Home</a>
        <span>/</span>
        <a href="/search/" class="hover:text-gold transition-colors">Search Ontario Listings</a>
        <span>/</span>
        <span class="text-white/70">{address}</span>
      </nav>
    </div>
  </section>

  <section class="bg-navy pb-8">
    <div class="container-site">
      {photoUrls.length > 0 ? (
        <div id="gallery" class="rounded-2xl overflow-hidden">
          <div class="relative bg-navy-dark aspect-[16/10] md:aspect-[16/9]">
            {photoUrls.map((url, i) => (
              <img
                src={url}
                alt={`${address} — photo ${i + 1} of ${photoUrls.length}`}
                class="gallery-slide absolute inset-0 w-full h-full object-cover transition-opacity duration-300"
                style={i === 0 ? '' : 'opacity:0; pointer-events:none;'}
                data-index={i}
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            ))}
            <button id="gallery-prev" type="button" aria-label="Previous photo" class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-navy-dark/70 text-white flex items-center justify-center hover:bg-gold hover:text-navy transition-colors">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <button id="gallery-next" type="button" aria-label="Next photo" class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-navy-dark/70 text-white flex items-center justify-center hover:bg-gold hover:text-navy transition-colors">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
            </button>
            <div id="gallery-count" class="absolute bottom-3 right-3 bg-navy-dark/80 text-white text-xs font-semibold px-3 py-1.5 rounded-full">1 / {photoUrls.length}</div>
          </div>
          <div class="flex gap-2 mt-2 overflow-x-auto pb-2 no-scrollbar">
            {photoUrls.map((url, i) => (
              <button type="button" class="gallery-thumb shrink-0 w-20 h-16 rounded-lg overflow-hidden border-2 border-transparent data-[active=true]:border-gold" data-index={i}>
                <img src={url} alt="" class="w-full h-full object-cover" loading="lazy" />
              </button>
            ))}
          </div>
        </div>
      ) : (
        <div class="aspect-[16/9] bg-navy-light rounded-2xl flex items-center justify-center">
          <span class="text-7xl">🏡</span>
        </div>
      )}
    </div>
  </section>

  <section class="py-8 bg-white border-b border-gray-100">
    <div class="container-site">
      <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="bg-gold text-navy text-xs font-bold px-3 py-1 rounded-full">{field(listing, 'StandardStatus') || 'Active'}</span>
          </div>
          <h1 class="font-serif text-3xl md:text-4xl text-navy font-bold mb-1">{address}</h1>
          <p class="text-slate">{city}{field(listing, 'PostalCode') ? `, ${field(listing, 'PostalCode')}` : ''}</p>
        </div>
        <div class="shrink-0">
          <div class="font-serif text-4xl md:text-5xl text-navy font-bold mb-4 md:text-right">{price}</div>
          <div class="flex items-stretch divide-x divide-gray-200 border border-gray-200 rounded-xl overflow-hidden bg-cream/40">
            {beds && (
              <div class="flex-1 px-6 py-3.5 text-center min-w-[92px]">
                <svg class="w-4 h-4 text-gold mx-auto mb-1.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 13c1.66 0 3-1.34 3-3S8.66 7 7 7s-3 1.34-3 3 1.34 3 3 3zm12-6h-8v7H3V5H1v15h2v-3h18v3h2v-9c0-2.21-1.79-4-4-4z"/></svg>
                <div class="font-serif text-2xl text-navy font-bold leading-none">{beds}</div>
                <div class="text-[10px] text-slate/70 uppercase tracking-wider font-semibold mt-1">Bedrooms</div>
              </div>
            )}
            {baths && (
              <div class="flex-1 px-6 py-3.5 text-center min-w-[92px]">
                <svg class="w-4 h-4 text-gold mx-auto mb-1.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 6c0-.55.45-1 1-1s1 .45 1 1-.45 1-1 1-1-.45-1-1zm12 7H5V7.58C5.16 7.79 5.31 8 5.5 8c.55 0 1-.45 1-1V5c0-1.1-.9-2-2-2S3 3.9 3 5v13c0 1.1.9 2 2 2s2-.9 2-2v-1h14v1c0 1.1.9 2 2 2s2-.9 2-2v-5c0-1.66-1.34-3-3-3zM21 18H5v-3h14v2h2v1z"/></svg>
                <div class="font-serif text-2xl text-navy font-bold leading-none">{baths}</div>
                <div class="text-[10px] text-slate/70 uppercase tracking-wider font-semibold mt-1">Bathrooms</div>
              </div>
            )}
            {sqft && (
              <div class="flex-1 px-6 py-3.5 text-center min-w-[92px]">
                <svg class="w-4 h-4 text-gold mx-auto mb-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 8V3h5M21 8V3h-5M3 16v5h5M21 16v5h-5"/></svg>
                <div class="font-serif text-2xl text-navy font-bold leading-none">{Number(sqft).toLocaleString()}</div>
                <div class="text-[10px] text-slate/70 uppercase tracking-wider font-semibold mt-1">Sq Ft</div>
              </div>
            )}
          </div>
        </div>
      </div>

      <div class="flex flex-wrap gap-3 mt-6">
        <a href="#request-showing" class="btn-primary">Request a Showing</a>
        <a href="#request-info" class="btn-secondary">Request Info</a>
        <a href={`tel:${SITE.phone}`} class="btn-secondary">Call {SITE.phoneDisplay}</a>
        <a href={realtorUrl(listing)} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-navy/60 hover:text-gold text-sm font-medium px-4 py-3.5 transition-colors">
          View on REALTOR.ca
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M7 7h10v10"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="py-12 bg-cream">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
        <div class="lg:col-span-2 space-y-10">
          {remarks && (
            <div>
              <h2 class="font-serif text-2xl text-navy mb-4">About This Home</h2>
              <p class="text-slate leading-relaxed whitespace-pre-line">{remarks}</p>
            </div>
          )}

          <div>
            <h2 class="font-serif text-2xl text-navy mb-4">Facts &amp; Features</h2>
            <div class="bg-white rounded-2xl shadow-card overflow-hidden">
              {facts.map(([label, value], i) => (
                <div class={`flex items-center justify-between px-5 py-3 text-sm ${i % 2 === 0 ? 'bg-cream/50' : ''}`}>
                  <span class="text-slate">{label}</span>
                  <span class="text-navy font-semibold">{value}</span>
                </div>
              ))}
            </div>
          </div>

          <div>
            <h2 class="font-serif text-2xl text-navy mb-4">Location</h2>
            <GoogleMap query={mapQuery} title={address} height="360px" />
          </div>
        </div>

        <div class="space-y-6">
          <div class="bg-navy text-white rounded-2xl overflow-hidden">
            <div class="aspect-[4/5] bg-white">
              <img src="/images/justin-skrypnyk-realtor-billboard.webp" alt={SITE.agent} class="w-full h-full object-cover object-top" />
            </div>
            <div class="px-6 pt-5 pb-4 border-b border-white/10">
              <div class="font-serif text-2xl leading-none uppercase tracking-wide">{SITE.agent}</div>
              <div class="text-xs text-gold uppercase tracking-[0.15em] font-semibold mt-2">Real Estate Broker</div>
              <div class="text-xs text-white/50 mt-0.5">{SITE.brokerage}</div>
            </div>
            <div class="p-6">
              <p class="text-xs text-white/50 mb-4 leading-relaxed">
                This listing is courtesy of {listOfficeName}. {SITE.agent} can arrange a private showing or answer questions as your buyer's representative.
              </p>
              <div class="space-y-2 mb-5">
                <a href={`tel:${SITE.phone}`} class="flex items-center gap-2 text-sm text-white/80 hover:text-gold transition-colors">
                  <svg class="w-4 h-4 text-gold shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
                  {SITE.phoneDisplay}
                </a>
                <a href={`mailto:${SITE.email}`} class="flex items-center gap-2 text-sm text-white/80 hover:text-gold transition-colors">
                  <svg class="w-4 h-4 text-gold shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
                  {SITE.email}
                </a>
              </div>
              <a href="#request-showing" class="btn-primary w-full justify-center mb-2">Request a Showing</a>
              <a href={`tel:${SITE.phone}`} class="btn-secondary w-full justify-center !border-white/30 !text-white hover:!bg-gold hover:!text-navy">Call Now</a>
            </div>
          </div>

          <div id="request-showing" class="bg-white rounded-2xl shadow-card p-6 scroll-mt-24">
            <h3 class="font-serif text-xl text-navy mb-1">Request a Showing</h3>
            <p class="text-sm text-slate mb-5">{address}</p>
            <ContactForm subject={`Showing Request: ${address}`} ctaLabel="Request Showing" />
          </div>

          <div id="request-info" class="bg-white rounded-2xl shadow-card p-6 scroll-mt-24">
            <h3 class="font-serif text-xl text-navy mb-1">Request More Info</h3>
            <p class="text-sm text-slate mb-5">Have a question about this listing? Ask Justin directly.</p>
            <ContactForm subject={`Listing Inquiry: ${address}`} ctaLabel="Send Inquiry" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="hidden lg:flex fixed bottom-6 left-1/2 -translate-x-1/2 z-30 items-center gap-4 bg-navy text-white rounded-full shadow-2xl pl-2 pr-3 py-2">
    <img src="/images/justin-skrypnyk-realtor-london-ontario.webp" alt={SITE.agent} class="w-11 h-11 rounded-full object-cover shrink-0" />
    <div class="pr-2">
      <div class="text-sm font-semibold leading-tight">{price}</div>
      <div class="text-xs text-white/50 leading-tight">{address}</div>
    </div>
    <a href="#request-showing" class="btn-primary !py-2.5 !px-5 text-sm whitespace-nowrap">Request a Showing</a>
    <a href={`tel:${SITE.phone}`} aria-label={`Call ${SITE.phoneDisplay}`} class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center hover:bg-gold hover:text-navy hover:border-gold transition-colors shrink-0">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
    </a>
  </div>

  <!-- Required MLS/REALTOR compliance footer — National Pool Website wording -->
  <section class="py-8 bg-white border-t border-gray-100">
    <div class="container-site">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate/70">
        <a href={realtorUrl(listing)} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 hover:text-gold transition-colors">
          <span class="w-5 h-5 rounded bg-navy text-white flex items-center justify-center font-bold text-[10px] shrink-0">R</span>
          Powered by REALTOR.ca
        </a>
        <p class="text-center sm:text-right max-w-xl">
          REALTOR®, REALTORS®, and the REALTOR® logo are certification marks owned by REALTOR® Canada Inc. and licensed exclusively to The Canadian Real Estate Association (CREA). MLS® and the MLS® logo are owned by CREA. Listing content courtesy of {listOfficeName}. See our <a href="/terms-of-use/" class="text-gold hover:underline">Terms of Use</a>.
        </p>
      </div>
    </div>
  </section>
</Base>

<script define:vars={{ mlsNumber }}>
  // CREA Analytics Web Service — fire-and-forget "view" beacon. Client-side
  // only (define:vars scripts are inlined, not modules, kept in sync with
  // properties/[listingKey].astro's copy manually).
  (function logListingView(listingId) {
    try {
      const DESTINATION_ID = 66460;
      const storageKey = 'crea_analytics_uuid';
      let uuid = localStorage.getItem(storageKey);
      if (!uuid) {
        uuid = crypto.randomUUID ? crypto.randomUUID() : `${Date.now()}-${Math.random().toString(36).slice(2)}`;
        localStorage.setItem(storageKey, uuid);
      }
      const params = new URLSearchParams({
        ListingID: listingId,
        DestinationID: String(DESTINATION_ID),
        EventType: 'view',
        UUID: `${uuid}-${DESTINATION_ID}`,
        ReferralURL: document.referrer || '',
        LanguageID: '1',
      });
      new Image().src = `https://analytics.crea.ca/LogEvents.svc/LogEvents?${params.toString()}`;
    } catch {
      // Analytics must never break the page.
    }
  })(mlsNumber);

  const slides = Array.from(document.querySelectorAll('.gallery-slide'));
  const thumbs = Array.from(document.querySelectorAll('.gallery-thumb'));
  const countEl = document.getElementById('gallery-count');
  let current = 0;

  function show(index) {
    if (slides.length === 0) return;
    current = (index + slides.length) % slides.length;
    slides.forEach((s, i) => { s.style.opacity = i === current ? '1' : '0'; s.style.pointerEvents = i === current ? 'auto' : 'none'; });
    thumbs.forEach((t, i) => t.dataset.active = String(i === current));
    if (countEl) countEl.textContent = `${current + 1} / ${slides.length}`;
  }

  document.getElementById('gallery-prev')?.addEventListener('click', () => show(current - 1));
  document.getElementById('gallery-next')?.addEventListener('click', () => show(current + 1));
  thumbs.forEach((t) => t.addEventListener('click', () => show(Number(t.dataset.index))));
  show(0);
</script>
