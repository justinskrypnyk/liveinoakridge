---
export const prerender = false; // fetch live DDF listings on-demand — see src/lib/ddf.ts
import Base from '@/layouts/Base.astro';
import { SITE } from '@/data/site';
import { AREAS } from '@/data/areas';
import { getActiveListings } from '@/lib/ddf';
import { fmtPrice, field, buildAddress, realtorUrl, listingSlug, AREA_SLUGS } from '@/lib/listings';
import { findAreaForPoint } from '@/lib/area-boundaries';
import ListingsMap from '@/components/ListingsMap.astro';

const listings = await getActiveListings();
const browseAreas = AREAS.filter((a) => a.avgPrice);
const fetchedAt = new Date().toISOString();
const totalCount = listings.length;

// $50K increments from $50K to $2M for the min/max price filters
const priceSteps = Array.from({ length: 40 }, (_, i) => (i + 1) * 50000);
function shortPrice(n: number): string {
  if (n >= 1000000) return `$${(n / 1000000).toFixed(n % 1000000 === 0 ? 0 : 1)}M`;
  return `$${Math.round(n / 1000)}K`;
}

// Pre-process listings in frontmatter to avoid type annotation issues in template
type ListingCard = {
  address: string; city: string; area: string; price: string; rawPrice: number;
  beds: string; baths: string; sqft: string; type: string; garage: string; brokerage: string;
  photoUrl: string | null; realtorLink: string; detailHref: string; areaSlug: string | null; beds_n: number;
  mls: string; baths_n: number; parking_n: number; daysOnMarket: number; remarks: string;
};

// AMPRE's own DaysOnMarket field is never populated (verified empirically) —
// computed from OriginalEntryTimestamp instead, same approach used for the
// National Pool feed on /search/.
function computeDaysOnMarket(raw: string): number {
  if (!raw) return Infinity;
  const listed = new Date(raw).getTime();
  if (Number.isNaN(listed)) return Infinity;
  return Math.floor((Date.now() - listed) / (1000 * 60 * 60 * 24));
}

const processedListings: ListingCard[] = listings.map((l) => {
  const L = l as Record<string, unknown>;
  const address = buildAddress(L);
  const city = field(L, 'City');
  const cityRegion = field(L, 'CityRegion');
  const geo = L._geo as { lat: number; lng: number } | null;
  const areaEntry = Object.entries(AREA_SLUGS).find(([name]) =>
    cityRegion.toLowerCase().includes(name.toLowerCase()) || address.toLowerCase().includes(name.toLowerCase())
  );
  // Prefer the real boundary-polygon match over the text-match fallback —
  // text matching false-positives on addresses like "590 Oakridge Drive"
  // in a neighbourhood that isn't actually Oakridge.
  const geoSlug = geo ? findAreaForPoint(geo.lat, geo.lng) : null;
  const areaSlug = geoSlug ?? areaEntry?.[1] ?? null;
  const areaName = geoSlug
    ? (Object.entries(AREA_SLUGS).find(([, slug]) => slug === geoSlug)?.[0] ?? geoSlug)
    : (areaEntry?.[0] ?? '');
  return {
    address,
    city,
    area: areaName,
    price: fmtPrice(L.ListPrice),
    rawPrice: Number(L.ListPrice) || 0,
    beds: field(L, 'BedroomsTotal'),
    baths: field(L, 'BathroomsTotalInteger', 'BathroomsTotal'),
    sqft: field(L, 'BuildingAreaTotal'),
    type: field(L, 'PropertySubType', 'PropertyType'),
    garage: field(L, 'CoveredSpaces', 'GarageSpaces'),
    brokerage: field(L, 'ListOfficeName') || SITE.brokerage,
    photoUrl: (L._photoUrl as string | null) ?? null,
    realtorLink: realtorUrl(L),
    detailHref: `/properties/${listingSlug(L)}/`,
    areaSlug,
    beds_n: Number(field(L, 'BedroomsTotal')) || 0,
    mls: field(L, 'ListingKey', 'ListingId'),
    baths_n: Number(field(L, 'BathroomsTotalInteger', 'BathroomsTotal')) || 0,
    parking_n: Number(field(L, 'ParkingTotal')) || 0,
    daysOnMarket: computeDaysOnMarket(field(L, 'OriginalEntryTimestamp')),
    remarks: field(L, 'PublicRemarks'),
  };
});
---

<Base
  title="Homes For Sale in West London Ontario | Justin Skrypnyk Real Estate Broker"
  description="Browse current MLS® listings in Oakridge, West London, Whitehills, Byron, Westmount, Riverbend, and Lambeth. Updated from DDF® before every build. Contact Justin Skrypnyk at 519.639.5176."
>
  <!-- Hero -->
  <section class="bg-navy py-20 text-white">
    <div class="container-site">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-white/40 mb-8">
        <a href="/" class="hover:text-gold transition-colors">Home</a>
        <span>/</span>
        <span class="text-white/70">Properties</span>
      </nav>
      <div class="max-w-3xl">
        <h1 class="font-serif text-5xl font-bold mb-4">Homes For Sale in West London</h1>
        <div class="gold-divider mb-6"></div>
        <p class="text-xl text-white/70 leading-relaxed">
          Browse houses for sale across Oakridge, Byron, Westmount, Lambeth, and every West London neighbourhood Justin serves.
          {totalCount > 0 && <span> {totalCount} homes available.</span>}
        </p>
        {fetchedAt && (
          <p class="text-sm text-white/40 mt-4">
            Last updated: {new Date(fetchedAt).toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' })}
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- Filter bar (client-side JS) -->
  <section class="py-6 bg-white border-b border-gray-100 sticky top-20 z-30 shadow-sm">
    <div class="container-site">
      {listings.length > 0 && (
        <div class="relative mb-3 max-w-md">
          <svg class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-navy/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          <input
            type="text"
            id="listing-search"
            placeholder="Search by address or MLS® number..."
            class="w-full pl-10 pr-4 py-2.5 rounded-full text-sm bg-cream border border-gray-200 text-navy placeholder-navy/40 focus:border-gold focus:outline-none transition-colors"
          />
        </div>
      )}
      <div class="flex flex-wrap gap-2 items-center">
        <span class="text-sm font-medium text-navy/60 mr-1 shrink-0">Filter:</span>
        {['All', ...AREAS.map((a) => a.name)].map((area, i) => (
          <button
            data-filter={area === 'All' ? '' : area}
            class={`filter-btn px-4 py-2 rounded-full text-sm font-medium transition-all ${i === 0 ? 'bg-gold text-navy' : 'bg-cream text-navy/70 hover:bg-gold hover:text-navy border border-gray-200'}`}
          >
            {area}
          </button>
        ))}
        {listings.length > 0 && (
          <span class="ml-auto text-sm text-slate hidden sm:inline" id="listing-count">{listings.length} listings</span>
        )}
        {listings.length > 0 && (
          <div class="flex bg-cream rounded-full p-1 border border-gray-200 shrink-0 ml-auto sm:ml-0">
            <button type="button" id="view-grid-btn" class="view-toggle-btn px-4 py-1.5 rounded-full text-sm font-medium bg-gold text-navy transition-all" data-active="true">Grid</button>
            <button type="button" id="view-map-btn" class="view-toggle-btn px-4 py-1.5 rounded-full text-sm font-medium text-navy/70 hover:text-navy transition-all" data-active="false">Map</button>
          </div>
        )}
      </div>

      <!-- Price + Type + More Filters + Sort -->
      {listings.length > 0 && (
        <div class="flex flex-wrap items-center gap-2.5 mt-3">
          <div class="relative">
            <select id="filter-price-min" class="filter-select appearance-none pl-4 pr-9 py-2 rounded-full text-sm font-medium bg-cream text-navy/70 border border-gray-200 hover:border-gold focus:border-gold focus:outline-none transition-colors cursor-pointer">
              <option value="">No Min</option>
              {priceSteps.map((p) => <option value={p}>{shortPrice(p)}</option>)}
            </select>
            <svg class="pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 w-3 h-3 text-navy/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M6 9l6 6 6-6"/></svg>
          </div>
          <span class="text-navy/30 text-sm">–</span>
          <div class="relative">
            <select id="filter-price-max" class="filter-select appearance-none pl-4 pr-9 py-2 rounded-full text-sm font-medium bg-cream text-navy/70 border border-gray-200 hover:border-gold focus:border-gold focus:outline-none transition-colors cursor-pointer">
              <option value="">No Max</option>
              {priceSteps.map((p) => <option value={p}>{shortPrice(p)}</option>)}
            </select>
            <svg class="pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 w-3 h-3 text-navy/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M6 9l6 6 6-6"/></svg>
          </div>
          <div class="relative">
            <!-- Values/labels match /search/'s property type filter exactly
                 (Detached/Semi/Townhouse/Condo) — the old "Single Family"
                 option never matched real AMPRE data (Chapman's listings use
                 "Detached"), so it was silently non-functional. -->
            <select id="filter-type" class="filter-select appearance-none pl-4 pr-9 py-2 rounded-full text-sm font-medium bg-cream text-navy/70 border border-gray-200 hover:border-gold focus:border-gold focus:outline-none transition-colors cursor-pointer">
              <option value="">Any Type</option>
              <option value="Detached">Detached</option>
              <option value="Semi">Semi-Detached</option>
              <option value="Townhouse">Townhouse</option>
              <option value="Condo">Condo / Apartment</option>
            </select>
            <svg class="pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 w-3 h-3 text-navy/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M6 9l6 6 6-6"/></svg>
          </div>

          <div class="relative">
            <button
              type="button"
              id="more-filters-toggle"
              class="flex items-center gap-1.5 pl-4 pr-3.5 py-2 rounded-full text-sm font-medium bg-cream text-navy/70 border border-gray-200 hover:border-gold transition-colors cursor-pointer"
            >
              More Filters
              <span id="more-filters-count" class="hidden bg-emerald-500 text-navy text-[10px] font-bold w-4 h-4 rounded-full items-center justify-center leading-none"></span>
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            </button>

            <div id="more-filters-backdrop" class="hidden fixed inset-0 bg-navy/40 z-40 lg:hidden"></div>

            <div
              id="more-filters-panel"
              class="hidden fixed inset-x-0 bottom-0 z-50 bg-white rounded-t-3xl shadow-2xl p-5 max-h-[85vh] overflow-y-auto lg:absolute lg:inset-x-auto lg:bottom-auto lg:top-full lg:mt-2 lg:right-0 lg:w-[560px] lg:rounded-2xl lg:border lg:border-gray-100 lg:max-h-none lg:overflow-visible"
            >
              <div class="flex items-center justify-between mb-4 lg:hidden">
                <span class="font-serif text-lg text-navy font-bold">More Filters</span>
                <button type="button" id="more-filters-close" aria-label="Close filters" class="w-8 h-8 rounded-full hover:bg-cream flex items-center justify-center">
                  <svg class="w-5 h-5 text-navy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                </button>
              </div>

              <div class="mb-5">
                <div class="text-xs font-semibold uppercase tracking-wider text-navy/50 mb-2">Bedrooms</div>
                <div class="flex flex-wrap gap-2">
                  <input type="radio" name="beds-radio" id="p-beds-any" value="" class="peer/pbd0 sr-only" checked />
                  <label for="p-beds-any" class="cursor-pointer text-xs font-semibold px-3.5 py-1.5 rounded-full border border-gray-200 text-navy/70 peer-checked/pbd0:bg-navy peer-checked/pbd0:text-white peer-checked/pbd0:border-navy transition-colors">Any</label>
                  {[1, 2, 3, 4, 5].map((n) => (
                    <>
                      <input type="radio" name="beds-radio" id={`p-beds-${n}`} value={n} class={`peer/pbd${n} sr-only`} />
                      <label for={`p-beds-${n}`} class={`cursor-pointer text-xs font-semibold px-3.5 py-1.5 rounded-full border border-gray-200 text-navy/70 peer-checked/pbd${n}:bg-navy peer-checked/pbd${n}:text-white peer-checked/pbd${n}:border-navy transition-colors`}>{n}+</label>
                    </>
                  ))}
                </div>
              </div>

              <div class="mb-5">
                <div class="text-xs font-semibold uppercase tracking-wider text-navy/50 mb-2">Bathrooms</div>
                <div class="flex flex-wrap gap-2">
                  <input type="radio" name="baths-radio" id="p-baths-any" value="" class="peer/pba0 sr-only" checked />
                  <label for="p-baths-any" class="cursor-pointer text-xs font-semibold px-3.5 py-1.5 rounded-full border border-gray-200 text-navy/70 peer-checked/pba0:bg-navy peer-checked/pba0:text-white peer-checked/pba0:border-navy transition-colors">Any</label>
                  {[1, 2, 3, 4, 5].map((n) => (
                    <>
                      <input type="radio" name="baths-radio" id={`p-baths-${n}`} value={n} class={`peer/pba${n} sr-only`} />
                      <label for={`p-baths-${n}`} class={`cursor-pointer text-xs font-semibold px-3.5 py-1.5 rounded-full border border-gray-200 text-navy/70 peer-checked/pba${n}:bg-navy peer-checked/pba${n}:text-white peer-checked/pba${n}:border-navy transition-colors`}>{n}+</label>
                    </>
                  ))}
                </div>
              </div>

              <div class="grid grid-cols-2 gap-4 mb-5">
                <div>
                  <div class="text-xs font-semibold uppercase tracking-wider text-navy/50 mb-2">Parking</div>
                  <select id="filter-parking" class="w-full appearance-none pl-4 pr-9 py-2 rounded-full text-sm font-medium bg-cream text-navy/70 border border-gray-200 hover:border-gold focus:border-gold focus:outline-none transition-colors cursor-pointer">
                    <option value="">Any</option>
                    <option value="1">1+</option>
                    <option value="2">2+</option>
                    <option value="3">3+</option>
                  </select>
                </div>
                <div>
                  <div class="text-xs font-semibold uppercase tracking-wider text-navy/50 mb-2">Days on Market</div>
                  <select id="filter-days" class="w-full appearance-none pl-4 pr-9 py-2 rounded-full text-sm font-medium bg-cream text-navy/70 border border-gray-200 hover:border-gold focus:border-gold focus:outline-none transition-colors cursor-pointer">
                    <option value="">Any time</option>
                    <option value="7">Last 7 days</option>
                    <option value="30">Last 30 days</option>
                    <option value="90">Last 90 days</option>
                  </select>
                </div>
              </div>

              <div class="mb-1">
                <div class="text-xs font-semibold uppercase tracking-wider text-navy/50 mb-2">Keyword</div>
                <input
                  type="text"
                  id="filter-keyword"
                  placeholder="e.g. finished basement, pool, in-law suite"
                  class="w-full px-4 py-2 rounded-full text-sm bg-cream border border-gray-200 text-navy placeholder-navy/40 focus:border-gold focus:outline-none transition-colors"
                />
              </div>
            </div>
          </div>

          <div class="relative">
            <select id="filter-sort" class="filter-select appearance-none pl-4 pr-9 py-2 rounded-full text-sm font-medium bg-cream text-navy/70 border border-gray-200 hover:border-gold focus:border-gold focus:outline-none transition-colors cursor-pointer">
              <option value="newest">Newest First</option>
              <option value="price-asc">Price: Low to High</option>
              <option value="price-desc">Price: High to Low</option>
              <option value="beds-desc">Most Bedrooms</option>
            </select>
            <svg class="pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 w-3 h-3 text-navy/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M6 9l6 6 6-6"/></svg>
          </div>

          <button type="button" id="clear-filters-btn" class="hidden items-center gap-1 text-sm font-medium text-navy/50 hover:text-gold transition-colors px-2 py-2">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
            Clear all
          </button>
        </div>
      )}
    </div>
  </section>

  <!-- Map view -->
  {listings.length > 0 && (
    <section id="map-view" class="py-8 bg-cream hidden">
      <div class="container-site">
        <ListingsMap listings={listings} height="600px" showSchools={false} />
      </div>
    </section>
  )}

  <!-- Listings grid -->
  <section id="grid-view" class="py-12 bg-cream">
    <div class="container-site">
      {listings.length === 0 ? (
        <!-- Empty state — DDF not yet connected -->
        <div class="max-w-2xl mx-auto text-center py-12">
          <div class="text-6xl mb-6">🏡</div>
          <h2 class="font-serif text-3xl text-navy mb-2">Live MLS® Listings Coming Soon</h2>
          <p class="text-sm font-semibold text-navy/70 mb-6">
            {SITE.agent}, Real Estate Broker · {SITE.brokerage}
          </p>
          <p class="text-slate text-lg leading-relaxed mb-8">
            Justin's DDF® feed is being configured. In the meantime, contact Justin directly for the latest
            available listings in Oakridge, West London, Whitehills, Byron, Westmount, Riverbend, and Lambeth.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href={`tel:${SITE.phone}`} class="btn-primary">Call {SITE.phoneDisplay}</a>
            <a href="/contact/" class="btn-secondary">Send a Listing Request</a>
          </div>

          <!-- Area links -->
          <div class="mt-14">
            <h3 class="font-serif text-xl text-navy mb-5">Browse by Neighbourhood</h3>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
              {browseAreas.map((area) => (
                <a href={`/areas/${area.slug}/buy/`} class="card p-4 hover:border-gold/30 border border-transparent group text-center">
                  <h4 class="font-serif text-navy group-hover:text-gold transition-colors font-semibold text-sm">{area.name}</h4>
                  <p class="text-xs text-slate mt-1">{area.avgPrice}</p>
                </a>
              ))}
            </div>
          </div>
        </div>
      ) : (
        <!-- Live listings grid -->
        <div id="listings-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
          {processedListings.map((l) => (
            <article
              class="listing-card bg-white rounded-2xl shadow-card overflow-hidden hover:shadow-lg hover:-translate-y-0.5 transition-all border border-gray-100"
              data-area={l.area || l.city}
              data-type={l.type}
              data-price={l.rawPrice}
              data-beds={l.beds_n}
              data-baths={l.baths_n}
              data-parking={l.parking_n}
              data-days={l.daysOnMarket}
              data-address={l.address}
              data-mls={l.mls}
              data-remarks={l.remarks.toLowerCase()}
            >
              <!-- Photo -->
              <div class="aspect-[4/3] bg-cream relative overflow-hidden">
                {l.photoUrl ? (
                  <img src={l.photoUrl} alt={`${l.address}, ${l.city}`} class="w-full h-full object-cover" loading="lazy" />
                ) : (
                  <div class="flex items-center justify-center h-full">
                    <span class="text-5xl">🏡</span>
                  </div>
                )}
                <div class="absolute top-2 left-2">
                  <span class="bg-gold text-navy text-xs font-bold px-2.5 py-0.5 rounded-full">Active</span>
                </div>
                {l.type && (
                  <div class="absolute top-2 right-2">
                    <span class="bg-navy/80 text-white text-xs font-medium px-2 py-0.5 rounded-full">{l.type}</span>
                  </div>
                )}
              </div>

              <!-- Details -->
              <a href={l.detailHref} class="block p-3.5">
                <div class="font-serif text-lg text-navy font-bold mb-0.5">{l.price}</div>
                <p class="text-slate text-xs leading-snug mb-2 line-clamp-1">{l.address}{l.city ? `, ${l.city}` : ''}</p>

                {l.area && (
                  <div class="mb-2">
                    <span class="inline-block bg-cream text-gold text-xs font-semibold px-2 py-0.5 rounded-full">{l.area}</span>
                  </div>
                )}

                <!-- Stats row -->
                <div class="flex items-center gap-3 text-xs text-navy/70 border-t border-gray-100 pt-2">
                  {l.beds && (
                    <div class="flex items-center gap-1">
                      <svg class="w-3.5 h-3.5 text-gold" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M7 13c1.66 0 3-1.34 3-3S8.66 7 7 7s-3 1.34-3 3 1.34 3 3 3zm12-6h-8v7H3V5H1v15h2v-3h18v3h2v-9c0-2.21-1.79-4-4-4z"/>
                      </svg>
                      <span>{l.beds} bed</span>
                    </div>
                  )}
                  {l.baths && (
                    <div class="flex items-center gap-1">
                      <svg class="w-3.5 h-3.5 text-gold" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M7 6c0-.55.45-1 1-1s1 .45 1 1-.45 1-1 1-1-.45-1-1zm12 7H5V7.58C5.16 7.79 5.31 8 5.5 8c.55 0 1-.45 1-1V5c0-1.1-.9-2-2-2S3 3.9 3 5v13c0 1.1.9 2 2 2s2-.9 2-2v-1h14v1c0 1.1.9 2 2 2s2-.9 2-2v-5c0-1.66-1.34-3-3-3zM21 18H5v-3h14v2h2v1z"/>
                      </svg>
                      <span>{l.baths} bath</span>
                    </div>
                  )}
                  {l.sqft && (
                    <div class="flex items-center gap-1">
                      <svg class="w-3.5 h-3.5 text-gold" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14l-5-5 1.41-1.41L12 14.17l7.59-7.59L21 8l-9 9z"/>
                      </svg>
                      <span>{Number(l.sqft).toLocaleString()} sq ft</span>
                    </div>
                  )}
                  {l.garage && l.garage !== '0' && (
                    <div class="flex items-center gap-1">
                      <svg class="w-3.5 h-3.5 text-gold" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M18 18.5c.83 0 1.5-.67 1.5-1.5s-.67-1.5-1.5-1.5-1.5.67-1.5 1.5.67 1.5 1.5 1.5zm1.5-9l-1.5-4.5H6L4.5 9.5H2.5v2h.5V20H9v-2h6v2h6v-8.5h.5v-2h-2zM6.85 7h10.3l1 3H5.85l1-3zM19 18H5V11.5h14V18z"/>
                      </svg>
                      <span>{l.garage} car</span>
                    </div>
                  )}
                </div>
                <p class="text-[10px] text-slate/50 mt-1.5">Courtesy of {l.brokerage}</p>
              </a>

              <!-- Actions -->
              <div class="flex gap-2 px-3.5 pb-3.5">
                <a href={l.detailHref}
                  class="flex-1 bg-navy text-white text-xs font-semibold text-center py-2 rounded-lg hover:bg-navy/80 transition-colors">
                  View Full Details
                </a>
                <a href={`/contact/?listing=${encodeURIComponent(l.address)}`}
                  class="flex items-center justify-center px-3 py-2 border border-gold text-gold rounded-lg hover:bg-gold hover:text-navy transition-all"
                  aria-label="Ask about this listing">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  {listings.length > 0 && (
    <!-- Bottom CTA -->
    <section class="py-16 bg-navy text-white">
      <div class="container-site">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="font-serif text-3xl mb-4">Don't See What You're Looking For?</h2>
            <div class="gold-divider mb-6"></div>
            <p class="text-white/70 leading-relaxed mb-6">
              Justin has access to listings before they hit public portals, including off-market opportunities in Oakridge, Byron, and across West London. Tell him what you need.
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <a href={`tel:${SITE.phone}`} class="btn-primary">Call {SITE.phoneDisplay}</a>
              <a href="/contact/" class="btn-secondary">Send a Request</a>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            {Object.entries(AREA_SLUGS).slice(0, 8).map(([name, slug]) => (
              <a href={`/areas/${slug}/buy/`} class="bg-white/5 hover:bg-gold/20 border border-white/10 hover:border-gold/40 text-white/80 hover:text-white text-sm font-medium px-4 py-3 rounded-xl transition-all text-center">
                {name}
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}
</Base>

<script>
  // Grid / Map view toggle
  const gridView = document.getElementById('grid-view');
  const mapView = document.getElementById('map-view');
  const gridBtn = document.getElementById('view-grid-btn');
  const mapBtn = document.getElementById('view-map-btn');

  function setView(view: 'grid' | 'map') {
    const isGrid = view === 'grid';
    gridView?.classList.toggle('hidden', !isGrid);
    mapView?.classList.toggle('hidden', isGrid);
    gridBtn?.classList.toggle('bg-gold', isGrid);
    gridBtn?.classList.toggle('text-navy', isGrid);
    gridBtn?.classList.toggle('text-navy/70', !isGrid);
    mapBtn?.classList.toggle('bg-gold', !isGrid);
    mapBtn?.classList.toggle('text-navy', !isGrid);
    mapBtn?.classList.toggle('text-navy/70', isGrid);
    gridBtn?.setAttribute('data-active', String(isGrid));
    mapBtn?.setAttribute('data-active', String(!isGrid));
    if (!isGrid) window.dispatchEvent(new CustomEvent('show-listings-map'));
  }

  gridBtn?.addEventListener('click', () => setView('grid'));
  mapBtn?.addEventListener('click', () => setView('map'));

  // Client-side filter logic
  const grid = document.getElementById('listings-grid');
  if (grid) {
    const cards = () => Array.from(grid.querySelectorAll<HTMLElement>('.listing-card'));
    const countEl = document.getElementById('listing-count');

    let activeArea = '';
    let minPrice = 0;
    let maxPrice = Infinity;
    let minBeds = 0;
    let minBaths = 0;
    let minParking = 0;
    let maxDays = Infinity;
    let typeFilter = '';
    let searchTerm = '';
    let keyword = '';

    const priceMinSelect = document.getElementById('filter-price-min') as HTMLSelectElement | null;
    const priceMaxSelect = document.getElementById('filter-price-max') as HTMLSelectElement | null;
    const typeSelect = document.getElementById('filter-type') as HTMLSelectElement | null;
    const parkingSelect = document.getElementById('filter-parking') as HTMLSelectElement | null;
    const daysSelect = document.getElementById('filter-days') as HTMLSelectElement | null;
    const sortSelect = document.getElementById('filter-sort') as HTMLSelectElement | null;
    const keywordInput = document.getElementById('filter-keyword') as HTMLInputElement | null;
    const searchInput = document.getElementById('listing-search') as HTMLInputElement | null;
    const clearBtn = document.getElementById('clear-filters-btn');
    const bedsRadios = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="beds-radio"]'));
    const bathsRadios = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="baths-radio"]'));

    function updateClearButton() {
      const anyActive = !!activeArea || !!priceMinSelect?.value || !!priceMaxSelect?.value
        || !!typeSelect?.value || !!searchTerm || minBeds > 0 || minBaths > 0
        || !!parkingSelect?.value || !!daysSelect?.value || !!keyword;
      clearBtn?.classList.toggle('hidden', !anyActive);
      clearBtn?.classList.toggle('inline-flex', anyActive);

      const moreCount = [minBeds > 0, minBaths > 0, !!parkingSelect?.value, !!daysSelect?.value, !!keyword].filter(Boolean).length;
      const badge = document.getElementById('more-filters-count');
      if (badge) {
        badge.textContent = String(moreCount);
        badge.classList.toggle('hidden', moreCount === 0);
        badge.classList.toggle('flex', moreCount > 0);
      }
    }

    function applyFilters() {
      let visible = 0;
      const search = searchTerm.trim().toLowerCase();
      const kw = keyword.trim().toLowerCase();
      cards().forEach(card => {
        const area = card.dataset.area || '';
        const price = Number(card.dataset.price) || 0;
        const beds = Number(card.dataset.beds) || 0;
        const baths = Number(card.dataset.baths) || 0;
        const parking = Number(card.dataset.parking) || 0;
        const days = Number(card.dataset.days ?? Infinity);
        const type = card.dataset.type || '';
        const address = (card.dataset.address || '').toLowerCase();
        const mls = (card.dataset.mls || '').toLowerCase();
        const remarks = card.dataset.remarks || '';

        const areaMatch = !activeArea || area.toLowerCase().includes(activeArea.toLowerCase());
        const priceMatch = price >= minPrice && price <= maxPrice;
        const bedsMatch = beds >= minBeds;
        const bathsMatch = baths >= minBaths;
        const parkingMatch = parking >= minParking;
        const daysMatch = days <= maxDays;
        const typeMatch = !typeFilter || type.toLowerCase().includes(typeFilter.toLowerCase());
        const searchMatch = !search || address.includes(search) || mls.includes(search);
        const keywordMatch = !kw || remarks.includes(kw);

        const show = areaMatch && priceMatch && bedsMatch && bathsMatch && parkingMatch
          && daysMatch && typeMatch && searchMatch && keywordMatch;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (countEl) countEl.textContent = `${visible} listing${visible !== 1 ? 's' : ''}`;
      updateClearButton();
    }

    function sortCards() {
      if (!grid) return;
      const sortBy = sortSelect?.value || 'newest';
      const sorted = cards().sort((a, b) => {
        if (sortBy === 'price-asc') return (Number(a.dataset.price) || 0) - (Number(b.dataset.price) || 0);
        if (sortBy === 'price-desc') return (Number(b.dataset.price) || 0) - (Number(a.dataset.price) || 0);
        if (sortBy === 'beds-desc') return (Number(b.dataset.beds) || 0) - (Number(a.dataset.beds) || 0);
        // newest first — lower "days on market" means more recently listed
        return (Number(a.dataset.days ?? Infinity)) - (Number(b.dataset.days ?? Infinity));
      });
      sorted.forEach((card) => grid.appendChild(card));
    }

    // Area filter buttons
    document.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-btn').forEach(b => {
          b.classList.remove('bg-gold', 'text-navy');
          b.classList.add('bg-cream', 'text-navy/70');
        });
        btn.classList.add('bg-gold', 'text-navy');
        btn.classList.remove('bg-cream', 'text-navy/70');
        activeArea = btn.dataset.filter || '';
        applyFilters();
      });
    });

    // Price filter (min/max)
    priceMinSelect?.addEventListener('change', (e) => {
      minPrice = Number((e.target as HTMLSelectElement).value) || 0;
      applyFilters();
    });
    priceMaxSelect?.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      maxPrice = val ? Number(val) : Infinity;
      applyFilters();
    });

    // Address / MLS search
    searchInput?.addEventListener('input', (e) => {
      searchTerm = (e.target as HTMLInputElement).value;
      applyFilters();
    });

    // Bedrooms / Bathrooms button groups
    bedsRadios.forEach((r) => r.addEventListener('change', () => {
      minBeds = Number(r.value) || 0;
      applyFilters();
    }));
    bathsRadios.forEach((r) => r.addEventListener('change', () => {
      minBaths = Number(r.value) || 0;
      applyFilters();
    }));

    // Type filter
    typeSelect?.addEventListener('change', (e) => {
      typeFilter = (e.target as HTMLSelectElement).value || '';
      applyFilters();
    });

    // Parking / Days on market
    parkingSelect?.addEventListener('change', (e) => {
      minParking = Number((e.target as HTMLSelectElement).value) || 0;
      applyFilters();
    });
    daysSelect?.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      maxDays = val ? Number(val) : Infinity;
      applyFilters();
    });

    // Keyword search (against PublicRemarks)
    keywordInput?.addEventListener('input', (e) => {
      keyword = (e.target as HTMLInputElement).value;
      applyFilters();
    });

    // Sort
    sortSelect?.addEventListener('change', sortCards);
    sortCards();

    // More Filters: inline dropdown on desktop, bottom-sheet drawer on mobile
    const moreFiltersToggle = document.getElementById('more-filters-toggle');
    const moreFiltersPanel = document.getElementById('more-filters-panel');
    const moreFiltersBackdrop = document.getElementById('more-filters-backdrop');
    const moreFiltersClose = document.getElementById('more-filters-close');

    function openMoreFilters() {
      moreFiltersPanel?.classList.remove('hidden');
      moreFiltersBackdrop?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
    function closeMoreFilters() {
      moreFiltersPanel?.classList.add('hidden');
      moreFiltersBackdrop?.classList.add('hidden');
      document.body.style.overflow = '';
    }
    moreFiltersToggle?.addEventListener('click', () => {
      if (moreFiltersPanel?.classList.contains('hidden')) openMoreFilters();
      else closeMoreFilters();
    });
    moreFiltersClose?.addEventListener('click', closeMoreFilters);
    moreFiltersBackdrop?.addEventListener('click', closeMoreFilters);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMoreFilters();
    });
    document.addEventListener('click', (e) => {
      if (moreFiltersPanel?.classList.contains('hidden')) return;
      if (moreFiltersPanel.contains(e.target as Node) || moreFiltersToggle?.contains(e.target as Node)) return;
      closeMoreFilters();
    });

    // Clear all
    clearBtn?.addEventListener('click', () => {
      activeArea = '';
      minPrice = 0;
      maxPrice = Infinity;
      minBeds = 0;
      minBaths = 0;
      minParking = 0;
      maxDays = Infinity;
      typeFilter = '';
      searchTerm = '';
      keyword = '';
      if (priceMinSelect) priceMinSelect.value = '';
      if (priceMaxSelect) priceMaxSelect.value = '';
      if (typeSelect) typeSelect.value = '';
      if (parkingSelect) parkingSelect.value = '';
      if (daysSelect) daysSelect.value = '';
      if (keywordInput) keywordInput.value = '';
      if (searchInput) searchInput.value = '';
      const anyBeds = document.getElementById('p-beds-any') as HTMLInputElement | null;
      if (anyBeds) anyBeds.checked = true;
      const anyBaths = document.getElementById('p-baths-any') as HTMLInputElement | null;
      if (anyBaths) anyBaths.checked = true;
      document.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach((b, i) => {
        b.classList.toggle('bg-gold', i === 0);
        b.classList.toggle('text-navy', i === 0);
        b.classList.toggle('bg-cream', i !== 0);
        b.classList.toggle('text-navy/70', i !== 0);
      });
      applyFilters();
    });
  }
</script>
