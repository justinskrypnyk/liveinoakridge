---
export const prerender = false;

// /search/[listingKey]/ already resolves every Chapman listing (AMPRE is
// checked first there, same as here — see src/lib/ddf.ts), so this URL
// shape is redundant: without this redirect, the identical listing would
// be servable at two URLs at once, splitting link equity and reading as
// duplicate content to Google. 301 so any existing backlinks/bookmarks/
// GSC-indexed URLs still resolve to the canonical page.
const { listingKey } = Astro.params;
return Astro.redirect(`/search/${(listingKey ?? '').toLowerCase()}/`, 301);
---
