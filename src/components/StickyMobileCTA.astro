---
import { SITE } from '@/data/site';
---

<div
  id="sticky-mobile-cta"
  class="sm:hidden fixed bottom-0 inset-x-0 z-40 bg-white border-t border-gray-200 shadow-[0_-4px_20px_rgba(12,35,64,0.12)] flex gap-2 px-3 pt-2.5"
  style="padding-bottom: calc(0.625rem + env(safe-area-inset-bottom));"
>
  <a
    href={`tel:${SITE.phone}`}
    class="flex-1 inline-flex items-center justify-center gap-2 border-2 border-gold text-gold-deep font-semibold text-sm px-4 py-2.5 rounded-lg active:bg-gold active:text-navy transition-colors"
    aria-label={`Call Justin at ${SITE.phoneDisplay}`}
  >
    <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
    </svg>
    Call
  </a>
  <a
    href="/contact/"
    class="flex-[2] inline-flex items-center justify-center bg-gold text-navy font-semibold text-sm px-4 py-2.5 rounded-lg active:bg-gold-dark transition-colors"
  >
    Book Complimentary Evaluation
  </a>
</div>
