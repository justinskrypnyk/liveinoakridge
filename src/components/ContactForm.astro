---
interface Props {
  subject?: string;
  ctaLabel?: string;
  dark?: boolean;
  // GA4 generate_lead event param, imported into Google Ads via the GA4
  // link -- lets Justin choose in GA4 which form types actually count as an
  // ads conversion (e.g. showing-request) vs. which are just visibility
  // (e.g. a generic contact-page inquiry) without any code changes later.
  formType?: string;
}

const {
  subject = 'General Inquiry',
  ctaLabel = 'Send Message',
  dark = false,
  formType = 'contact',
} = Astro.props;

const inputClass = dark
  ? 'bg-white/10 border-white/20 text-white placeholder-white/40 focus:border-gold'
  : 'bg-white border-gray-200 text-navy placeholder-slate/60 focus:border-gold';

const labelClass = dark ? 'text-white/70' : 'text-navy/70';

// Field ids need to be unique per instance -- some pages (a listing's
// "Request a Showing" + "Request More Info", or either of those plus
// AskWidget's embedded copy) render more than one ContactForm on the same
// page, and duplicate ids break label `for` associations (a click focuses
// whichever instance's input happens to be first in the document).
const uid = crypto.randomUUID().slice(0, 8);
const fieldId = (name: string) => `${name}-${uid}`;
---

<div data-contact-form data-form-type={formType}>
<form
  name="contact"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="space-y-5"
>
  <input type="hidden" name="form-name" value="contact" />
  <input type="hidden" name="subject" value={subject} />
  <p class="hidden">
    <label>Don't fill this out: <input name="bot-field" /></label>
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div>
      <label for={fieldId('first-name')} class={`block text-sm font-medium mb-1.5 ${labelClass}`}>First Name *</label>
      <input
        type="text"
        id={fieldId('first-name')}
        name="first-name"
        required
        autocomplete="given-name"
        placeholder="Jane"
        class={`w-full px-4 py-3 rounded-lg border text-sm transition-colors outline-none focus:ring-2 focus:ring-gold/20 ${inputClass}`}
      />
    </div>
    <div>
      <label for={fieldId('last-name')} class={`block text-sm font-medium mb-1.5 ${labelClass}`}>Last Name *</label>
      <input
        type="text"
        id={fieldId('last-name')}
        name="last-name"
        required
        autocomplete="family-name"
        placeholder="Smith"
        class={`w-full px-4 py-3 rounded-lg border text-sm transition-colors outline-none focus:ring-2 focus:ring-gold/20 ${inputClass}`}
      />
    </div>
  </div>

  <div>
    <label for={fieldId('email')} class={`block text-sm font-medium mb-1.5 ${labelClass}`}>Email Address *</label>
    <input
      type="email"
      id={fieldId('email')}
      name="email"
      required
      autocomplete="email"
      placeholder="jane@example.com"
      class={`w-full px-4 py-3 rounded-lg border text-sm transition-colors outline-none focus:ring-2 focus:ring-gold/20 ${inputClass}`}
    />
  </div>

  <div>
    <label for={fieldId('phone')} class={`block text-sm font-medium mb-1.5 ${labelClass}`}>Phone Number</label>
    <input
      type="tel"
      id={fieldId('phone')}
      name="phone"
      autocomplete="tel"
      placeholder="519-555-0100"
      class={`w-full px-4 py-3 rounded-lg border text-sm transition-colors outline-none focus:ring-2 focus:ring-gold/20 ${inputClass}`}
    />
  </div>

  <div>
    <label for={fieldId('service')} class={`block text-sm font-medium mb-1.5 ${labelClass}`}>I'm interested in...</label>
    <select
      id={fieldId('service')}
      name="service"
      class={`w-full px-4 py-3 rounded-lg border text-sm transition-colors outline-none focus:ring-2 focus:ring-gold/20 ${inputClass}`}
    >
      <option value="">Select a service</option>
      <option value="buying">Buying a Home</option>
      <option value="selling">Selling My Home</option>
      <option value="evaluation">Complimentary Home Evaluation</option>
      <option value="first-time">First-Time Buyer Guidance</option>
      <option value="downsizing">Downsizing</option>
      <option value="upsizing">Upsizing</option>
      <option value="relocation">Relocation to London</option>
      <option value="investment">Investment Properties</option>
      <option value="mortgage">Mortgage Pre-Approval</option>
      <option value="other">General Question</option>
    </select>
  </div>

  <div>
    <label for={fieldId('message')} class={`block text-sm font-medium mb-1.5 ${labelClass}`}>Your Message</label>
    <textarea
      id={fieldId('message')}
      name="message"
      rows="4"
      placeholder="Tell me a bit about your situation or what you're looking for..."
      class={`w-full px-4 py-3 rounded-lg border text-sm transition-colors outline-none focus:ring-2 focus:ring-gold/20 resize-none ${inputClass}`}
    ></textarea>
  </div>

  <button
    type="submit"
    class="btn-primary w-full justify-center text-base py-4"
  >
    {ctaLabel}
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M5 12h14M12 5l7 7-7 7"/>
    </svg>
  </button>

  <p data-contact-error class="hidden text-xs text-red-600"></p>

  <p class={`text-xs text-center ${dark ? 'text-white/50' : 'text-slate'}`}>
    By submitting, you agree to our <a href="/privacy-policy/" class="underline hover:text-gold transition-colors">Privacy Policy</a>. We never share your information.
  </p>
</form>

<div data-contact-success class="hidden text-center py-6">
  <div class="text-4xl mb-3">✅</div>
  <p class={`font-serif text-lg font-bold mb-1 ${dark ? 'text-white' : 'text-navy'}`}>Message sent!</p>
  <p class={`text-sm ${dark ? 'text-white/70' : 'text-slate'}`}>Justin will get back to you shortly.</p>
</div>
</div>

<script>
  import { getStoredAttribution } from '@/lib/attribution-client';

  // Netlify's form-processing layer only intercepts POSTs to *statically
  // rendered* pages -- it never sees a POST to a prerender=false route (e.g.
  // /search/[listingKey]/, /sold-map/[listingKey]/, both live-MLS on-demand
  // pages), since those go straight into the Astro SSR function instead,
  // which just re-renders the normal page and silently drops the
  // submission. A native <form> POST (this component's original approach)
  // worked fine on static pages but went nowhere on those two -- confirmed
  // via Netlify's submission API showing 0 new submissions after a raw POST
  // there. Submitting via fetch() to '/' (a static page) instead, same
  // pattern as SaveListingModal/MarketMapNotifyForm, works everywhere
  // regardless of which page renders the form.
  declare global {
    interface Window { gtag?: (...args: unknown[]) => void; }
  }

  document.querySelectorAll('[data-contact-form]').forEach((wrapper) => {
    const form = wrapper.querySelector('form');
    const formType = (wrapper as HTMLElement).dataset.formType || 'contact';
    const successEl = wrapper.querySelector('[data-contact-success]');
    const errorEl = wrapper.querySelector('[data-contact-error]');
    const submitBtn = form?.querySelector('button[type="submit"]');
    if (!form || !(submitBtn instanceof HTMLButtonElement)) return;
    const originalLabel = submitBtn.innerHTML;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
      errorEl?.classList.add('hidden');

      try {
        const data = new FormData(form);
        const body = new URLSearchParams();
        data.forEach((value, key) => body.append(key, String(value)));
        Object.entries(getStoredAttribution()).forEach(([key, value]) => body.append(key, value));
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: body.toString(),
        });
        if (!res.ok) throw new Error(`${res.status}`);

        form.classList.add('hidden');
        successEl?.classList.remove('hidden');
        window.gtag?.('event', 'generate_lead', { form_type: formType });
        form.reset();
      } catch {
        if (errorEl) {
          errorEl.textContent = 'Something went wrong sending that — please try again, or call/text Justin directly.';
          errorEl.classList.remove('hidden');
        }
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalLabel;
      }
    });
  });
</script>
