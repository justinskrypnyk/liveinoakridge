---
import { SITE } from '@/data/site';

const year = new Date().getFullYear();
---

<footer class="bg-navy-dark text-white/70">
  <div class="container-site py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-10">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <a href="/" class="inline-flex mb-6">
          <img src="/images/justinlogo-reversed.webp" alt="Justin Skrypnyk Real Estate" class="h-14 w-auto" />
        </a>
        <p class="text-sm leading-relaxed mb-6">
          Local real estate guidance rooted in Oakridge and West London. Honest advice, genuine neighbourhood expertise, and a Broker who actually lives here.
        </p>
        <div class="flex gap-4">
          <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-9 h-9 rounded-full bg-white/10 hover:bg-gold hover:text-navy flex items-center justify-center transition-colors text-white/70">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </a>
          <a href={SITE.social.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="w-9 h-9 rounded-full bg-white/10 hover:bg-gold hover:text-navy flex items-center justify-center transition-colors text-white/70">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
          <a href={SITE.social.googleReviews} target="_blank" rel="noopener noreferrer" aria-label="Google Reviews" class="w-9 h-9 rounded-full bg-white/10 hover:bg-gold flex items-center justify-center transition-colors">
            <svg class="w-4 h-4" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-white font-semibold mb-4">Services</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/services/buying/" class="hover:text-gold transition-colors">Buying a Home</a></li>
          <li><a href="/services/selling/" class="hover:text-gold transition-colors">Selling Your Home</a></li>
          <li><a href="/services/home-evaluation/" class="hover:text-gold transition-colors">Complimentary Home Evaluation</a></li>
          <li><a href="/services/first-time-buyers/" class="hover:text-gold transition-colors">First-Time Buyers</a></li>
          <li><a href="/services/downsizing/" class="hover:text-gold transition-colors">Downsizing</a></li>
          <li><a href="/services/upsizing/" class="hover:text-gold transition-colors">Upsizing</a></li>
          <li><a href="/services/relocation/" class="hover:text-gold transition-colors">Relocation</a></li>
          <li><a href="/services/investment/" class="hover:text-gold transition-colors">Investment Properties</a></li>
        </ul>
      </div>

      <!-- Areas -->
      <div>
        <h3 class="text-white font-semibold mb-4">Neighbourhoods</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/areas/oakridge/" class="hover:text-gold transition-colors">Oakridge</a></li>
          <li><a href="/areas/west-london/" class="hover:text-gold transition-colors">West London</a></li>
          <li><a href="/areas/whitehills/" class="hover:text-gold transition-colors">Whitehills</a></li>
          <li><a href="/areas/byron/" class="hover:text-gold transition-colors">Byron</a></li>
          <li><a href="/areas/westmount/" class="hover:text-gold transition-colors">Westmount</a></li>
          <li><a href="/areas/riverbend/" class="hover:text-gold transition-colors">Riverbend</a></li>
          <li><a href="/areas/lambeth/" class="hover:text-gold transition-colors">Lambeth</a></li>
        </ul>
      </div>

      <!-- Blog & Resources -->
      <div>
        <h3 class="text-white font-semibold mb-4">Insights & Guides</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/blog/june-2026-london-ontario-market-update/" class="hover:text-gold transition-colors">June 2026 Market Update</a></li>
          <li><a href="/blog/london-ontario-neighbourhood-guide-2026/" class="hover:text-gold transition-colors">Neighbourhood Guide 2026</a></li>
          <li><a href="/blog/first-time-home-buyer-london-ontario-guide/" class="hover:text-gold transition-colors">First-Time Buyer Guide</a></li>
          <li><a href="/blog/how-to-sell-your-home-london-ontario/" class="hover:text-gold transition-colors">How to Sell Your Home</a></li>
          <li><a href="/blog/oakridge-vs-byron-west-london-neighbourhoods/" class="hover:text-gold transition-colors">Oakridge vs. Byron</a></li>
          <li><a href="/blog/cheapest-area-buy-house-london-ontario/" class="hover:text-gold transition-colors">Most Affordable Areas</a></li>
          <li><a href="/blog/real-estate-broker-vs-agent-ontario/" class="hover:text-gold transition-colors">Broker vs. Agent Guide</a></li>
          <li><a href="/blog/" class="hover:text-gold transition-colors text-gold/70">All Articles →</a></li>
          <li class="pt-2"><a href="/mortgages/calculator/" class="hover:text-gold transition-colors">Mortgage Calculator</a></li>
          <li><a href="/mortgages/closing-costs/" class="hover:text-gold transition-colors">Closing Costs Calculator</a></li>
          <li><a href="/mortgages/pre-approval/" class="hover:text-gold transition-colors">Mortgage Pre-Approval</a></li>
          <li><a href="/mortgages/education/" class="hover:text-gold transition-colors">Mortgage Education</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-white font-semibold mb-4">Contact Justin</h3>
        <div class="space-y-3 text-sm">
          <a href={`tel:${SITE.phone}`} class="flex items-center gap-3 hover:text-gold transition-colors group">
            <svg class="w-4 h-4 text-gold shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
            </svg>
            {SITE.phoneDisplay}
          </a>
          <a href={`mailto:${SITE.email}`} class="flex items-center gap-3 hover:text-gold transition-colors group">
            <svg class="w-4 h-4 text-gold shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
            </svg>
            {SITE.email}
          </a>
          <div class="flex items-start gap-3">
            <svg class="w-4 h-4 text-gold shrink-0 mt-0.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            <span>London, Ontario, Canada<br/><span class="text-xs text-slate">Sutton Group Chapman Realty Inc., Brokerage</span></span>
          </div>
          <div class="pt-2 inline-flex">
            <div class="bg-white rounded-lg px-3 py-2">
              <img src="/images/chapmanlogo.png" alt="Sutton Group Chapman Realty Inc., Brokerage" class="h-10 w-auto" />
            </div>
          </div>
        </div>
        <div class="mt-6">
          <a href="/contact/" class="btn-primary text-sm py-2.5 px-5">Book Complimentary Evaluation</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div class="container-site py-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate">
      <p>&copy; {year} {SITE.name} | {SITE.brokerage}. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="/privacy-policy/" class="hover:text-gold transition-colors">Privacy Policy</a>
        <a href="/sitemap-index.xml" class="hover:text-gold transition-colors">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
