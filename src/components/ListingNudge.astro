---
// Proactive, listing-specific engagement prompt — distinct from AskWidget
// (bottom-right, reactive Q&A) and the always-present sticky CTA bars
// (bottom, generic). This one waits for real engagement (20s dwell, or
// scrolling halfway down the page) before speaking up, so it reads as
// "noticed you're interested" rather than an interruption on page load.
// Skips itself once the visitor reaches the Request More Info form on
// their own — no point nudging someone already there.
import { SITE } from '@/data/site';

interface Props {
  address: string;
  targetId?: string;
}

const { address, targetId = '#request-info' } = Astro.props;
---

<div
  id="listing-nudge"
  class="hidden fixed z-40 top-24 inset-x-4 sm:inset-x-auto sm:right-5 sm:w-80 bg-white rounded-2xl shadow-2xl border border-gray-100 p-4 opacity-0 -translate-y-2 transition-all duration-300"
  role="dialog"
  aria-labelledby="listing-nudge-text"
  data-target={targetId}
>
  <button
    type="button"
    id="listing-nudge-close"
    aria-label="Dismiss"
    class="absolute top-2 right-2 w-7 h-7 rounded-full flex items-center justify-center text-slate/50 hover:bg-cream hover:text-navy transition-colors"
  >
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M18 6L6 18M6 6l12 12"/>
    </svg>
  </button>
  <div class="flex items-start gap-3 pr-5">
    <img
      src="/images/justin-skrypnyk-headshot-avatar.webp"
      alt={SITE.agent}
      class="w-10 h-10 rounded-full object-cover shrink-0"
    />
    <div>
      <p id="listing-nudge-text" class="text-sm text-navy leading-snug">
        <span class="font-semibold">Have questions about {address}?</span> I'm happy to help — usually reply within the hour.
      </p>
      <button
        type="button"
        id="listing-nudge-cta"
        class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-gold-deep hover:text-navy transition-colors"
      >
        Get more info
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  declare global {
    interface Window { gtag?: (...args: unknown[]) => void; }
  }

  const nudge = document.getElementById('listing-nudge');
  const closeBtn = document.getElementById('listing-nudge-close');
  const ctaBtn = document.getElementById('listing-nudge-cta');
  const targetSelector = nudge?.dataset.target || '#request-info';
  const target = document.querySelector(targetSelector);

  if (nudge && closeBtn && ctaBtn) {
    // Once per listing per browser tab session — revisiting the same
    // listing later in a fresh session can nudge again, but not on every
    // back/forward or re-render within one visit.
    const storageKey = `nudge-shown:${location.pathname}`;
    let settled = false; // shown-and-resolved, or dismissed before ever showing

    function show() {
      if (settled) return;
      if (sessionStorage.getItem(storageKey)) { settled = true; return; }
      sessionStorage.setItem(storageKey, '1');
      nudge!.classList.remove('hidden');
      requestAnimationFrame(() => {
        nudge!.classList.remove('opacity-0', '-translate-y-2');
      });
      window.gtag?.('event', 'listing_nudge_shown', { page_path: location.pathname });
    }

    function hide() {
      nudge!.classList.add('opacity-0', '-translate-y-2');
      setTimeout(() => nudge!.classList.add('hidden'), 300);
    }

    function stopWatching() {
      settled = true;
      clearTimeout(timer);
      window.removeEventListener('scroll', onScroll);
    }

    // Visitor found the form on their own — don't also nudge them toward it.
    if (target) {
      const io = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          stopWatching();
          io.disconnect();
        }
      }, { threshold: 0.3 });
      io.observe(target);
    }

    const timer = setTimeout(show, 20000);

    function onScroll() {
      const scrolled = window.scrollY + window.innerHeight;
      if (scrolled / document.documentElement.scrollHeight > 0.5) {
        show();
        window.removeEventListener('scroll', onScroll);
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });

    closeBtn.addEventListener('click', () => {
      stopWatching();
      hide();
      window.gtag?.('event', 'listing_nudge_dismiss', { page_path: location.pathname });
    });

    ctaBtn.addEventListener('click', () => {
      stopWatching();
      hide();
      window.gtag?.('event', 'listing_nudge_click', { page_path: location.pathname });
      target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      setTimeout(() => {
        (target?.querySelector('input, textarea') as HTMLElement | null)?.focus();
      }, 500);
    });
  }
</script>
