---
import { SITE } from '@/data/site';
import { TESTIMONIALS } from '@/data/testimonials';

interface ListingSchemaInput {
  name: string;
  /** Street-level portion only (no city/region/postal) — falls back to `name` if not given. */
  streetAddress?: string;
  price: number;
  image?: string[];
  beds?: string;
  baths?: string;
  sqft?: string;
  propertyType?: string;
  yearBuilt?: string;
  city?: string;
  postalCode?: string;
  lat?: number;
  lng?: number;
}

interface ItemListEntry {
  name: string;
  url: string;
}

interface Props {
  type: 'home' | 'service' | 'area' | 'area-service' | 'blog' | 'contact' | 'listing' | 'listing-collection' | 'breadcrumb' | 'dataset';
  areaName?: string;
  areaGeo?: { lat: number; lng: number };
  serviceName?: string;
  pageUrl?: string;
  description?: string;
  faqs?: { q: string; a: string }[];
  breadcrumbs?: { name: string; url: string }[];
  listing?: ListingSchemaInput;
  itemList?: ItemListEntry[];
  itemListName?: string;
  itemListTotal?: number;
  /** Twice-monthly neighbourhood snapshot (see src/lib/market-stats.ts) — attached to the `Place` schema below as `additionalProperty` when given. */
  marketStats?: {
    medianListPrice: number | null;
    activeCount: number;
    avgDaysOnMarket: number | null;
    asOf: string;
  };
  /** type: 'dataset' — the heat map's aggregate neighbourhood snapshot data. */
  dataset?: {
    name: string;
    variableMeasured: string[];
    datePublished: string;
  };
}

const {
  type,
  areaName,
  areaGeo,
  serviceName,
  pageUrl,
  description,
  faqs,
  breadcrumbs,
  listing,
  itemList,
  itemListName,
  itemListTotal,
  marketStats,
  dataset,
} = Astro.props;

const marketStatsProperties = marketStats ? [
  marketStats.medianListPrice != null && {
    '@type': 'PropertyValue',
    name: 'Median list price',
    value: marketStats.medianListPrice,
    unitText: 'CAD',
  },
  {
    '@type': 'PropertyValue',
    name: 'Active listings',
    value: marketStats.activeCount,
  },
  marketStats.avgDaysOnMarket != null && {
    '@type': 'PropertyValue',
    name: 'Average days on market',
    value: marketStats.avgDaysOnMarket,
    unitText: 'days',
  },
  {
    '@type': 'PropertyValue',
    name: 'Stats as of',
    value: marketStats.asOf,
  },
].filter(Boolean) : undefined;

const faqSchema = faqs && faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
} : null;

const currentUrl = pageUrl ?? new URL(Astro.url.pathname, SITE.url).toString();

const allAreasServed = [
  'Oakridge, London, Ontario',
  'Byron, London, Ontario',
  'Westmount, London, Ontario',
  'Riverbend, London, Ontario',
  'Whitehills, London, Ontario',
  'West London, London, Ontario',
  'Lambeth, London, Ontario',
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE.url}/#person`,
  name: 'Justin Skrypnyk',
  jobTitle: 'Real Estate Broker',
  description: 'Justin Skrypnyk is a licensed Real Estate Broker serving Oakridge and West London Ontario. He specializes in residential buying, selling, and investment properties.',
  url: SITE.url,
  telephone: SITE.phone,
  email: SITE.email,
  image: `${SITE.url}/images/justin-skrypnyk-realtor-london-ontario.webp`,
  sameAs: [SITE.social.youtube, SITE.social.instagram, SITE.social.googleReviews],
  worksFor: {
    '@type': 'Organization',
    '@id': `${SITE.url}/#realestateagent`,
    name: 'Sutton Group Chapman Realty Inc., Brokerage',
  },
  knowsAbout: [
    'London Ontario Real Estate',
    'West London Real Estate',
    'Oakridge London Ontario',
    'Byron London Ontario',
    'Home Buying in London Ontario',
    'Home Selling in London Ontario',
    'Residential Real Estate',
    'Investment Properties London Ontario',
    'First-Time Home Buyers Ontario',
    'Real Estate Market Analysis London Ontario',
  ],
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    name: 'Real Estate Broker License — Ontario',
    credentialCategory: 'license',
    recognizedBy: {
      '@type': 'Organization',
      name: 'Real Estate Council of Ontario',
      url: 'https://www.reco.on.ca',
    },
  },
  areaServed: allAreasServed,
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  '@id': `${SITE.url}/#realestateagent`,
  name: SITE.legalName,
  alternateName: SITE.name,
  description: SITE.description,
  url: SITE.url,
  telephone: SITE.phone,
  email: SITE.email,
  image: `${SITE.url}/images/justin-skrypnyk-realtor-london-ontario.webp`,
  logo: `${SITE.url}/images/live-in-oakridge-logo.webp`,
  priceRange: '$$',
  naics: '531210',
  currenciesAccepted: 'CAD',
  paymentAccepted: 'Cash, Credit Card, Cheque',
  hasMap: `https://www.google.com/maps?q=${SITE.geo.lat},${SITE.geo.lng}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'London',
    addressRegion: 'ON',
    addressCountry: 'CA',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: SITE.geo.lat,
    longitude: SITE.geo.lng,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '20:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday', 'Sunday'],
      opens: '10:00',
      closes: '18:00',
    },
  ],
  areaServed: allAreasServed,
  sameAs: [SITE.social.youtube, SITE.social.instagram, SITE.social.googleReviews],
  memberOf: {
    '@type': 'Organization',
    name: 'Sutton Group Chapman Realty Inc., Brokerage',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5.0',
    reviewCount: '50',
    bestRating: '5',
  },
  review: TESTIMONIALS.map((t) => ({
    '@type': 'Review',
    author: {
      '@type': 'Person',
      name: t.author,
    },
    reviewRating: {
      '@type': 'Rating',
      ratingValue: '5',
      bestRating: '5',
    },
    reviewBody: t.text,
  })),
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${SITE.url}/properties?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

const breadcrumbSchema = (items: { name: string; url: string }[]) => ({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: item.url,
  })),
});

let schemas: object[] = [];

if (type === 'home') {
  schemas = [
    localBusinessSchema,
    personSchema,
    websiteSchema,
    {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      '@id': `${SITE.url}/#webpage`,
      url: SITE.url,
      name: SITE.legalName,
      description: SITE.description,
      inLanguage: 'en-CA',
      isPartOf: { '@id': `${SITE.url}/#website` },
      about: { '@id': `${SITE.url}/#realestateagent` },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: `${SITE.url}/images/og-default.webp`,
        width: 1200,
        height: 630,
      },
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['h1', 'main p'],
      },
    },
  ];
  if (breadcrumbs?.length) schemas.push(breadcrumbSchema(breadcrumbs));
}

if (type === 'contact') {
  schemas = [
    localBusinessSchema,
    breadcrumbSchema([
      { name: 'Home', url: SITE.url },
      { name: 'Contact', url: currentUrl },
    ]),
  ];
}

if (type === 'service' && serviceName) {
  schemas = [
    {
      '@context': 'https://schema.org',
      '@type': 'Service',
      '@id': `${currentUrl}#service`,
      name: serviceName,
      description: description,
      provider: {
        '@id': `${SITE.url}/#realestateagent`,
        '@type': 'RealEstateAgent',
        name: SITE.legalName,
      },
      areaServed: {
        '@type': 'City',
        name: 'London',
        addressRegion: 'ON',
        addressCountry: 'CA',
      },
      url: currentUrl,
    },
    breadcrumbSchema([
      { name: 'Home', url: SITE.url },
      { name: 'Services', url: `${SITE.url}/services/` },
      { name: serviceName, url: currentUrl },
    ]),
    localBusinessSchema,
  ];
}

if (type === 'area' && areaName && areaGeo) {
  schemas = [
    {
      '@context': 'https://schema.org',
      '@type': 'Place',
      '@id': `${currentUrl}#place`,
      name: `${areaName}, London, Ontario`,
      description: description,
      geo: {
        '@type': 'GeoCoordinates',
        latitude: areaGeo.lat,
        longitude: areaGeo.lng,
      },
      containedInPlace: {
        '@type': 'City',
        name: 'London',
        addressRegion: 'ON',
        addressCountry: 'CA',
      },
      ...(marketStatsProperties ? { additionalProperty: marketStatsProperties } : {}),
    },
    {
      '@context': 'https://schema.org',
      '@type': 'RealEstateAgent',
      '@id': `${SITE.url}/#realestateagent`,
      name: SITE.legalName,
      url: SITE.url,
      telephone: SITE.phone,
      areaServed: {
        '@type': 'Place',
        name: `${areaName}, London, Ontario`,
      },
    },
    breadcrumbSchema([
      { name: 'Home', url: SITE.url },
      { name: 'Areas We Serve', url: `${SITE.url}/areas/` },
      { name: areaName, url: currentUrl },
    ]),
  ];
}

if (type === 'area-service' && areaName && serviceName) {
  schemas = [
    {
      '@context': 'https://schema.org',
      '@type': 'Service',
      '@id': `${currentUrl}#service`,
      name: `${serviceName} in ${areaName}`,
      description: description,
      provider: {
        '@id': `${SITE.url}/#realestateagent`,
        '@type': 'RealEstateAgent',
        name: SITE.legalName,
      },
      areaServed: {
        '@type': 'Place',
        name: `${areaName}, London, Ontario`,
      },
      url: currentUrl,
    },
    breadcrumbSchema([
      { name: 'Home', url: SITE.url },
      { name: 'Areas We Serve', url: `${SITE.url}/areas/` },
      { name: areaName, url: `${SITE.url}/areas/${areaName.toLowerCase().replace(' ', '-')}/` },
      { name: serviceName, url: currentUrl },
    ]),
    localBusinessSchema,
  ];
}

if (type === 'blog') {
  schemas = [
    breadcrumbSchema([
      { name: 'Home', url: SITE.url },
      { name: 'Blog', url: `${SITE.url}/blog/` },
    ]),
    localBusinessSchema,
  ];
}

if (type === 'listing' && listing) {
  const residenceType = /condo|apartment/i.test(listing.propertyType ?? '')
    ? 'Apartment'
    : /town/i.test(listing.propertyType ?? '')
      ? 'Townhouse'
      : 'SingleFamilyResidence';
  const beds = Number(listing.beds);
  const baths = Number(listing.baths);
  const sqft = Number(listing.sqft);

  schemas = [
    {
      '@context': 'https://schema.org',
      '@type': 'RealEstateListing',
      '@id': `${currentUrl}#listing`,
      url: currentUrl,
      name: listing.name,
      description,
      inLanguage: 'en-CA',
      ...(listing.image?.length ? { image: listing.image.slice(0, 8) } : {}),
      about: {
        '@type': residenceType,
        name: listing.name,
        address: {
          '@type': 'PostalAddress',
          streetAddress: listing.streetAddress || listing.name,
          addressLocality: listing.city || 'London',
          addressRegion: 'ON',
          addressCountry: 'CA',
          ...(listing.postalCode ? { postalCode: listing.postalCode } : {}),
        },
        ...(listing.lat != null && listing.lng != null
          ? { geo: { '@type': 'GeoCoordinates', latitude: listing.lat, longitude: listing.lng } }
          : {}),
        ...(Number.isFinite(beds) && beds > 0 ? { numberOfRooms: beds } : {}),
        ...(Number.isFinite(baths) && baths > 0 ? { numberOfBathroomsTotal: baths } : {}),
        ...(Number.isFinite(sqft) && sqft > 0
          ? { floorSize: { '@type': 'QuantitativeValue', value: sqft, unitCode: 'FTK' } }
          : {}),
        ...(listing.yearBuilt ? { yearBuilt: listing.yearBuilt } : {}),
      },
      offers: {
        '@type': 'Offer',
        price: listing.price,
        priceCurrency: 'CAD',
        availability: 'https://schema.org/InStock',
        businessFunction: 'https://schema.org/Sell',
        url: currentUrl,
      },
    },
  ];
  if (breadcrumbs?.length) schemas.push(breadcrumbSchema(breadcrumbs));
}

if (type === 'listing-collection') {
  schemas = [
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      '@id': `${currentUrl}#collection`,
      url: currentUrl,
      name: itemListName ?? 'MLS® Listings',
      description,
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: itemListTotal ?? itemList?.length ?? 0,
        itemListElement: (itemList ?? []).map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          url: item.url,
          name: item.name,
        })),
      },
    },
  ];
  if (breadcrumbs?.length) schemas.push(breadcrumbSchema(breadcrumbs));
}

if (type === 'breadcrumb' && breadcrumbs?.length) {
  schemas = [breadcrumbSchema(breadcrumbs)];
}

if (type === 'dataset' && dataset) {
  schemas = [
    {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      '@id': `${currentUrl}#dataset`,
      name: dataset.name,
      description,
      url: currentUrl,
      license: 'https://creativecommons.org/licenses/by/4.0/',
      creator: {
        '@id': `${SITE.url}/#realestateagent`,
        '@type': 'RealEstateAgent',
        name: SITE.legalName,
      },
      datePublished: dataset.datePublished,
      variableMeasured: dataset.variableMeasured,
      spatialCoverage: {
        '@type': 'Place',
        name: 'London, Ontario, Canada',
      },
      temporalCoverage: dataset.datePublished,
    },
    breadcrumbSchema([
      { name: 'Home', url: SITE.url },
      { name: 'Neighbourhood Heat Map', url: currentUrl },
    ]),
  ];
}
---

{schemas.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
{faqSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}
