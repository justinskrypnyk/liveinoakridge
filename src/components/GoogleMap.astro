---
interface Props {
  query: string;
  title: string;
  height?: string;
}

const { query, title, height = '400px' } = Astro.props;
const encodedQuery = encodeURIComponent(query);
---

<div class="rounded-xl overflow-hidden shadow-card" style={`height: ${height}`}>
  <iframe
    src={`https://maps.google.com/maps?q=${encodedQuery}&output=embed&z=14`}
    width="100%"
    height="100%"
    style="border:0;"
    allowfullscreen
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    title={`Google Map of ${title}`}
    aria-label={`Interactive map showing ${title}`}
  ></iframe>
</div>
