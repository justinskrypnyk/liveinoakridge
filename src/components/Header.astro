---
import { SITE } from '@/data/site';

const navItems = [
  { label: 'About', href: '/about/' },
  {
    label: 'Services',
    href: '/services/',
    children: [
      { label: 'Buying a Home', href: '/services/buying/' },
      { label: 'Selling Your Home', href: '/services/selling/' },
      { label: 'Complimentary Home Evaluation', href: '/services/home-evaluation/' },
      { label: 'First-Time Buyers', href: '/services/first-time-buyers/' },
      { label: 'Downsizing', href: '/services/downsizing/' },
      { label: 'Upsizing', href: '/services/upsizing/' },
      { label: 'Relocation', href: '/services/relocation/' },
      { label: 'Investment Properties', href: '/services/investment/' },
    ],
  },
  {
    label: 'Areas We Serve',
    href: '/areas/',
    children: [
      { label: 'Neighbourhood Heat Map', href: '/market-map/' },
      { label: 'Oakridge', href: '/areas/oakridge/' },
      { label: 'West London', href: '/areas/west-london/' },
      { label: 'Whitehills', href: '/areas/whitehills/' },
      { label: 'Byron', href: '/areas/byron/' },
      { label: 'Westmount', href: '/areas/westmount/' },
      { label: 'Riverbend', href: '/areas/riverbend/' },
      { label: 'Lambeth', href: '/areas/lambeth/' },
    ],
  },
  { label: 'Our Listings', href: '/properties/' },
  {
    label: 'Search Homes',
    href: '/search/',
    children: [
      { label: 'See What Homes Sold For', href: '/sold-map/' },
    ],
  },
  { label: 'Blog', href: '/blog/' },
  {
    label: 'Community',
    href: '/community/',
    children: [
      { label: 'Schools', href: '/community/#schools' },
      { label: 'Golf Courses', href: '/community/#golf' },
    ],
  },
  { label: 'Giving Back', href: '/giving-back/' },
];

const pathname = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-navy transition-all duration-300" id="site-header">
  <div class="container-site">
    <nav class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center group shrink-0" aria-label="Live In Oakridge - Home">
        <img src="/images/justinlogo-reversed.webp" alt="Justin Skrypnyk Real Estate" width="1766" height="472" class="h-11 sm:h-14 lg:h-16 w-auto" />
      </a>

      <!-- Desktop Nav -->
      <ul class="hidden xl:flex items-center gap-1" role="list">
        {navItems.map((item) => (
          <li class="relative group">
            <a
              href={item.href}
              class={`flex items-center gap-1 px-3 py-2 text-sm font-medium rounded-md transition-colors ${
                pathname.startsWith(item.href) && item.href !== '/'
                  ? 'text-gold'
                  : 'text-gold/80 hover:text-gold'
              }`}
            >
              {item.label}
              {item.children && (
                <svg class="w-3 h-3 transition-transform group-hover:rotate-180" viewBox="0 0 12 12" fill="currentColor">
                  <path d="M6 8L2 4h8L6 8z"/>
                </svg>
              )}
            </a>
            {item.children && (
              <div class="absolute top-full left-0 mt-1 w-56 bg-navy-dark border border-white/10 rounded-xl shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none group-hover:pointer-events-auto">
                <ul class="py-2" role="list">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="block px-4 py-2.5 text-sm text-white/80 hover:text-gold hover:bg-white/5 transition-colors"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>

      <!-- CTA + Mobile Menu -->
      <div class="flex items-center gap-3">
        <a href="/contact/" class="hidden md:inline-flex btn-primary text-sm py-2.5 px-5">
          Complimentary Evaluation
        </a>
        <a href={`tel:${SITE.phone}`} class="hidden sm:flex items-center gap-2 text-gold/80 hover:text-gold transition-colors text-sm">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
          </svg>
          {SITE.phoneDisplay}
        </a>

        <!-- Mobile hamburger -->
        <button
          id="mobile-menu-btn"
          class="xl:hidden p-2 text-gold hover:text-gold-light transition-colors"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
        >
          <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile Menu — scrollable, sub-menus collapsed by default -->
  <div id="mobile-menu" class="xl:hidden hidden bg-navy-dark border-t border-white/10 overflow-y-auto max-h-[calc(100vh-5rem)]">
    <div class="container-site py-4 space-y-1">
      {navItems.map((item) => (
        <div class="mobile-nav-item">
          <div class="flex items-center">
            <a
              href={item.href}
              class="flex-1 px-4 py-3 text-white/90 hover:text-gold hover:bg-white/5 rounded-lg transition-colors font-medium block"
            >
              {item.label}
            </a>
            {item.children && (
              <button
                class="mobile-submenu-toggle px-4 py-3 text-white/50 hover:text-gold transition-colors"
                aria-label={`Show ${item.label} links`}
              >
                <svg class="w-4 h-4 transition-transform duration-200" viewBox="0 0 12 12" fill="currentColor">
                  <path d="M6 8L2 4h8L6 8z"/>
                </svg>
              </button>
            )}
          </div>
          {item.children && (
            <div class="mobile-submenu hidden ml-2 mt-1 space-y-0.5 border-l border-white/10 pl-3">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  class="block px-3 py-2 text-sm text-white/60 hover:text-gold hover:bg-white/5 rounded-lg transition-colors"
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
      <div class="pt-4 border-t border-white/10 flex flex-col gap-3">
        <a href="/contact/" class="btn-primary justify-center">Book Complimentary Evaluation</a>
        <a href={`tel:${SITE.phone}`} class="btn-secondary justify-center">{SITE.phoneDisplay}</a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  // Scroll-based header background
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header?.classList.add('bg-navy/95', 'backdrop-blur-sm', 'shadow-lg');
    } else {
      header?.classList.remove('bg-navy/95', 'backdrop-blur-sm', 'shadow-lg');
    }
  }, { passive: true });

  // Mobile menu open/close
  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', !isOpen);
    btn.setAttribute('aria-expanded', String(isOpen));
    menuIcon?.classList.toggle('hidden', isOpen ?? false);
    closeIcon?.classList.toggle('hidden', !(isOpen ?? false));
  });

  // Sub-menu accordion toggles
  document.querySelectorAll('.mobile-submenu-toggle').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const item = toggle.closest('.mobile-nav-item');
      const submenu = item?.querySelector('.mobile-submenu');
      const icon = toggle.querySelector('svg');
      const isHidden = submenu?.classList.contains('hidden');
      submenu?.classList.toggle('hidden', !isHidden);
      icon?.classList.toggle('rotate-180', isHidden ?? false);
    });
  });
</script>
