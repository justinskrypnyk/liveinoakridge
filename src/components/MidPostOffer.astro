---
// Halfway-down offer inside blog posts (Justin, 2026-10-12). The week of
// 10-05, the house-prices post had the best read-through on the site (56% of
// desktop readers past halfway) and 0 leads: the only asks sat at the very
// end, below the FAQs. This puts the two lead tools -- the sold map (VOW
// sign-up) and the home-value estimate -- where readers actually are.
// Seller-leaning posts lead with the estimate, everything else with sold
// prices. Estimate copy says "rough range" on purpose: never promise a value.
interface Props {
  category: string;
  area?: { slug: string; name: string };
}

const { category, area } = Astro.props;
const sellerFirst = /market|sell|digest/i.test(category);
const soldHref = area ? `/sold-map/?area=${area.slug}` : '/sold-map/';
const sold = {
  href: soldHref,
  label: area ? `${area.name} sold prices` : 'See sold prices',
};
const estimate = { href: '/home-value-estimate/', label: 'Get my value range' };
const [primary, secondary] = sellerFirst ? [estimate, sold] : [sold, estimate];
---

<aside class="not-prose my-10 rounded-2xl border border-gold/40 bg-cream p-5 sm:p-6" aria-label="Free tools">
  <p class="font-serif text-lg text-navy font-bold mb-1">
    {sellerFirst ? 'Wondering what this means for your home?' : 'Want the real numbers, not the averages?'}
  </p>
  <p class="text-sm text-slate leading-relaxed mb-4">
    {sellerFirst
      ? 'Check a rough value range for your home in under a minute, or look up what homes near you actually sold for.'
      : `Look up what homes${area ? ` in ${area.name}` : ' near you'} actually sold for, street by street, or check a rough value range for a home you own.`}
  </p>
  <div class="flex flex-col sm:flex-row gap-3">
    <a href={primary.href} class="btn-primary justify-center text-sm">{primary.label}</a>
    <a href={secondary.href} class="inline-flex items-center justify-center px-5 py-3 rounded-lg border border-navy/20 text-navy text-sm font-semibold hover:border-gold hover:text-gold-deep transition-colors">{secondary.label}</a>
  </div>
</aside>
