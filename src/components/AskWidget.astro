---
interface Props {
  bottomOffsetClass?: string;
}

const { bottomOffsetClass = 'bottom-5' } = Astro.props;

const starterQuestions = [
  'What are closing costs in Ontario?',
  'Which neighbourhood has the best schools?',
  'How much is my home worth?',
  'What is the cheapest area to buy in?',
];
---

<div id="ask-widget" class:list={['fixed right-5 z-50', bottomOffsetClass]}>
  <button
    id="ask-widget-toggle"
    type="button"
    aria-label="Ask a question"
    aria-expanded="false"
    aria-controls="ask-widget-panel"
    class="w-14 h-14 rounded-full bg-gold text-navy shadow-xl flex items-center justify-center hover:bg-gold-light transition-all hover:scale-105"
  >
    <svg id="ask-icon-open" class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z"/>
    </svg>
    <svg id="ask-icon-close" class="w-6 h-6 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M18 6L6 18M6 6l12 12"/>
    </svg>
  </button>

  <div
    id="ask-widget-panel"
    role="dialog"
    aria-labelledby="ask-widget-title"
    class="hidden absolute bottom-[4.5rem] right-0 w-[22rem] max-w-[calc(100vw-2.5rem)] max-h-[32rem] bg-white rounded-2xl shadow-2xl border border-gray-100 flex flex-col overflow-hidden"
  >
    <div class="bg-navy text-white px-5 py-4">
      <h3 id="ask-widget-title" class="font-serif text-lg">Ask About West London Real Estate</h3>
      <p class="text-xs text-white/60 mt-1">Search answers from Justin's neighbourhood guides, FAQs, and blog.</p>
    </div>

    <div class="p-4 border-b border-gray-100">
      <label for="ask-input" class="sr-only">Search a question about West London real estate</label>
      <input
        type="text"
        id="ask-input"
        placeholder="e.g. closing costs, best schools, Byron vs Oakridge..."
        class="w-full px-4 py-2.5 rounded-lg border border-gray-200 text-sm text-navy placeholder-slate/50 outline-none focus:border-gold"
        autocomplete="off"
      />
    </div>

    <div id="ask-results" class="flex-1 overflow-y-auto p-4 space-y-3" aria-live="polite">
      <p class="text-xs font-semibold text-navy/70 uppercase tracking-wider mb-2">Try asking</p>
      {starterQuestions.map((q) => (
        <button type="button" class="ask-starter flex items-center w-full min-h-[44px] text-left text-sm text-navy/80 bg-cream hover:bg-gold/10 rounded-lg px-3 py-2.5 transition-colors">
          {q}
        </button>
      ))}
    </div>

    <div class="p-3 border-t border-gray-100 text-center">
      <a href="/contact/" class="text-xs text-gold-deep hover:underline">Can't find it? Ask Justin directly →</a>
    </div>
  </div>
</div>

<script>
  let faqData: { question: string; answer: string; sourceLabel: string; url: string }[] | null = null;
  let faqLoadPromise: Promise<void> | null = null;

  function loadFaqData() {
    if (!faqLoadPromise) {
      faqLoadPromise = fetch('/faq-index.json')
        .then((r) => r.json())
        .then((data) => {
          faqData = data;
        })
        .catch(() => {
          faqData = [];
        });
    }
    return faqLoadPromise;
  }

  function scoreEntry(tokens: string[], entry: { question: string; answer: string }) {
    const q = entry.question.toLowerCase();
    const a = entry.answer.toLowerCase();
    let score = 0;
    for (const t of tokens) {
      if (q.includes(t)) score += 3;
      if (a.includes(t)) score += 1;
    }
    return score;
  }

  function renderStarters() {
    const results = document.getElementById('ask-results')!;
    const starters = Array.from(document.querySelectorAll('.ask-starter')).map((el) => el.outerHTML).join('');
    results.innerHTML = `<p class="text-xs font-semibold text-navy/40 uppercase tracking-wider mb-2">Try asking</p>${starters}`;
    attachStarterListeners();
  }

  function attachStarterListeners() {
    document.querySelectorAll('.ask-starter').forEach((btn) => {
      btn.addEventListener('click', () => {
        const input = document.getElementById('ask-input') as HTMLInputElement;
        input.value = btn.textContent?.trim() || '';
        runSearch(input.value);
      });
    });
  }

  function runSearch(query: string) {
    const results = document.getElementById('ask-results')!;
    if (!query.trim()) {
      renderStarters();
      return;
    }
    if (!faqData) {
      results.innerHTML = `<p class="text-sm text-slate text-center py-6">Loading...</p>`;
      return;
    }

    const tokens = query.toLowerCase().split(/[^a-z0-9]+/).filter((t) => t.length > 2);
    const ranked = faqData
      .map((entry) => ({ entry, score: scoreEntry(tokens, entry) }))
      .filter((r) => r.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 5);

    if (ranked.length === 0) {
      results.innerHTML = `<p class="text-sm text-slate leading-relaxed py-4">Couldn't find a good match for that. <a href="/contact/" class="text-gold-deep underline">Ask Justin directly</a> — he'll get back to you personally.</p>`;
      return;
    }

    results.innerHTML = ranked
      .map(
        ({ entry }) => `
        <a href="${entry.url}" class="block bg-cream hover:bg-gold/10 rounded-lg p-3 transition-colors">
          <div class="text-sm font-semibold text-navy mb-1">${entry.question}</div>
          <div class="text-xs text-slate leading-relaxed line-clamp-3">${entry.answer}</div>
          <div class="text-xs text-gold-deep mt-2 font-medium">${entry.sourceLabel} →</div>
        </a>`
      )
      .join('');
  }

  const toggleBtn = document.getElementById('ask-widget-toggle')!;
  const panel = document.getElementById('ask-widget-panel')!;
  const iconOpen = document.getElementById('ask-icon-open')!;
  const iconClose = document.getElementById('ask-icon-close')!;
  const input = document.getElementById('ask-input') as HTMLInputElement;

  toggleBtn.addEventListener('click', () => {
    const isHidden = panel.classList.contains('hidden');
    panel.classList.toggle('hidden');
    iconOpen.classList.toggle('hidden', isHidden);
    iconClose.classList.toggle('hidden', !isHidden);
    toggleBtn.setAttribute('aria-expanded', String(isHidden));
    if (isHidden) {
      loadFaqData();
      input?.focus();
    } else {
      toggleBtn.focus();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel.classList.contains('hidden')) {
      panel.classList.add('hidden');
      iconOpen.classList.remove('hidden');
      iconClose.classList.add('hidden');
      toggleBtn.setAttribute('aria-expanded', 'false');
      toggleBtn.focus();
    }
  });

  attachStarterListeners();

  let debounceTimer: ReturnType<typeof setTimeout>;
  input?.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => runSearch(input.value), 200);
  });
</script>
